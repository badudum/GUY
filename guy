class Face(Gtk.DrawingArea):
    """Drawn in cairo every frame while it's on screen; costs nothing once the island hides it."""

    def __init__(self, size, owner):
        super().__init__()
        self.set_content_width(size)
        self.set_content_height(size)
        self.set_valign(Gtk.Align.CENTER)
        self.size, self.owner = size, owner
        self.mood = "idle"
        self.colors = [list(c) for c in MOODS["idle"]]
        self.look = [0.0, 0.0]
        self.squish, self.squish_v = 0.0, 0.0
        self.blink_at = time.monotonic() + random.uniform(1.5, 4)
        self.dizzy_until = 0.0
        self.pokes = []
        self.tick = None
        self.last = None
        self.drawn_at, self.drawn_mood = 0.0, None
        self.set_draw_func(self.draw)
        self.connect("map", self.on_map)
        self.connect("unmap", self.on_unmap)
        click = Gtk.GestureClick()
        click.connect("pressed", lambda *_: self.poke())
        self.add_controller(click)

    def on_map(self, _w):
        if self.tick is None:
            self.last = None
            self.tick = self.add_tick_callback(self.on_tick)

    def on_unmap(self, _w):
        if self.tick is not None:
            self.remove_tick_callback(self.tick)
            self.tick = None

    def poke(self):
        self.squish_v -= 7.0
        now = time.monotonic()
        self.pokes = [t for t in self.pokes if now - t < 1.2] + [now]
        if len(self.pokes) >= 3:
            self.dizzy_until = now + 3.0
            self.pokes = []

    def on_tick(self, _w, clock):
        t = clock.get_frame_time() / 1e6
        dt = min(1 / 30, t - self.last) if self.last else 1 / 60
        self.last = t
        # squish spring, underdamped so a poke wobbles
        self.squish_v += (-180 * self.squish - 9 * self.squish_v) * dt
        self.squish += self.squish_v * dt
        target = MOODS.get(self.mood, MOODS["idle"])
        for cur, tgt in zip(self.colors, target):
            for i in range(3):
                cur[i] += (tgt[i] - cur[i]) * min(1, dt * 6)
        # eyes: the pointer when it's over the island, otherwise a slow look around
        px = self.owner.pointer
        if self.mood == "working" and px is None:
            want = (math.sin(t * 1.7) * 0.8, 0.1)
        elif px is not None:
            ok, p = self.compute_point(self.get_root(), Graphene.Point().init(self.size / 2, self.size / 2))
            dx, dy = (px[0] - p.x, px[1] - p.y) if ok else (0, 0)
            want = (max(-1, min(1, dx / 160)), max(-1, min(1, dy / 120)))
        else:
            want = (math.sin(t * 0.35) * 0.3, 0.0)
        for i in range(2):
            self.look[i] += (want[i] - self.look[i]) * min(1, dt * 8)
        # at rest he only breathes and glances around slowly: 30 fps is plenty and halves the cost;
        # a poke, the pointer, a blink or a mood change gets every frame
        calm = (abs(self.squish) < 0.002 and abs(self.squish_v) < 0.02 and px is None
                and time.monotonic() < self.blink_at - 0.05 and self.drawn_mood == self.mood
                and self.owner.wardrobe.beats() is None)
        if not calm or t - self.drawn_at >= 1 / 31:
            self.drawn_at, self.drawn_mood = t, self.mood
            self.queue_draw()
        return True

    def draw(self, _area, cr, width, height):
        now = time.monotonic()
        S = min(width, height)
        cx = width / 2
        oy = (height - S) / 2

        def Y(f):
            return oy + f * S

        def ellipse(x, y, rx, ry):
            cr.save()
            cr.translate(x, y)
            cr.scale(max(rx, 0.01), max(ry, 0.01))
            cr.arc(0, 0, 1, 0, 2 * math.pi)
            cr.restore()

        breath = math.sin(now * 2.2) * 0.015
        sq = self.squish
        (r1, g1, b1), (r2, g2, b2) = self.colors
        dizzy = now < self.dizzy_until
        wardrobe = self.owner.wardrobe
        outfit, phones = wardrobe.outfit, wardrobe.music
        # dancing: he rocks from side to side, dipping on every beat and bouncing up between them
        beats = wardrobe.beats() if self.mood not in ("waiting", "error") and not dizzy else None
        sway = dip = hop = 0.0
        if beats is not None:
            ph = beats % 1
            sway = math.cos(math.pi * beats)
            dip = (1 - ph) ** 4
            hop = math.sin(math.pi * ph)

        # his mood shows as coloured light behind him, like something glowing through glass
        glow = cairo.RadialGradient(cx, Y(0.56), 0, cx, Y(0.56), S * 0.5)
        glow.add_color_stop_rgba(0, r2, g2, b2, 0.42)
        glow.add_color_stop_rgba(1, r2, g2, b2, 0)
        cr.set_source(glow)
        cr.paint()
        # the floor he stands on
        sh = cairo.RadialGradient(cx, Y(0.95), 0, cx, Y(0.95), S * 0.3)
        sh.add_color_stop_rgba(0, 0, 0, 0, 0.35)
        sh.add_color_stop_rgba(1, 0, 0, 0, 0)
        cr.save()
        cr.translate(cx, Y(0.95))
        cr.scale(1, 0.2)
        cr.translate(-cx, -Y(0.95))
        cr.set_source(sh)
        cr.arc(cx, Y(0.95), S * 0.3, 0, 2 * math.pi)
        cr.fill()
        cr.restore()

        cr.save()
        base_y = Y(0.94)
        cr.translate(cx, base_y - hop * S * 0.035)
        cr.rotate(self.look[0] * 0.06 + sway * 0.12)
        cr.scale(1 - sq * 0.10 + breath * 0.5 + dip * 0.06, 1 + sq * 0.14 + breath - dip * 0.08)
        cr.translate(-cx, -base_y)

        dark_top, dark_bottom = (0.19, 0.20, 0.25), (0.06, 0.06, 0.08)
        feathers = cairo.LinearGradient(cx - S * 0.3, Y(0.1), cx + S * 0.3, Y(0.95))
        feathers.add_color_stop_rgb(0, *dark_top)
        feathers.add_color_stop_rgb(1, *dark_bottom)

        # flippers: hanging at his sides, one waving when something is done (the left in the rain: the right
        # holds the umbrella), swinging up in turn when he dances, in sleeves when he's wearing something
        wave = self.mood == "done" and not dizzy
        umbrella = outfit == "rain"
        waver = -1 if umbrella else 1
        sleeve = {"rain": RAINCOAT, "cold": PUFFER, "autumn": SWEATER, "spring": JACKET}.get(outfit)
        for side in (-1, 1):
            a = 0.35
            if side == 1 and umbrella:
                a = 0.6
            elif side == waver and wave:
                a = 2.3 + math.sin(now * 10) * 0.35
            elif self.mood == "waiting":
                a = 0.6 + math.sin(now * 6 + side) * 0.08
            elif beats is not None:
                a = 0.35 + 1.5 * max(0.0, sway * side) ** 1.5
            cr.save()
            cr.translate(cx + side * S * 0.22, Y(0.46))
            cr.rotate(-side * a)
            ellipse(0, S * 0.15, S * 0.06, S * 0.17)
            if sleeve:
                cr.set_source_rgb(*sleeve)
            else:
                cr.set_source(feathers)
            cr.fill()
            if outfit in ("sunny", "hot"):  # a short t-shirt sleeve
                ellipse(0, S * 0.05, S * 0.075, S * 0.075)
                cr.set_source_rgb(*TSHIRT)
                cr.fill()
            cr.restore()

        if umbrella:                       # the raincoat's hood, round the back of his head
            ellipse(cx, Y(0.28), S * 0.215, S * 0.205)
            cr.set_source_rgb(*RAINCOAT)
            cr.fill()

        # body and head
        cr.new_path()
        ellipse(cx, Y(0.62), S * 0.27, S * 0.31)
        cr.new_sub_path()
        ellipse(cx, Y(0.29), S * 0.19, S * 0.18)
        body = cr.copy_path()
        cr.set_source(feathers)
        cr.fill()

        # belly
        belly = cairo.LinearGradient(0, Y(0.42), 0, Y(0.92))
        belly.add_color_stop_rgb(0, 1.0, 0.99, 0.96)
        belly.add_color_stop_rgb(1, 0.86, 0.87, 0.90)
        ellipse(cx, Y(0.67), S * 0.19, S * 0.245)
        cr.set_source(belly)
        cr.fill()

        self.draw_clothes(cr, outfit, cx, Y, S, ellipse)

        # feet, in yellow wellies in the rain
        for side in (-1, 1):
            if umbrella:
                cr.rectangle(cx + side * S * 0.11 - S * 0.06, Y(0.845), S * 0.12, S * 0.08)
                cr.set_source_rgb(*WELLIES)
                cr.fill()
            ellipse(cx + side * S * 0.11, Y(0.925), S * 0.1, S * 0.042)
            cr.set_source_rgb(*(WELLIES if umbrella else (0.98, 0.66, 0.14)))
            cr.fill()

        # a soft glassy highlight on his head and a thin rim, so he sits in the same light as the island
        cr.save()
        cr.translate(cx - S * 0.08, Y(0.19))
        cr.rotate(-0.6)
        cr.scale(S * 0.07, S * 0.04)
        hl = cairo.RadialGradient(0, 0, 0, 0, 0, 1)
        hl.add_color_stop_rgba(0, 1, 1, 1, 0.35)
        hl.add_color_stop_rgba(1, 1, 1, 1, 0)
        cr.set_source(hl)
        cr.arc(0, 0, 1, 0, 2 * math.pi)
        cr.fill()
        cr.restore()
        cr.append_path(body)
        cr.set_source_rgba(1, 1, 1, 0.14)
        cr.set_line_width(max(0.6, S * 0.01))
        cr.stroke()

        # eyes
        ey = Y(0.265) + self.look[1] * S * 0.012
        lx = self.look[0] * S * 0.02
        erx, ery = S * 0.058, S * 0.075
        if self.mood == "waiting":
            erx, ery = erx * 1.1, ery * 1.15
        blink = 1.0
        if now > self.blink_at:
            k = (now - self.blink_at) / 0.14
            if k >= 1:
                self.blink_at = now + random.uniform(2.5, 6)
            else:
                blink = max(0.08, abs(1 - 2 * k))
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_line_width(max(1.0, S * 0.028))
        for side in (-1, 1):
            x = cx + side * S * 0.072 + lx
            if dizzy:
                cr.set_source_rgb(1, 1, 1)
                cr.new_path()
                spin = now * 8 * side
                for i in range(36):
                    a = spin + i * 0.45
                    rr = erx * 1.2 * i / 36
                    cr.line_to(x + math.cos(a) * rr, ey + math.sin(a) * rr)
                cr.stroke()
            elif self.mood == "done":
                cr.set_source_rgb(1, 1, 1)
                cr.new_path()
                cr.arc(x, ey + ery * 0.4, erx * 0.95, math.pi * 1.1, math.pi * 1.9)
                cr.stroke()
            elif self.mood == "error":
                cr.set_source_rgb(1, 1, 1)
                d = erx * 0.8
                cr.move_to(x - d, ey - d)
                cr.line_to(x + d, ey + d)
                cr.move_to(x + d, ey - d)
                cr.line_to(x - d, ey + d)
                cr.stroke()
            else:
                ellipse(x, ey, erx, ery * blink)
                cr.set_source_rgb(1, 1, 1)
                cr.fill()
                if blink > 0.5:
                    px = x + self.look[0] * erx * 0.4
                    py = ey + ery * 0.15 + self.look[1] * ery * 0.3
                    ellipse(px, py, erx * 0.52, ery * 0.52 * blink)
                    cr.set_source_rgb(0.05, 0.05, 0.07)
                    cr.fill()
                    cr.arc(px + erx * 0.2, py - ery * 0.22, erx * 0.18, 0, 2 * math.pi)
                    cr.set_source_rgba(1, 1, 1, 0.9)
                    cr.fill()

        # beak
        by = Y(0.345)
        bw = S * 0.085
        beak = cairo.LinearGradient(0, by - S * 0.04, 0, by + S * 0.05)
        beak.add_color_stop_rgb(0, 1.0, 0.82, 0.25)
        beak.add_color_stop_rgb(1, 0.93, 0.52, 0.08)
        cr.move_to(cx - bw + lx, by)
        cr.curve_to(cx - bw * 0.6 + lx, by - S * 0.045, cx + bw * 0.6 + lx, by - S * 0.045, cx + bw + lx, by)
        cr.curve_to(cx + bw * 0.45 + lx, by + S * 0.05, cx - bw * 0.45 + lx, by + S * 0.05, cx - bw + lx, by)
        cr.close_path()
        cr.set_source(beak)
        cr.fill()
        self.draw_headwear(cr, outfit, phones, cx, Y, S, ellipse)
        cr.restore()

    @staticmethod
    def draw_clothes(cr, outfit, cx, Y, S, ellipse):
        """What he wears over his body, cut to its shape below the chin."""
        if outfit not in OUTFITS[1:]:
            return
        cr.save()
        cr.set_fill_rule(cairo.FILL_RULE_EVEN_ODD)
        ellipse(cx, Y(0.62), S * 0.285, S * 0.32)          # a little bigger than him: clothes sit on top
        cr.new_sub_path()
        ellipse(cx, Y(0.29), S * 0.19, S * 0.18)            # minus his head
        cr.clip()
        cr.set_fill_rule(cairo.FILL_RULE_WINDING)
        left, width = cx - S * 0.3, S * 0.6
        if outfit == "rain":
            cr.rectangle(left, Y(0.38), width, S * 0.56)
            coat = cairo.LinearGradient(cx - S * 0.28, 0, cx + S * 0.28, 0)
            coat.add_color_stop_rgb(0, 1.0, 0.90, 0.35)
            coat.add_color_stop_rgb(1, *RAINCOAT)
            cr.set_source(coat)
            cr.fill()
            cr.move_to(cx, Y(0.47))
            cr.line_to(cx, Y(0.93))
            cr.set_source_rgba(0.55, 0.40, 0.0, 0.6)
            cr.set_line_width(max(0.6, S * 0.01))
            cr.stroke()
            for y in (0.56, 0.68, 0.80):
                cr.arc(cx + S * 0.03, Y(y), max(0.6, S * 0.014), 0, 2 * math.pi)
                cr.set_source_rgb(0.35, 0.25, 0.05)
                cr.fill()
        elif outfit == "autumn":
            cr.rectangle(left, Y(0.38), width, S * 0.5)
            cr.set_source_rgb(*SWEATER)
            cr.fill()
            cr.set_source_rgba(1, 0.85, 0.6, 0.25)          # cable knit
            cr.set_line_width(max(0.6, S * 0.014))
            for k in (-2, -1, 0, 1, 2):
                x = cx + k * S * 0.075
                cr.move_to(x, Y(0.5))
                for j in range(6):
                    cr.line_to(x + (S * 0.012 if j % 2 else -S * 0.012), Y(0.52 + j * 0.06))
            cr.stroke()
            cr.rectangle(left, Y(0.84), width, S * 0.04)    # ribbed hem
            cr.set_source_rgba(0, 0, 0, 0.2)
            cr.fill()
        elif outfit == "spring":
            for side in (-1, 1):                            # an open jacket: his belly shows down the middle
                x0 = cx + side * S * 0.07
                cr.rectangle(min(x0, x0 + side * S * 0.25), Y(0.38), S * 0.25, S * 0.5)
            cr.set_source_rgb(*JACKET)
            cr.fill()
            cr.set_source_rgba(0.1, 0.35, 0.2, 0.5)
            cr.set_line_width(max(0.6, S * 0.01))
            for side in (-1, 1):
                cr.move_to(cx + side * S * 0.07, Y(0.46))
                cr.line_to(cx + side * S * 0.07, Y(0.9))
            cr.stroke()
        elif outfit in ("sunny", "hot"):
            cr.rectangle(left, Y(0.38), width, S * 0.34)
            cr.set_source_rgb(*TSHIRT)
            cr.fill()
            cr.rectangle(left, Y(0.72), width, S * 0.14)
            cr.set_source_rgb(*SHORTS)
            cr.fill()
            cr.move_to(cx, Y(0.78))
            cr.line_to(cx, Y(0.86))
            cr.set_source_rgba(0.05, 0.12, 0.35, 0.8)
            cr.set_line_width(max(0.6, S * 0.012))
            cr.stroke()
        else:
            cr.rectangle(left, Y(0.38), width, S * 0.53)
            cr.set_source_rgb(*PUFFER)
            cr.fill()
            cr.set_source_rgba(0, 0, 0.1, 0.45)             # the puffer's quilted baffles
            cr.set_line_width(max(0.6, S * 0.012))
            for k in range(6):
                y = Y(0.52 + k * 0.07)
                cr.move_to(left, y)
                cr.curve_to(cx - S * 0.1, y + S * 0.02, cx + S * 0.1, y + S * 0.02, left + width, y)
            cr.move_to(cx, Y(0.46))
            cr.line_to(cx, Y(0.92))
            cr.stroke()
        cr.restore()
        if outfit == "autumn":                              # the sweater's turtleneck
            ellipse(cx, Y(0.455), S * 0.17, S * 0.035)
            cr.set_source_rgb(*(c * 0.85 for c in SWEATER))
            cr.fill()
        if outfit == "spring":                              # a flower on the lapel
            fx, fy, r = cx - S * 0.15, Y(0.54), S * 0.022
            for k in range(5):
                a = k * 2 * math.pi / 5
                cr.arc(fx + math.cos(a) * r, fy + math.sin(a) * r, r * 0.8, 0, 2 * math.pi)
                cr.set_source_rgb(1.0, 0.62, 0.78)
                cr.fill()
            cr.arc(fx, fy, r * 0.6, 0, 2 * math.pi)
            cr.set_source_rgb(1.0, 0.85, 0.2)
            cr.fill()
        if outfit == "cold":
            # a striped scarf round his neck, one end hanging down
            cr.save()
            cr.translate(cx + S * 0.07, Y(0.47))
            cr.rotate(-0.12)
            cr.rectangle(-S * 0.035, 0, S * 0.07, S * 0.15)
            cr.restore()
            cr.new_sub_path()
            ellipse(cx, Y(0.455), S * 0.19, S * 0.04)
            cr.set_source_rgb(*SCARF)
            cr.fill()
            cr.set_source_rgba(1, 1, 1, 0.85)
            cr.set_line_width(max(0.6, S * 0.012))
            for k in (-2, -1, 0, 1, 2):
                cr.move_to(cx + k * S * 0.07, Y(0.425))
                cr.line_to(cx + k * S * 0.07, Y(0.485))
            cr.stroke()

