# ---------- files and folders, indexed ----------
# Everything under your home (not hidden, minus what's .gitignored, ~/.config/fd/ignore, and the build
# junk below) plus ~/.config, kept in memory so each keystroke searches it in a few milliseconds.
# ~/.config/guy/files.json: {"exclude": ["intelFPGA_lite", ...], "roots": ["/mnt/data"]} (fd globs).
FILES_CONFIG = os.path.expanduser("~/.config/guy/files.json")
FILES_OPENED = os.path.expanduser("~/.cache/guy/opened.json")
FILES_EXCLUDE = ["node_modules", "__pycache__", "site-packages", ".venv", "venv", "__MACOSX", "/go/pkg",
                 "*.pyc", "*.o"]
FILES_STALE = 300                 # seconds before opening the search rebuilds the index (in the background)
FILES_CAP = 1000                  # candidates per search term, best kinds of match first
FILES_WATCH = ("", "Desktop", "Documents", "Downloads", "Pictures", "Videos", "Music", "Desktop/Projects")
_FILE_SEPS = bytes.maketrans(b" _.-([", b"\1" * 6)


def file_key(name):
    """A name as the index keeps it: lowercase, with every word break as \\1."""
    return name.decode(errors="surrogateescape").lower().encode(errors="surrogateescape").translate(_FILE_SEPS)


def index_files():
    """The six blobs FileIndex searches: every path ("\\0"-separated, folders ending in "/"), where each
    starts, each name once (file_key, sorted), where each starts, the entries in name order, and where
    each name's run of entries starts in that order. Bytes, not str: one name with an accent would make a
    str 4 bytes a character, and bytes.find is several times faster. Runs as its own process
    (guy --index-files), so its Python loops never hold up GUY's."""
    import array
    import json
    import re
    import subprocess
    home = os.path.expanduser("~")
    try:
        with open(FILES_CONFIG) as f:
            cfg = json.load(f)
    except (OSError, ValueError):
        cfg = {}
    ex = [a for e in FILES_EXCLUDE + list(cfg.get("exclude", [])) for a in ("-E", e)]
    out = []
    for cmd in (["fd", "--threads", "4", "-0", *ex, ".", home, *cfg.get("roots", [])],
                ["fd", "--threads", "2", "-0", "-H", "--max-depth", "4", *ex, "-E", ".git", ".", home + "/.config"]):
        try:
            out.append(subprocess.run(cmd, capture_output=True, timeout=60).stdout)
        except (OSError, subprocess.SubprocessError):
            pass
    paths = b"\0" + b"".join(out)              # every entry between two \0s
    if len(paths) < 2:
        return [b"", b"", b"", b"", b"", b""]
    entries = paths[1:-1].split(b"\0")
    starts = array.array("I", (m.end() for m in re.finditer(b"\0", paths)))
    starts.pop()                                 # the last \0 ends the last entry
    keys = [file_key(e[e.rfind(b"/", 0, len(e) - 1) + 1:].rstrip(b"/")) for e in entries]
    del entries
    # each name once (README.md is in hundreds of folders), sorted, with the entries that have it
    order = array.array("I", sorted(range(len(keys)), key=keys.__getitem__))
    names, nstarts, runs, last, pos = [b""], array.array("I"), array.array("I"), None, 1
    for j, i in enumerate(order):
        if keys[i] != last:
            last = keys[i]
            names.append(last)
            nstarts.append(pos)
            runs.append(j)
            pos += len(last) + 1
    runs.append(len(order))
    return [paths, starts.tobytes(), b"\0".join(names) + b"\0", nstarts.tobytes(), order.tobytes(), runs.tobytes()]


if sys.argv[1:] == ["--index-files"]:
    import struct
    _parts = index_files()
    sys.stdout.buffer.write(struct.pack("6Q", *map(len, _parts)) + b"".join(_parts))
    sys.exit(0)

