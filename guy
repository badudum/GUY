def score(query, name, extra="", words=None, extra_words=None):
    name = name.lower()
    total = 0
    for term in query.lower().split():
        if name.startswith(term):
            s = 100
        elif any(w.startswith(term) for w in (words if words is not None else _words(name))):
            s = 80
        elif term in name:
            s = 60
        elif any(w.startswith(term) for w in (extra_words if extra_words is not None else _extra_words(extra))):
            s = 40
        elif len(term) > 2 and term in extra:
            s = 20
        else:
            return 0
        total += s
    return total - len(name) / 100


