def scan_procs():
    """pid -> (comm, state, ppid, pgrp, tty_nr, tpgid, cpu ticks), from the world-readable /proc/*/stat."""
    procs = {}
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        try:
            with open(f"/proc/{d}/stat", "rb") as f:
                raw = f.read().decode(errors="replace")
        except OSError:
            continue
        r = raw.rfind(")")
        f = raw[r + 2:].split()
        procs[int(d)] = (raw[raw.find("(") + 1:r], f[0], int(f[1]), int(f[2]), int(f[4]), int(f[5]),
                         int(f[11]) + int(f[12]))
    return procs


def pts_path(tty_nr):
    major, minor = (tty_nr >> 8) & 0xFFF, (tty_nr & 0xFF) | ((tty_nr >> 12) & 0xFFF00)
    return f"/dev/pts/{minor + (major - 136) * 256}" if 136 <= major <= 143 else None


def echo_off(tty_nr):
    """True when the terminal has echo off but line input on: someone is being asked for a password.
    Only reads the terminal's settings, never what's typed; root-owned ptys (sudo use_pty) are skipped."""
    path = pts_path(tty_nr)
    if not path:
        return False
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOCTTY | os.O_NONBLOCK)
    except OSError:
        return False
    try:
        lflag = termios.tcgetattr(fd)[3]
    except termios.error:
        return False
    finally:
        os.close(fd)
    return not (lflag & termios.ECHO) and bool(lflag & termios.ICANON)


