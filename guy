        self.set_valign(Gtk.Align.CENTER)
        self.size, self.owner = size, owner
        self.mood = "idle"
        self.colors = [list(c) for c in MOODS["idle"]]
        self.look = [0.0, 0.0]
        self.squish, self.squish_v = 0.0, 0.0
        self.blink_at = time.monotonic() + random.uniform(1.5, 4)
        self.dizzy_until = 0.0
        self.pokes = []
        self.tick = None
        self.last = None
        self.drawn_at, self.drawn_mood = 0.0, None
        self.set_draw_func(self.draw)
        self.connect("map", self.on_map)
        self.connect("unmap", self.on_unmap)
        click = Gtk.GestureClick()
        click.connect("pressed", lambda *_: self.poke())
        self.add_controller(click)

    def on_map(self, _w):
        if self.tick is None:
            self.last = None
            self.tick = self.add_tick_callback(self.on_tick)

    def on_unmap(self, _w):
        if self.tick is not None:
            self.remove_tick_callback(self.tick)
            self.tick = None

    def poke(self):
        self.squish_v -= 7.0
        now = time.monotonic()
        self.pokes = [t for t in self.pokes if now - t < 1.2] + [now]
        if len(self.pokes) >= 3:
            self.dizzy_until = now + 3.0
            self.pokes = []

    def on_tick(self, _w, clock):
        t = clock.get_frame_time() / 1e6
        dt = min(1 / 30, t - self.last) if self.last else 1 / 60
        self.last = t
        # squish spring, underdamped so a poke wobbles
        self.squish_v += (-180 * self.squish - 9 * self.squish_v) * dt
        self.squish += self.squish_v * dt
        target = MOODS.get(self.mood, MOODS["idle"])
        for cur, tgt in zip(self.colors, target):
            for i in range(3):
                cur[i] += (tgt[i] - cur[i]) * min(1, dt * 6)
        # eyes: the pointer when it's over the island, otherwise a slow look around
        px = self.owner.pointer
        if self.mood == "working" and px is None:
            want = (math.sin(t * 1.7) * 0.8, 0.1)
        elif px is not None:
            ok, p = self.compute_point(self.get_root(), Graphene.Point().init(self.size / 2, self.size / 2))
            dx, dy = (px[0] - p.x, px[1] - p.y) if ok else (0, 0)
            want = (max(-1, min(1, dx / 160)), max(-1, min(1, dy / 120)))
        else:
            want = (math.sin(t * 0.35) * 0.3, 0.0)
        for i in range(2):
            self.look[i] += (want[i] - self.look[i]) * min(1, dt * 8)
        # at rest he only breathes and glances around slowly: 30 fps is plenty and halves the cost;
        # a poke, the pointer, a blink or a mood change gets every frame
        calm = (abs(self.squish) < 0.002 and abs(self.squish_v) < 0.02 and px is None
                and time.monotonic() < self.blink_at - 0.05 and self.drawn_mood == self.mood)
        if not calm or t - self.drawn_at >= 1 / 31:
            self.drawn_at, self.drawn_mood = t, self.mood
            self.queue_draw()
        return True

    def draw(self, _area, cr, width, height):
        now = time.monotonic()
        S = min(width, height)
        cx = width / 2
        oy = (height - S) / 2

        def Y(f):
            return oy + f * S

        def ellipse(x, y, rx, ry):
            cr.save()
            cr.translate(x, y)
            cr.scale(max(rx, 0.01), max(ry, 0.01))
            cr.arc(0, 0, 1, 0, 2 * math.pi)
            cr.restore()

        breath = math.sin(now * 2.2) * 0.015
        sq = self.squish
        (r1, g1, b1), (r2, g2, b2) = self.colors
        dizzy = now < self.dizzy_until

        # his mood shows as coloured light behind him, like something glowing through glass
        glow = cairo.RadialGradient(cx, Y(0.56), 0, cx, Y(0.56), S * 0.5)
        glow.add_color_stop_rgba(0, r2, g2, b2, 0.42)
        glow.add_color_stop_rgba(1, r2, g2, b2, 0)
        cr.set_source(glow)
        cr.paint()
        # the floor he stands on
        sh = cairo.RadialGradient(cx, Y(0.95), 0, cx, Y(0.95), S * 0.3)
        sh.add_color_stop_rgba(0, 0, 0, 0, 0.35)
        sh.add_color_stop_rgba(1, 0, 0, 0, 0)
        cr.save()
        cr.translate(cx, Y(0.95))
        cr.scale(1, 0.2)
        cr.translate(-cx, -Y(0.95))
        cr.set_source(sh)
        cr.arc(cx, Y(0.95), S * 0.3, 0, 2 * math.pi)
        cr.fill()
        cr.restore()

        cr.save()
        base_y = Y(0.94)
        cr.translate(cx, base_y)
        cr.rotate(self.look[0] * 0.06)
        cr.scale(1 - sq * 0.10 + breath * 0.5, 1 + sq * 0.14 + breath)
        cr.translate(-cx, -base_y)

        dark_top, dark_bottom = (0.19, 0.20, 0.25), (0.06, 0.06, 0.08)
        feathers = cairo.LinearGradient(cx - S * 0.3, Y(0.1), cx + S * 0.3, Y(0.95))
        feathers.add_color_stop_rgb(0, *dark_top)
        feathers.add_color_stop_rgb(1, *dark_bottom)

        # flippers: hanging at his sides, the right one waving when something is done
        wave = self.mood == "done" and not dizzy
        for side in (-1, 1):
            a = 0.35
            if side == 1 and wave:
                a = 2.3 + math.sin(now * 10) * 0.35
            elif self.mood == "waiting":
                a = 0.6 + math.sin(now * 6 + side) * 0.08
            cr.save()
            cr.translate(cx + side * S * 0.22, Y(0.46))
            cr.rotate(-side * a)
            ellipse(0, S * 0.15, S * 0.06, S * 0.17)
            cr.set_source(feathers)
            cr.fill()
            cr.restore()

        # body and head
        cr.new_path()
        ellipse(cx, Y(0.62), S * 0.27, S * 0.31)
        cr.new_sub_path()
        ellipse(cx, Y(0.29), S * 0.19, S * 0.18)
        body = cr.copy_path()
        cr.set_source(feathers)
        cr.fill()

        # belly
        belly = cairo.LinearGradient(0, Y(0.42), 0, Y(0.92))
        belly.add_color_stop_rgb(0, 1.0, 0.99, 0.96)
        belly.add_color_stop_rgb(1, 0.86, 0.87, 0.90)
        ellipse(cx, Y(0.67), S * 0.19, S * 0.245)
        cr.set_source(belly)
        cr.fill()

        # feet
        for side in (-1, 1):
            ellipse(cx + side * S * 0.11, Y(0.925), S * 0.1, S * 0.042)
            cr.set_source_rgb(0.98, 0.66, 0.14)
            cr.fill()

        # a soft glassy highlight on his head and a thin rim, so he sits in the same light as the island
        cr.save()
        cr.translate(cx - S * 0.08, Y(0.19))
        cr.rotate(-0.6)
        cr.scale(S * 0.07, S * 0.04)
        hl = cairo.RadialGradient(0, 0, 0, 0, 0, 1)
        hl.add_color_stop_rgba(0, 1, 1, 1, 0.35)
        hl.add_color_stop_rgba(1, 1, 1, 1, 0)
        cr.set_source(hl)
        cr.arc(0, 0, 1, 0, 2 * math.pi)
        cr.fill()
        cr.restore()
        cr.append_path(body)
        cr.set_source_rgba(1, 1, 1, 0.14)
        cr.set_line_width(max(0.6, S * 0.01))
        cr.stroke()

        # eyes
        ey = Y(0.265) + self.look[1] * S * 0.012
        lx = self.look[0] * S * 0.02
        erx, ery = S * 0.058, S * 0.075
        if self.mood == "waiting":
            erx, ery = erx * 1.1, ery * 1.15
        blink = 1.0
        if now > self.blink_at:
            k = (now - self.blink_at) / 0.14
            if k >= 1:
                self.blink_at = now + random.uniform(2.5, 6)
            else:
                blink = max(0.08, abs(1 - 2 * k))
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_line_width(max(1.0, S * 0.028))
        for side in (-1, 1):
            x = cx + side * S * 0.072 + lx
            if dizzy:
                cr.set_source_rgb(1, 1, 1)
                cr.new_path()
                spin = now * 8 * side
                for i in range(36):
                    a = spin + i * 0.45
                    rr = erx * 1.2 * i / 36
                    cr.line_to(x + math.cos(a) * rr, ey + math.sin(a) * rr)
                cr.stroke()
            elif self.mood == "done":
                cr.set_source_rgb(1, 1, 1)
                cr.new_path()
                cr.arc(x, ey + ery * 0.4, erx * 0.95, math.pi * 1.1, math.pi * 1.9)
                cr.stroke()
            elif self.mood == "error":
                cr.set_source_rgb(1, 1, 1)
                d = erx * 0.8
                cr.move_to(x - d, ey - d)
                cr.line_to(x + d, ey + d)
                cr.move_to(x + d, ey - d)
                cr.line_to(x - d, ey + d)
                cr.stroke()
            else:
                ellipse(x, ey, erx, ery * blink)
                cr.set_source_rgb(1, 1, 1)
                cr.fill()
                if blink > 0.5:
                    px = x + self.look[0] * erx * 0.4
                    py = ey + ery * 0.15 + self.look[1] * ery * 0.3
                    ellipse(px, py, erx * 0.52, ery * 0.52 * blink)
                    cr.set_source_rgb(0.05, 0.05, 0.07)
                    cr.fill()
                    cr.arc(px + erx * 0.2, py - ery * 0.22, erx * 0.18, 0, 2 * math.pi)
                    cr.set_source_rgba(1, 1, 1, 0.9)
                    cr.fill()

        # beak
        by = Y(0.345)
        bw = S * 0.085
        beak = cairo.LinearGradient(0, by - S * 0.04, 0, by + S * 0.05)
        beak.add_color_stop_rgb(0, 1.0, 0.82, 0.25)
        beak.add_color_stop_rgb(1, 0.93, 0.52, 0.08)
        cr.move_to(cx - bw + lx, by)
        cr.curve_to(cx - bw * 0.6 + lx, by - S * 0.045, cx + bw * 0.6 + lx, by - S * 0.045, cx + bw + lx, by)
        cr.curve_to(cx + bw * 0.45 + lx, by + S * 0.05, cx - bw * 0.45 + lx, by + S * 0.05, cx - bw + lx, by)
        cr.close_path()
        cr.set_source(beak)
        cr.fill()
        cr.restore()


# ---------- the island: a liquid-glass shape hanging from the top edge ----------
def squircle_corner(cr, cx, cy, r, t0, t1, steps=14):
    """A quarter superellipse like Hyprland's rounding_power corners, from angle t0 to t1."""
    for i in range(steps + 1):
        t = t0 + (t1 - t0) * i / steps
        c, n = math.cos(t), math.sin(t)
        cr.line_to(cx + math.copysign(abs(c) ** (2 / GLASS["power"]), c) * r,
                   cy + math.copysign(abs(n) ** (2 / GLASS["power"]), n) * r)


def island_path(cr, L, R, h, s, r, bulge, closed=True):
    cx = (L + R) / 2
    cr.move_to(L - s, 0)
    cr.arc(L - s, s, s, -math.pi / 2, 0)                  # concave shoulder into the screen edge
    cr.line_to(L, h - r)
    squircle_corner(cr, L + r, h - r, r, math.pi, math.pi / 2)
    cr.curve_to((L + r + cx) / 2, h + bulge, (R - r + cx) / 2, h + bulge, R - r, h)   # the drip
    squircle_corner(cr, R - r, h - r, r, math.pi / 2, 0)
    cr.line_to(R, s)
    cr.arc(R + s, s, s, math.pi, math.pi * 1.5)
    if closed:
        cr.close_path()


def draw_glass(cr, L, R, h, s, r, bulge):
    g = GLASS

    # drop shadow, outside the glass only, and faded out toward the bar so it doesn't smudge it
    cr.save()
    pad = g["shadow_range"] + s + 4
    cr.rectangle(L - pad, 0, (R - L) + 2 * pad, h + bulge + g["shadow_offset"] + g["shadow_range"] + 4)
    island_path(cr, L, R, h, s, r, bulge)
    cr.set_fill_rule(cairo.FILL_RULE_EVEN_ODD)
    cr.clip()
    cr.set_fill_rule(cairo.FILL_RULE_WINDING)
    cr.push_group()
    cr.translate(0, g["shadow_offset"])
    cr.set_line_join(cairo.LINE_JOIN_ROUND)
    steps = 13
    # fades from the glass's own edge, so there's no flat band under it on light backgrounds
    start = 0.0

    def shade(d):
        return g["shadow_alpha"] * max(0.0, 1 - d / g["shadow_range"]) ** g["shadow_power"]

    island_path(cr, L, R, h, s, r, bulge)
    cr.set_source_rgba(0, 0, 0, shade(start))
    cr.fill()
    step = (g["shadow_range"] - start) / steps
    for k in range(1, steps + 1):
        d = start + step * k
        island_path(cr, L, R, h, s, r, bulge)
        cr.set_source_rgba(0, 0, 0, shade(d - step) - shade(d))
        d -= start
        cr.set_line_width(2 * d)
        cr.stroke()
    cr.pop_group_to_source()
    fade = cairo.LinearGradient(0, 0, 0, max(h * 0.8, 24))
    fade.add_color_stop_rgba(0, 0, 0, 0, 0)
    fade.add_color_stop_rgba(1, 0, 0, 0, 1)
    cr.mask(fade)
    cr.restore()

    # the glass itself: the terminal's background colour at the terminal's opacity, blurred by Hyprland
    island_path(cr, L, R, h, s, r, bulge)
    cr.set_source_rgba(*g["fill"])
    cr.fill()

    # inner glow: white at the rim fading to nothing, the same falloff as the terminal's lit edge
    cr.save()
    island_path(cr, L, R, h, s, r, bulge)
    cr.clip()

    def glow(d):
        return g["glow_alpha"] * max(0.0, 1 - d / g["glow_range"]) ** g["glow_power"]

    cr.set_line_join(cairo.LINE_JOIN_ROUND)
    for k in range(int(g["glow_range"]), 0, -1):
        island_path(cr, L, R, h, s, r, bulge, closed=False)
        cr.set_source_rgba(1, 1, 1, glow(k - 1) - glow(k))
        cr.set_line_width(2 * k)
        cr.stroke()
    cr.restore()

    # the 1px rim, even all the way round
    island_path(cr, L, R, h, s, r, bulge, closed=False)
    cr.set_source_rgba(1, 1, 1, g["rim_alpha"])
    cr.set_line_width(1.0)
    cr.stroke()


class Island(Gtk.Widget):
    __gtype_name__ = "GuyIsland"

    def __init__(self, content):
        super().__init__()
        self.content = content
        content.set_parent(self)
        self.w, self.h, self.vw, self.vh = float(HIDDEN_W), 0.0, 0.0, 0.0
        self.tw, self.th = float(HIDDEN_W), 0.0
        self.alpha = 0.0
        self.follow = False      # the target height tracks the content's natural height
        self.on_target = None    # called when following changes the target

    def geometry(self):
        s = min(SHOULDER + min(abs(self.vw) * 0.006, 8), self.h / 2)
        r = max(0.0, min(RADIUS, self.h / 2, self.w / 2))
        # it drips a little as it grows; going away it just retracts, straight up
        bulge = min(self.vh * 0.012, BULGE_MAX) if self.h > 8 and self.vh > 0 else 0.0
        return s, r, bulge

    def do_measure(self, orientation, _for_size):
        n = SURF_W if orientation == Gtk.Orientation.HORIZONTAL else SURF_H
        return n, n, -1, -1

    def page_height(self, widget, width):
        return min(widget.measure(Gtk.Orientation.VERTICAL, int(width))[1], SURF_H - SHADOW_PAD)

    def do_size_allocate(self, width, _height, _baseline):
        if not self.content.get_visible():
            return
        tw = int(self.tw)
        ch = self.page_height(self.content, tw)
        if self.follow and abs(ch - self.th) > 0.5:
            self.th = float(ch)
            if self.on_target:
                GLib.idle_add(self.on_target)
        t = Gsk.Transform.new().translate(Graphene.Point().init((width - tw) / 2, 0))
        self.content.allocate(tw, ch, -1, t)

    def do_snapshot(self, snap):
        if self.h < 0.5:
            return
        s, r, bulge = self.geometry()
        L = self.get_width() / 2 - self.w / 2
        R = L + self.w
        cr = snap.append_cairo(Graphene.Rect().init(L - s - SHADOW_PAD, 0, self.w + 2 * (s + SHADOW_PAD),
                                                    self.h + bulge + SHADOW_PAD))
        draw_glass(cr, L, R, self.h, s, r, bulge)
        if self.alpha > 0.01 and self.content.get_visible():
            rr = Gsk.RoundedRect()
            zero, rad = Graphene.Size().init(0, 0), Graphene.Size().init(r, r)
            rr.init(Graphene.Rect().init(L, 0, self.w, self.h), zero, zero, rad, rad)
            snap.push_rounded_clip(rr)
            snap.push_opacity(self.alpha)
            snap.save()
            snap.translate(Graphene.Point().init(0, -(1 - self.alpha) * 10))
            self.snapshot_child(self.content, snap)
            snap.restore()
            snap.pop()
            snap.pop()


# ---------- the socket the hook relay talks to ----------
class HookServer:
    def __init__(self, on_event, on_gone):
        self.on_event, self.on_gone = on_event, on_gone
        self.live = set()
        try:
            SOCK.unlink()
        except FileNotFoundError:
            pass
        self.svc = Gio.SocketService.new()
        self.svc.add_address(Gio.UnixSocketAddress.new(str(SOCK)), Gio.SocketType.STREAM,
                             Gio.SocketProtocol.DEFAULT, None)
        os.chmod(SOCK, 0o600)
        self.svc.connect("incoming", self.incoming)
        self.svc.start()

    def incoming(self, _svc, conn, _source):
        stream = Gio.DataInputStream.new(conn.get_input_stream())
        self.live.add((conn, stream))
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self.first_line, conn)
        return True

    def first_line(self, stream, result, conn):
        try:
            line, _n = stream.read_line_finish_utf8(result)
            ev = json.loads(line) if line else None
        except (GLib.Error, ValueError):
            ev = None
        if isinstance(ev, dict) and self.on_event(ev, conn):
            # the relay is waiting for our answer; end-of-stream means Claude Code gave up on it
            stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self.watch, conn)
        else:
            self.close(conn)

    def watch(self, stream, result, conn):
        try:
            stream.read_line_finish_utf8(result)
        except GLib.Error:
            pass
        self.close(conn)
        self.on_gone(conn)

    def reply(self, conn, text):
        try:
            if text:
                conn.get_output_stream().write_all((text + "\n").encode(), None)
        except GLib.Error:
            pass
        self.close(conn)

    def close(self, conn):
        for item in [i for i in self.live if i[0] is conn]:
            self.live.discard(item)
        try:
            conn.close(None)
        except GLib.Error:
            pass


class Session:
    def __init__(self, sid, cwd):
        self.id = sid
        self.cwd = cwd or ""
        self.name = os.path.basename(cwd.rstrip("/")) or cwd or "Claude Code"
        self.status = "idle"
        self.last = "Started"
        self.reply = ""            # Claude's final reply, from the Stop hook
        self.updated = time.time()


def human_size(n):
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024


def first_line(text, limit=110):
    """The first readable line of some Markdown, for a one-line summary."""
    for line in text.splitlines():
        line = re.sub(r"[`*_#>]+", "", line).strip(" -•\t")
        if line:
            return line if len(line) <= limit else line[:limit - 1] + "…"
    return ""


class Activity:
    """Something going on that GUY shows: a download, a pacman run, anything a script reports."""

    def __init__(self, key, kind, title, icon):
        self.key, self.kind, self.title, self.icon = key, kind, title, icon
        self.detail = ""
        self.progress = None
        self.state = "running"     # running, done, error
        self.open = None           # path or URL opened on click
        self.updated = time.time()


PARTIAL_SUFFIXES = (".crdownload", ".part")


class DownloadWatcher:
    """Browser downloads: Chrome writes name.crdownload (at first "Unconfirmed 123.crdownload"), Firefox
    name.part; both rename it to the final name when done and delete it when cancelled. Costs nothing
    until a download starts; then it checks sizes once a second for the speed."""

    def __init__(self, guy):
        self.guy = guy
        self.dir = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOWNLOAD) or str(HOME / "Downloads")
        self.tracked = {}          # partial path -> [activity, last size, last time]
        self.poll_id = None
        self.mon = None
        if not os.path.isdir(self.dir):
            return
        self.mon = Gio.File.new_for_path(self.dir).monitor_directory(Gio.FileMonitorFlags.WATCH_MOVES, None)
        self.mon.connect("changed", self.changed)
        for name in os.listdir(self.dir):
            path = os.path.join(self.dir, name)
            try:
                if self.partial(path) and time.time() - os.path.getmtime(path) < 60:
                    self.track(path)
            except OSError:
                pass

    @staticmethod
    def partial(path):
        return path.endswith(PARTIAL_SUFFIXES)

    @staticmethod
    def final_name(path):
        name = os.path.basename(path)
        for suffix in PARTIAL_SUFFIXES:
            name = name.removesuffix(suffix)
        return name

    def title(self, path):
        name = self.final_name(path)
        return "Starting a download…" if name.startswith("Unconfirmed ") else name

    def track(self, path):
        if path in self.tracked:
            return
        act = self.guy.set_activity("dl:" + path, "download", self.title(path), "folder-download-symbolic",
                                    detail="Downloading…", open=self.dir)
        act.state = "running"
        self.tracked[path] = [act, 0, time.monotonic()]
        if self.poll_id is None:
            self.poll_id = GLib.timeout_add(1000, self.poll)
        self.guy.apply()

    def changed(self, _mon, file, other, event):
        E = Gio.FileMonitorEvent
        path = file.get_path() if file else None
        if not path:
            return
        if event in (E.CREATED, E.MOVED_IN, E.CHANGED) and self.partial(path):
            self.track(path)
        elif event == E.RENAMED and other is not None:
            new = other.get_path()
            if path in self.tracked:
                if self.partial(new):          # Chrome naming "Unconfirmed 123.crdownload" properly
                    entry = self.tracked.pop(path)
                    self.tracked[new] = entry
                    entry[0].title = self.title(new)
                else:
                    self.finished(path, new)
            elif self.partial(new):
                self.track(new)
        elif event in (E.DELETED, E.MOVED_OUT) and path in self.tracked:
            final = os.path.join(self.dir, self.final_name(path))
            try:
                done = os.path.getsize(final) > 0
            except OSError:
                done = False
            if done:
                self.finished(path, final)
            else:                              # cancelled
                act = self.tracked.pop(path)[0]
                self.guy.remove_activity(act.key)

    def finished(self, old, new):
        act = self.tracked.pop(old)[0]
        try:
            size = human_size(os.path.getsize(new))
        except OSError:
            size = ""
        act.state, act.progress, act.open = "done", None, new
        act.title = os.path.basename(new)
        act.detail = "Downloaded" + (f"  ·  {size}" if size else "") + "  ·  click to open"
        act.updated = time.time()
        self.guy.flash(f"Downloaded {act.title}", "done", 5.0)

    def poll(self):
        now = time.monotonic()
        for path, entry in list(self.tracked.items()):
            act, last, then = entry
            try:
                size = os.path.getsize(path)
            except OSError:
                continue
            speed = max(0.0, (size - last) / max(now - then, 0.001)) if last else 0.0
            entry[1], entry[2] = size, now
            act.detail = human_size(size) + (f"  ·  {human_size(speed)}/s" if speed else "")
            act.updated = time.time()
        if not self.tracked:
            self.poll_id = None
            return False
        self.guy.apply()
        return True


class PacmanWatcher:
    """pacman, and so yay, as it runs: follows /var/log/pacman.log line by line."""

    LOG = "/var/log/pacman.log"
    LINE = re.compile(r"^\[[^\]]+\] \[(\w+)\] (.*)$")
    CHANGE = re.compile(r"^(upgraded|installed|removed|downgraded|reinstalled) (\S+)")

    def __init__(self, guy):
        self.guy = guy
        self.act = None
        self.count = 0
        self.full = False
        self.mon = None
        self.last_line = 0.0       # monotonic time of the last log line, for the prompt watcher
        try:
            self.offset = os.path.getsize(self.LOG)
        except OSError:
            return
        self.mon = Gio.File.new_for_path(self.LOG).monitor_file(Gio.FileMonitorFlags.NONE, None)
        self.mon.connect("changed", self.changed)

    def changed(self, *_):
        try:
            with open(self.LOG, "rb") as f:
                if os.fstat(f.fileno()).st_size < self.offset:    # rotated
                    self.offset = 0
                f.seek(self.offset)
                data = f.read()
        except OSError:
            return
        end = data.rfind(b"\n")
        if end < 0:
            return
        self.offset += end + 1
        self.last_line = time.monotonic()
        for line in data[:end].decode(errors="replace").splitlines():
            self.line(line)
        self.guy.apply()

    def running(self):
        return (self.act is not None and self.act.state == "running"
                and self.guy.activities.get("pacman") is self.act)   # not pruned while quiet

    def start(self, detail, pop=False):
        if not self.running():
            self.count, self.full = 0, False
            self.act = self.guy.set_activity("pacman", "update", "Packages", "system-software-update-symbolic")
            self.act.state, self.act.open = "running", None
            pop = True
        self.act.detail = detail
        self.act.updated = time.time()
        what = "Updating the system" if self.full else "Installing packages"
        self.act.title = what + (f"  ·  {self.count}" if self.count else "")
        if pop:
            self.guy.pop(self.act, 4.0)

    def finish(self, ok):
        if not self.running():
            return
        n = self.count
        noun = "package" if n == 1 else "packages"
        if ok:
            self.act.title = (f"System updated  ·  {n} {noun}" if self.full else f"{n} {noun} changed")
            self.act.detail = "Done"
        else:
            self.act.title, self.act.detail = "Package update failed", "See the terminal"
        self.act.state = "done" if ok else "error"
        self.act.updated = time.time()
        self.guy.pop(self.act, 6.0)
        GLib.timeout_add_seconds(5, self.guy.check_updates)

    def line(self, line):
        m = self.LINE.match(line)
        if not m:
            return
        source, msg = m.groups()
        if msg == "synchronizing package lists":
            self.start("Syncing package databases…")
        elif msg == "starting full system upgrade":
            self.start("Downloading packages…")
            self.full = True
            self.start("Downloading packages…")
        elif source == "ALPM" and msg == "transaction started":
            self.start("Installing…", pop=True)
        elif source == "ALPM" and (c := self.CHANGE.match(msg)):
            self.count += 1
            self.start(f"{c.group(1).capitalize()} {c.group(2)}")
        elif source == "ALPM" and msg.startswith("running '") and self.running():
            self.act.detail = "Running hooks…"
        elif source == "ALPM" and msg == "transaction completed":
            self.finish(True)
        elif source == "ALPM" and re.match(r"transaction (failed|interrupted)", msg):
            self.finish(False)


class MediaWatcher:
    """Whatever is playing (Spotify, a browser tab, mpv…), from MPRIS via `playerctl --follow`, which
    blocks until something changes, so it costs nothing while nothing does."""

    FORMAT = "{{playerName}}\t{{status}}\t{{artist}}\t{{title}}"

    def __init__(self, guy):
        self.guy = guy
        self.now = None            # {"player", "status", "artist", "title"}
        self.announce = 0.0        # until then, show the next track change even when paused (after "next")
        if not shutil.which("playerctl"):
            return
        try:
            self.proc = subprocess.Popen(["playerctl", "--follow", "metadata", "--format", self.FORMAT],
                                         stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,
                                         start_new_session=True)
        except OSError:
            return
        threading.Thread(target=self.read, daemon=True).start()

    def read(self):
        for line in self.proc.stdout:
            GLib.idle_add(self.changed, line.rstrip("\n"))

    def changed(self, line):
        fields = line.split("\t")
        if len(fields) < 4 or not fields[3]:
            self.now = None
            self.guy.remove_activity("media")
            return False
        before = self.now
        self.now = dict(zip(("player", "status", "artist", "title"), fields[:4]))
        playing = self.now["status"] == "Playing"
        act = self.guy.set_activity("media", "media", self.now["title"],
                                    "media-playback-start-symbolic" if playing else "media-playback-pause-symbolic",
                                    detail=self.now["artist"] or self.now["player"])
        act.state = "idle"         # shown in the list and popped on changes, never keeps the pill out
        new_track = before is None or before["title"] != self.now["title"]
        asked = new_track and time.monotonic() < self.announce
        if asked or (playing and (new_track or before["status"] != "Playing")):
            self.announce = 0.0
            self.guy.pop(act, 4.0)
        else:
            self.guy.apply()
        return False


PKG_TOOLS = ("yay", "paru", "pacman", "pamac", "makepkg")


def scan_procs():
    """pid -> (comm, state, ppid, pgrp, tty_nr, tpgid, cpu ticks), from the world-readable /proc/*/stat."""
    procs = {}
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        try:
            with open(f"/proc/{d}/stat", "rb") as f:
                raw = f.read().decode(errors="replace")
        except OSError:
            continue
        r = raw.rfind(")")
        f = raw[r + 2:].split()
        procs[int(d)] = (raw[raw.find("(") + 1:r], f[0], int(f[1]), int(f[2]), int(f[4]), int(f[5]),
                         int(f[11]) + int(f[12]))
    return procs


def pts_path(tty_nr):
    major, minor = (tty_nr >> 8) & 0xFFF, (tty_nr & 0xFF) | ((tty_nr >> 12) & 0xFFF00)
    return f"/dev/pts/{minor + (major - 136) * 256}" if 136 <= major <= 143 else None


def echo_off(tty_nr):
    """True when the terminal has echo off but line input on: someone is being asked for a password.
    Only reads the terminal's settings, never what's typed; root-owned ptys (sudo use_pty) are skipped."""
    path = pts_path(tty_nr)
    if not path:
        return False
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOCTTY | os.O_NONBLOCK)
    except OSError:
        return False
    try:
        lflag = termios.tcgetattr(fd)[3]
    except termios.error:
        return False
    finally:
        os.close(fd)
    return not (lflag & termios.ECHO) and bool(lflag & termios.ICANON)


class PromptWatcher:
    """Notices yay / pacman / sudo sitting at a terminal waiting for you. A password prompt turns the
    terminal's echo off; a question ([Y/n], a provider number, yay's menus) leaves the package tool in
    the terminal's foreground, asleep, using no CPU at all for a few seconds. Checks /proc every 1.5 s,
    which costs a couple of milliseconds; it does nothing else until a package tool is running."""

    IDLE_POLLS = 3

    def __init__(self, guy):
        self.guy = guy
        self.last = None           # (tty, fg group, cpu) seen on the previous poll
        self.idle = 0
        GLib.timeout_add(1500, self.poll)

    def cmdline(self, pid):
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                return f.read().replace(b"\0", b" ").decode(errors="replace")
        except OSError:
            return ""

    def chain(self, pid, procs):
        seen = []
        while pid in procs and pid > 1 and len(seen) < 64:
            seen.append(pid)
            pid = procs[pid][2]
        return seen

    def is_tool(self, pid, p, procs):
        if p[0] in PKG_TOOLS:
            return True
        if p[0] == "sudo":
            return "pacman" in self.cmdline(pid) or any(procs[a][0] in PKG_TOOLS for a in self.chain(pid, procs)[1:])
        return False

    def outermost(self, pid, procs):
        names = [procs[a][0] for a in self.chain(pid, procs) if procs[a][0] in PKG_TOOLS]
        return names[-1] if names else "sudo"

    def poll(self):
        procs = scan_procs()
        tools = [pid for pid, p in procs.items() if self.is_tool(pid, p, procs)]
        found = None
        ttys = {}
        for pid in tools:
            p = procs[pid]
            if p[4] > 0 and p[5] > 0:
                ttys.setdefault(p[4], (pid, p[5]))
        for tty, (tool_pid, fg) in ttys.items():
            members = [(pid, q) for pid, q in procs.items() if q[3] == fg]
            if not members:
                continue
            asleep = all(q[1] == "S" for _pid, q in members)
            cpu = sum(q[6] for _pid, q in members)
            leader = procs.get(fg, members[0][1])[0]
            who = self.outermost(tool_pid, procs)
            if asleep and echo_off(tty):
                found = {"kind": "password", "pid": tool_pid,
                         "text": f"{who} needs your password" if leader == "sudo" else f"{leader} needs a password"}
                break
            key = (tty, fg, cpu)
            self.idle = self.idle + 1 if (asleep and key == self.last) else 0
            self.last = key
            quiet = time.monotonic() - self.guy.pacman.last_line > 3
            if self.idle >= self.IDLE_POLLS and quiet and (leader in PKG_TOOLS or leader == "sudo"):
                found = {"kind": "answer", "pid": tool_pid, "text": f"{who} is waiting for your answer"}
                break
        if not ttys:
            self.last, self.idle = None, 0
        self.guy.set_prompt(found)
        return True


