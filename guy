    # ----- what the island shows -----
    def active(self):
        # package runs don't keep the pill out; they pop it out at each step (see pop)
        return (self.prompt is not None or self.voice_state is not None
                or (self.claude_proc is not None and self.user_mode != "ask")
                or any(s.status == "waiting" for s in self.sessions.values())
                or any(a.state == "running" and a.kind != "update" for a in self.activities.values()))

    def compute_mode(self):
        if self.user_mode == "ask":
            return "ask"
        if self.dragging:
            return "drop"
        if self.approvals:
            return "approval"
        if self.user_mode == "home":
            return "home"
        now = time.monotonic()
        if self.hover or self.active() or now < self.flash_until or now < self.linger_until:
            return "peek"
        return "hidden"

    def mood(self):
        if self.voice_state == "listening":
            return "listening"
        if self.voice_state == "thinking":
            return "working"
        if self.approvals or self.prompt or any(x.status == "waiting" for x in self.sessions.values()):
            return "waiting"
        if time.monotonic() < self.flash_until:
            return self.flash_mood
        if any(a.state == "running" for a in self.activities.values()):
            return "working"
        return "idle"

    def apply(self):
        mode = self.compute_mode()
        self.refresh_pages(mode)
        isl = self.island
        if mode != self.mode:
            prev, self.mode = self.mode, mode
            if prev == "ask":
                self.leave_ask()
            if mode == "ask":
                self.enter_ask()
            if mode == "hidden":
                # keep the width and pull the glass straight up into the top edge
                self.pending = None
                isl.follow = False
                isl.tw, isl.th = isl.w, 0.0
                isl.vw = 0.0
            else:
                self.pending = mode
                isl.follow = False
                page = self.stack.get_child_by_name(mode)
                isl.tw = float(self.page_width(mode))
                isl.th = float(isl.page_height(page, isl.tw))
                if isl.h < 1:
                    # coming out of the edge: drop straight down at the final width
                    isl.w, isl.vw = isl.tw, 0.0
        elif mode == "peek":
            isl.tw = float(self.page_width("peek"))
            isl.queue_allocate()
        self.kick()
        return False

    def page_width(self, mode):
        if mode == "peek":
            nat = self.stack.get_child_by_name("peek").measure(Gtk.Orientation.HORIZONTAL, -1)[1]
            return max(170, min(460, nat))
        return WIDTHS[mode]

    def refresh_pages(self, mode):
        mood = self.mood()
        for f in self.faces:
            f.mood = mood
        if self.claude_proc is not None:
            self.ask_face.mood = "working"
        # peek
        waiting = self.approvals[0].session.name if self.approvals else None
        running = sorted((a for a in self.activities.values() if a.state == "running" and a.kind != "update"),
                         key=lambda a: -a.updated)
        if self.voice_state == "listening":
            words = self.voice_words
            text = f"“{words if len(words) <= 52 else '…' + words[-51:]}”" if words else "Listening…"
        elif self.voice_state == "thinking":
            words = self.voice_words
            text = f"“{words if len(words) <= 40 else '…' + words[-39:]}”  ·  thinking…" if words else "Thinking…"
        elif waiting:
            text = f"{waiting} needs you"
        elif self.claude_proc is not None and self.user_mode != "ask":
            text = "GUY is " + (self.agent_status.rstrip("…") + "…" if self.agent_status else "working…")
        elif self.prompt:
            text = f"{self.prompt['text']}  ·  click to answer"
        elif asking := [x for x in self.sessions.values() if x.status == "waiting"]:
            text = f"{asking[0].name}  ·  {asking[0].last}"
        elif time.monotonic() < self.flash_until:
            a = self.flash_act
            text = (a.title + (f"  ·  {a.detail}" if a.detail else "")) if a else self.flash_text
        elif running:
            text = running[0].title + (f"  ·  {running[0].detail}" if running[0].detail else "")
        else:
            text = "Ask GUY  ·  Alt+Space"
        self.peek_label.set_label(text)
        in_panel = self.user_mode == "ask" and self.voice_state is not None
        self.ask_voice.set_visible(in_panel)
        if in_panel:
            words = self.voice_words
            self.ask_voice.set_label(("🎙  Listening…" if self.voice_state == "listening" else "🎙  Thinking…")
                                     + (f"   “{words}”" if words else ""))
        self.mic_button.set_visible(self.voice_wake is not None)
        self.mic_button.set_label("🎙  Hey GUY: on" if self.voice_wake else "🎙  Hey GUY: off")
        if mode == "home":
            self.refresh_home()
        self.refresh_approval()

    def refresh_home(self):
        """The overview's rows, rebuilt from scratch: only while it's on screen (apply() runs on every
        download tick, pacman line and voice partial, and nobody sees these rows then), and only when
        what they show has changed, so a row isn't swapped out from under a click."""
        sessions = sorted(self.sessions.values(), key=lambda s: -s.updated)[:3]
        acts = sorted(self.activities.values(), key=lambda a: (a.state != "running", -a.updated))[:3]
        updates = self.updates if self.updates and self.updates[0] else None
        schedule = sorted(self.schedule, key=lambda i: i.get("at", ""))[:3]
        playing = self.media.now and self.media.now["status"] == "Playing"
        shown = (self.prompt, self.home_expanded, updates, playing,
                 [(s.id, s.status, s.last, bool(s.reply), age(s.updated)) for s in sessions],
                 [(a.key, a.state, a.title, a.detail, a.progress, bool(a.open), bool(getattr(a, "reply", None)),
                   age(a.updated)) for a in acts],
                 [(i.get("id"), i.get("at"), i.get("text"), i.get("every"), i.get("last_at")) for i in schedule])
        if shown == self.home_shown:
            return
        self.home_shown = shown
        while (child := self.session_box.get_first_child()) is not None:
            self.session_box.remove(child)
        if self.prompt:
            icon = Gtk.Image.new_from_icon_name("dialog-password-symbolic" if self.prompt["kind"] == "password"
                                                else "input-keyboard-symbolic")
            icon.add_css_class("aicon")
            self.add_row(icon, self.prompt["text"], "Click to go to the terminal", None, self.focus_prompt)
        if not (sessions or acts or updates or self.prompt or schedule):
            empty = Gtk.Label(xalign=0, wrap=True, max_width_chars=60,
                              label="Nothing running. Drop a file on me, or press Alt+Space and ask me anything.")
            empty.add_css_class("empty")
            self.session_box.append(empty)
        for s in sessions:
            dot = Gtk.Box(valign=Gtk.Align.CENTER)
            dot.add_css_class("dot")
            dot.add_css_class(s.status)
            click = (lambda s=s: self.show_reply(s)) if s.reply else None
            more = [("Folder", s.cwd.replace(str(HOME), "~", 1)), ("Now", s.last), ("Status", s.status)]
            self.add_row(dot, s.name, s.last, age(s.updated), click, key=f"session:{s.id}", more=more)
        for a in acts:
            icon = Gtk.Image.new_from_icon_name(a.icon)
            icon.add_css_class("aicon")
            click = (lambda a=a: self.open_activity(a)) if a.open else None
            if getattr(a, "reply", None):
                click = (lambda a=a: self.show_text(a.title, a.reply, f"What did the routine “{a.title}” report?"))
            trailing, when = None, age(a.updated)
            if a.kind == "media":
                trailing, when = Gtk.Box(spacing=4), None
                for icon_name, action in (("media-skip-backward-symbolic", "previous"),
                                          ("media-playback-pause-symbolic" if playing else "media-playback-start-symbolic",
                                           "play-pause"),
                                          ("media-skip-forward-symbolic", "next")):
                    b = Gtk.Button(icon_name=icon_name)
                    b.add_css_class("action")
                    b.add_css_class("small")
                    b.connect("clicked", lambda _b, x=action: self.do_intent(x, None, quiet=True))
                    trailing.append(b)
            elif a.kind == "timer" and a.state == "running":
                trailing, when = self.small_button("Cancel", lambda k=a.key: self.remove_activity(k)), None
            more = [("", a.title), ("", a.detail),
                    ("Status", {"running": "working on it…", "done": "done", "error": "failed"}.get(a.state, a.state))]
            self.add_row(icon, a.title, a.detail, when, click, a.progress, trailing, key=f"act:{a.key}", more=more)
        for item in schedule:
            routine = item.get("kind") == "task"
            icon = Gtk.Image.new_from_icon_name("view-calendar-symbolic" if routine else "alarm-symbolic")
            icon.add_css_class("aicon")
            when = item.get("at", "").replace("T", " ")[5:16]
            every = f"  ·  every {item['every']}" if item.get("every") else ""
            buttons = [("Cancel", lambda i=item.get("id"): self.unschedule(i))]
            if routine:
                buttons.insert(0, ("Run now", lambda i=item: self.run_task(i)))
            if item.get("last_result"):
                buttons.insert(0, ("Last result", lambda i=item: self.show_text(
                    first_line(i.get("text", "Routine"), 40), i["last_result"],
                    f"What did the routine “{i.get('text', '')}” report?")))
            more = [("", item.get("text", "")),
                    ("Next", self.when_text(item.get("at", "")) + every),
                    ("Kind", "a routine GUY does for you" if routine else "a reminder"),
                    ("Last run", self.when_text(item.get("last_at", "")) if item.get("last_at") else "not yet")]
            self.add_row(icon, item.get("text", ""), when + every, None, None, None,
                         self.small_button("Cancel", buttons[-1][1]), key=f"sched:{item.get('id')}",
                         more=more, buttons=buttons[:-1])
        if updates:
            icon = Gtk.Image.new_from_icon_name("system-software-update-symbolic")
            icon.add_css_class("aicon")
            noun = "update" if updates[0] == 1 else "updates"
            self.add_row(icon, f"{updates[0]} {noun} available", updates[1], None, None, None,
                         self.small_button("Update", self.run_update), key="updates",
                         more=[("", updates[1]), ("", "Update opens kitty running yay -Syu")])

    def small_button(self, label, fn):
        b = Gtk.Button(label=label)
        b.add_css_class("action")
        b.add_css_class("small")
        b.connect("clicked", lambda *_: fn())
        return b

    @staticmethod
    def when_text(iso):
        import datetime as dt
        try:
            return dt.datetime.fromisoformat(iso).strftime("%a %-d %b, %H:%M")
        except ValueError:
            return iso

    def toggle_expanded(self, key):
        self.home_expanded = None if self.home_expanded == key else key
        self.apply()

    def refresh_approval(self):
        # on the island, or in the Ask panel when that's open and it's GUY's own assistant asking
        agent = self.agent_approval()
        self.ask_ap.set_visible(agent is not None and self.user_mode == "ask")
        if agent is not None:
            self.ask_ap_title.set_label(f"GUY wants to {agent.risk}")
            self.ask_ap_detail.set_label(tool_detail(agent.tool, agent.input))
        if self.approvals:
            a = self.approvals[0]
            verb = {"Bash": "run a command", "Edit": "edit a file", "MultiEdit": "edit a file",
                    "Write": "write a file", "WebFetch": "fetch a page"}.get(a.tool, f"use {a.tool}")
            if a.agent:
                verb = a.risk
            self.ap_title.set_label(f"{a.session.name} wants to {verb}")
            self.ap_detail.set_label(tool_detail(a.tool, a.input))
            more = len(self.approvals) - 1
            self.ap_more.set_label(f"{more} more waiting" if more else "")

    def add_row(self, lead, title, detail, when, click=None, progress=None, trailing=None,
                key=None, more=None, buttons=()):
        """One row of the overview. A row with something to open opens it; any other row with a key
        expands in place to show everything about it (the full text, `more`, and its `buttons`)."""
        expanded = key is not None and self.home_expanded == key
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        outer.add_css_class("session")
        row = Gtk.Box(spacing=10)
        outer.append(row)
        hit = Gtk.Box(spacing=10, hexpand=True)  # what a click lands on: not the row's own buttons
        row.append(hit)
        hit.append(lead)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, hexpand=True, valign=Gtk.Align.CENTER)
        line = Gtk.Box(spacing=10)
        name = Gtk.Label(label=title, xalign=0, ellipsize=Pango.EllipsizeMode.END, max_width_chars=34)
        name.add_css_class("sname")
        line.append(name)
        last = Gtk.Label(label=detail, xalign=0, hexpand=True, ellipsize=Pango.EllipsizeMode.END)
        last.add_css_class("slast")
        line.append(last)
        text.append(line)
        if progress is not None:
            bar = Gtk.ProgressBar(fraction=max(0.0, min(1.0, progress)))
            text.append(bar)
        hit.append(text)
        if when:
            label = Gtk.Label(label=when)
            label.add_css_class("sage")
            hit.append(label)
        if click is None and key is not None and (more or buttons):
            click = lambda: self.toggle_expanded(key)          # noqa: E731
            chevron = Gtk.Image.new_from_icon_name("pan-up-symbolic" if expanded else "pan-down-symbolic")
            chevron.add_css_class("dim")
            hit.append(chevron)
        if trailing:
            row.append(trailing)
        if expanded:
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            box.add_css_class("more")
            for label, value in more or ():
                if not value:
                    continue
                v = Gtk.Label(xalign=0, wrap=True, wrap_mode=Pango.WrapMode.WORD_CHAR, selectable=True,
                              max_width_chars=80)
                v.set_markup((f"<b>{GLib.markup_escape_text(label)}</b>  " if label else "")
                             + GLib.markup_escape_text(str(value)))
                v.set_focusable(False)
                box.append(v)
            if buttons:
                brow = Gtk.Box(spacing=6, margin_top=4)
                for blabel, fn in buttons:
                    brow.append(self.small_button(blabel, fn))
                box.append(brow)
            outer.append(box)
