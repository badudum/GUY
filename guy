class MailWatcher:
    """Unread mail in each account of ~/.config/guy/mail.json, checked every 5 minutes in the background
    and when the overview opens on a stale check. Mail that arrived since the last check pops the pill
    out with a chime. {"search": "..."} in the file changes which mail counts (any Gmail search).

    Each account also keeps one connection waiting in IMAP IDLE, so Gmail says the moment anything lands
    in the inbox (any tab, not just Primary), and the new mail is announced straight from that connection.
    It's read here, never sent anywhere, for a verification code, which GUY copies and types into the
    browser (Guy.use_code). {"codes": false} switches that off, {"autofill": false} just the typing."""

    def __init__(self, guy):
        self.guy = guy
        self.boxes = []            # [{"address", "label", "unread", "items", "error"}], in the file's order
        self.seen = {}             # address -> uids already shown; missing until its first check
        self.fetched = 0.0
        self.busy = False
        self.again = False         # a refresh was asked for while one was running
        self.code = None           # the newest code found: {"code", "sender", "address", "at"}
        self.push_gen = 0          # bumped to retire the IDLE threads when the accounts change
        self.cursor = {}           # address -> (UIDVALIDITY, the next UID to look at), kept across reconnects
        GLib.timeout_add_seconds(20, lambda: self.refresh() and False)
        GLib.timeout_add_seconds(MAIL_EVERY, self.refresh)
        GLib.timeout_add_seconds(8, self.start_push)
        try:                       # back from sleep: the IDLE connections are dead, so start fresh ones
            Gio.bus_get_sync(Gio.BusType.SYSTEM).signal_subscribe(
                "org.freedesktop.login1", "org.freedesktop.login1.Manager", "PrepareForSleep",
                "/org/freedesktop/login1", None, Gio.DBusSignalFlags.NONE,
                lambda *a: a[5].unpack()[0] or GLib.timeout_add_seconds(3, self.start_push))
        except GLib.Error:
            pass

    def stale(self):
        return time.time() - self.fetched > MAIL_EVERY

    def refresh(self):
        if self.busy:
            self.again = True
            return True
        accounts, cfg = mail_accounts()
        if not accounts:
            if self.boxes:
                self.boxes = []
                self.guy.apply()
            return True
        self.busy = True
        search, count = cfg.get("search", MAIL_SEARCH), int(cfg.get("count", MAIL_COUNT))

        labels = mail_labels(accounts)

        def work():
            boxes = []
            for a in accounts:
                box = {"address": a["address"], "label": labels[a["address"]], "unread": 0, "items": [], "error": None}
                try:
                    password = mail_password(a["address"])
                    if password:
                        box["unread"], box["items"] = fetch_mail(a["address"], password, search, count)
                    else:
                        box["error"] = "no password in the keyring: run guy --add-mail " + a["address"]
                except Exception as e:  # noqa: BLE001 - one account failing doesn't stop the others
                    box["error"] = mail_error(e)
                boxes.append(box)
            GLib.idle_add(self.got, boxes)

        threading.Thread(target=work, daemon=True).start()
        return True

    def got(self, boxes):
        self.busy = False
        old = {b["address"]: b for b in self.boxes}
        fresh = []
        for b in boxes:
            if b["error"]:                     # offline, say: keep what was there, with the reason
                if b["address"] in old:
                    b["unread"], b["items"] = old[b["address"]]["unread"], old[b["address"]]["items"]
                continue
            uids = {m["uid"] for m in b["items"]}
            if b["address"] in self.seen:
                fresh += [(b, m) for m in b["items"] if m["uid"] not in self.seen[b["address"]]]
            self.seen[b["address"]] = self.seen.get(b["address"], set()) | uids
        self.boxes = boxes
        self.fetched = time.time()
        if fresh:
            self.announce(fresh)
        else:
            self.guy.apply()
        if self.again:
            self.again = False
            self.refresh()
        return False

    def announce(self, fresh):
        """Chime, and show the newest of [(box, message)] at the top."""
        b, m = max(fresh, key=lambda x: x[1]["when"])
        more = f"  ·  +{len(fresh) - 1} more" if len(fresh) > 1 else ""
        where = f"{b['label']}  ·  " if len(self.boxes) > 1 else ""
        self.guy.chime()
        if time.time() - (self.code or {}).get("at", 0) > 15:   # the code's notice stays up
            self.guy.flash(f"✉ {where}{m['sender']}: {m['subject']}{more}", "done", 6)
        else:
            self.guy.apply()

    def arrived(self, address, items):
        """New mail matching the search, seen by an IDLE connection: shown now, without waiting for a check."""
        seen = self.seen.get(address)          # missing before the first check, which then counts these as seen
        items = [m for m in items if seen is None or m["uid"] not in seen]
        if not items:
            return False
        if seen is not None:
            seen.update(m["uid"] for m in items)
        box = next((b for b in self.boxes if b["address"] == address), None)
        if box is None:
            box = {"address": address, "label": mail_labels(mail_accounts()[0]).get(address, address),
                   "unread": 0, "items": [], "error": None}
            self.boxes.append(box)
        box["items"] = sorted(items + box["items"], key=lambda x: -x["when"])
        box["unread"] += len(items)
        self.announce([(box, m) for m in items])
        return False

    # ----- push: new mail the moment it arrives -----
    def start_push(self):
        self.push_gen += 1
        for a in mail_accounts()[0]:
            threading.Thread(target=self.push, args=(a["address"], self.push_gen), daemon=True).start()
        return False

    def push(self, address, gen):
        import imaplib
        wait = 5
        while gen == self.push_gen:
            try:
                password = mail_password(address)
                if not password:
                    return
                with imaplib.IMAP4_SSL(MAIL_HOST, timeout=30) as m:
                    m.login(address, password)
                    m.select("INBOX", readonly=True)
                    _t, data = m.response("UIDVALIDITY")
                    validity = data[0] if data else None
                    _t, data = m.response("UIDNEXT")
                    top = int(data[0]) if data and data[0] else 0
                    known, nxt = self.cursor.get(address, (None, 0))
                    if known != validity or not nxt:
                        nxt = top                # first time: from now on
                    elif top > nxt:
                        nxt = self.check_new(m, address, nxt)    # what came while it was away
                    self.cursor[address] = (validity, nxt)
                    wait = 5
                    while gen == self.push_gen:
                        _t, data = m.response("EXISTS")     # mail that came while it was busy with the last
                        news = bool(data and data[0])
                        # short rounds: each ends with a round trip, so a connection that died quietly
                        # (a new network, say) is noticed within IDLE_EVERY rather than Gmail's 10 minutes
                        if not news:
                            with m.idle(duration=IDLE_EVERY) as idler:
                                for typ, _data in idler:
                                    if typ == "EXISTS":
                                        news = True
                                        break
                        if news and gen == self.push_gen:
                            nxt = self.check_new(m, address, nxt)
                            self.cursor[address] = (validity, nxt)
            except Exception:  # noqa: BLE001 - offline, asleep, password changed: wait, then try again
                pass
            if gen != self.push_gen:
                return
            time.sleep(wait)
            wait = min(wait * 2, 300)

    def check_new(self, m, address, nxt):
        """Announce the mail with UIDs from `nxt` on, and look in it for a code; returns the next UID to look from."""
        _t, data = m.uid("SEARCH", None, f"UID {max(nxt, 1)}:*")
        uids = [int(u) for u in (data[0].split() if data and data[0] else []) if int(u) >= nxt]
        if not uids:
            return nxt
        cfg = mail_accounts()[1]
        if cfg.get("codes", True) is not False:
            self.find_codes(m, address, uids)
        self.match_new(m, address, uids, cfg.get("search", MAIL_SEARCH))
        GLib.idle_add(lambda: self.refresh() and False)     # the exact counts, in the background
        return max(uids) + 1

    def match_new(self, m, address, uids, search):
        """Which of these new UIDs the search takes in, announced as they're found. Gmail's search can lag
        a few seconds behind the inbox, so the rest are asked about again before giving up on them."""
        left = set(uids)
        for delay in (0, 2, 4, 8):
            time.sleep(delay)
            spec = ",".join(map(str, sorted(left)))
            _t, data = m.uid("SEARCH", None, "UID", spec, "X-GM-RAW", mail_query(search, False))
            hits = {int(u) for u in (data[0].split() if data and data[0] else [])} & left
            if hits:
                GLib.idle_add(self.arrived, address, mail_headers(m, address, sorted(hits)))
                left -= hits
            if not left:
                return

    def find_codes(self, m, address, uids):
        import email
        import email.policy
        import email.utils
        import imaplib
        _t, data = m.uid("FETCH", ",".join(map(str, uids)), "(INTERNALDATE RFC822.SIZE)")
        fresh = []
        for p in data:
            meta = p if isinstance(p, bytes) else p[0] if p else b""
            uid, size = re.search(rb"UID (\d+)", meta), re.search(rb"RFC822\.SIZE (\d+)", meta)
            got = imaplib.Internaldate2tuple(meta)
            if uid and not ((size and int(size.group(1)) > 2_000_000) or (got and time.time() - time.mktime(got) > 600)):
                fresh.append(uid.group(1).decode())      # not attachment-sized, and not an old one moved in
        for uid in reversed(fresh):                      # the newest first
            _t, data = m.uid("FETCH", uid, "(BODY.PEEK[])")
            part = next((p for p in data if isinstance(p, tuple)), None)
            if not part:
                continue
            msg = email.message_from_bytes(part[1], policy=email.policy.default)
            code = find_code(str(msg["Subject"] or ""), message_text(msg))
            if code:
                name, addr = email.utils.parseaddr(str(msg["From"] or ""))
                GLib.idle_add(self.found, {"code": code, "sender": name or addr, "address": address,
                                           "at": time.time()})
                return

    def found(self, c):
        if not (self.code and self.code["code"] == c["code"] and c["at"] - self.code["at"] < 120):
            self.code = c
            self.guy.use_code(c, fill=mail_accounts()[1].get("autofill", True) is not False)
        return False

    def lookup_code(self):
        """guy --code / Ask GUY: the newest code from the last 15 minutes, from memory or from each inbox."""
        if self.code and time.time() - self.code["at"] < 900:
            self.guy.use_code(self.code)
            return
        self.guy.flash("Looking for a verification code…", "working", 20)

        def work():
            for a in mail_accounts()[0]:
                try:
                    hit = recent_code(a["address"], mail_password(a["address"]) or "")
                except Exception:  # noqa: BLE001 - try the next account
                    continue
                if hit:
                    self.code = {"code": hit[0], "sender": hit[1], "address": a["address"], "at": hit[2]}
                    GLib.idle_add(lambda: self.guy.use_code(self.code) and False)
                    return
            GLib.idle_add(lambda: self.guy.flash("No verification code in your mail from the last 15 minutes",
                                                 "error", 5) and False)

        threading.Thread(target=work, daemon=True).start()


# ---------- texts from an iPhone, over Bluetooth ----------
PHONE_CONFIG = Path.home() / ".config/guy/phone.json"
PHONE_RETRY = 60                  # seconds between tries to reach the phone, at first
PHONE_RETRY_MAX = 600             # backing off to this while it stays away (each try pages the radio)
PHONE_KEEP = 30                   # messages kept for the overview
MAS_UUID = "00001132-0000-1000-8000-00805f9b34fb"     # Bluetooth Message Access, on the phone


def parse_bmessage(b):
    """(text, sender's name, sender's number) from a MAP bMessage."""
    text = "\n".join(re.findall(r"BEGIN:MSG\r?\n(.*?)\r?\nEND:MSG", b, re.S)).strip()
    card = b.split("BEGIN:BENV")[0]                 # the originator's vCard comes before the envelope
    name = re.search(r"^FN[^:]*:(.*)$", card, re.M)
    if not (name and name.group(1).strip()):
        name = re.search(r"^N[^:]*:(.*)$", card, re.M)
    tel = re.search(r"^TEL[^:]*:(.*)$", card, re.M)
    name = " ".join(x for x in reversed((name.group(1) if name else "").strip().split(";")[:2]) if x).strip() \
        if name and ";" in name.group(1) else (name.group(1).strip() if name else "")
    return text, name, tel.group(1).strip() if tel else ""


class PhoneWatcher:
    """New texts and iMessages from a paired iPhone, over Bluetooth Message Access: the way a car reads
    your messages out. Needs the phone paired with this computer and "Show Notifications" switched on for it
    (iPhone: Settings > Bluetooth > ⓘ). GUY reaches for it while it's away (every minute, backing off to every
    10), downloads each new
    message on this computer (never sends it anywhere), pops it up at the top, and copies and types in
    verification codes the same way as from mail. ~/.config/guy/phone.json: {"address": "AA:BB:..."} picks
    the phone when several are paired, {"phone": false} switches it off."""

    def __init__(self, guy):
        self.guy = guy
        self.name = None           # the phone's name while connected
        self.session = None        # obexd's MAP session
        self.connecting = False
        self.next_try = 0.0        # monotonic time of the next try while the phone is away
        self.wait = PHONE_RETRY
        self.messages = []         # [{"when", "sender", "text"}], newest first
        self.tmp = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}") / "guy-phone"
        try:
            self.system = Gio.bus_get_sync(Gio.BusType.SYSTEM)
            self.bus = Gio.bus_get_sync(Gio.BusType.SESSION)
        except GLib.Error:
            return
        self.bus.signal_subscribe("org.bluez.obex", "org.freedesktop.DBus.ObjectManager", None, None, None,
                                  Gio.DBusSignalFlags.NONE, self.on_obex)
        GLib.timeout_add_seconds(6, lambda: self.connect() and False)
        GLib.timeout_add_seconds(PHONE_RETRY, self.connect)

    @staticmethod
    def config():
        try:
            return json.loads(PHONE_CONFIG.read_text())
        except (OSError, ValueError):
            return {}

    def find_phone(self):
        """(address, name) of a paired phone offering Message Access, or None."""
        cfg = self.config()
        try:
            objs = self.system.call_sync("org.bluez", "/", "org.freedesktop.DBus.ObjectManager", "GetManagedObjects",
                                         None, None, Gio.DBusCallFlags.NONE, 5000, None).unpack()[0]
        except GLib.Error:
            return None
        for ifaces in objs.values():
            d = ifaces.get("org.bluez.Device1")
            if d and d.get("Paired") and MAS_UUID in (d.get("UUIDs") or []) \
                    and cfg.get("address", d.get("Address")).upper() == d.get("Address", "").upper():
                return d["Address"], d.get("Alias") or d.get("Name") or "iPhone"
        return None

    def connect(self):
        if self.session or self.connecting or self.config().get("phone", True) is False \
                or time.monotonic() < self.next_try:
            return True
        phone = self.find_phone()
        if not phone:
            return True
        self.connecting = True

        def done(bus, res):
            self.connecting = False
            try:
                self.session = bus.call_finish(res).unpack()[0]
                self.name = phone[1]
                self.wait = PHONE_RETRY
                self.guy.apply()
            except GLib.Error:                   # out of range, or asleep: try again later, less often
                self.next_try = time.monotonic() + self.wait
                self.wait = min(self.wait * 2, PHONE_RETRY_MAX)

        self.bus.call("org.bluez.obex", "/org/bluez/obex", "org.bluez.obex.Client1", "CreateSession",
                      GLib.Variant("(sa{sv})", (phone[0], {"Target": GLib.Variant("s", "map")})), None,
                      Gio.DBusCallFlags.NONE, 60000, None, done)
        return True

    def on_obex(self, _c, _sender, _path, _iface, signal, params):
        if signal == "InterfacesRemoved":
            path, _ifaces = params.unpack()
            if path == self.session:             # the phone went away
                self.session = self.name = None
                self.next_try, self.wait = 0.0, PHONE_RETRY
                self.guy.apply()
            return
        if signal != "InterfacesAdded":
            return
        path, ifaces = params.unpack()
        m = ifaces.get("org.bluez.obex.Message1")
        if m is None or not str(m.get("Folder", "")).endswith("inbox") or not path.startswith(str(self.session)):
            return
        self.fetch(path, m)

    def fetch(self, path, m):
        """Download the message into a private folder in /run, read it, and delete it."""
        self.tmp.mkdir(mode=0o700, exist_ok=True)
        target = self.tmp / path.rsplit("/", 1)[-1]

        def got(bus, res):
            try:
                transfer = bus.call_finish(res).unpack()[0]
            except GLib.Error:
                return
            GLib.timeout_add(250, self.read, transfer, target, m, time.monotonic())

        self.bus.call("org.bluez.obex", path, "org.bluez.obex.Message1", "Get",
                      GLib.Variant("(sb)", (str(target), False)), None, Gio.DBusCallFlags.NONE, 30000, None, got)

    def read(self, transfer, target, m, started):
        try:
            status = self.bus.call_sync("org.bluez.obex", transfer, "org.freedesktop.DBus.Properties", "Get",
                                        GLib.Variant("(ss)", ("org.bluez.obex.Transfer1", "Status")), None,
                                        Gio.DBusCallFlags.NONE, 2000, None).unpack()[0]
        except GLib.Error:
            status = "complete"                  # the transfer is gone once it's finished
        if status in ("queued", "active") and time.monotonic() - started < 30:
            return True
        try:
            text, name, number = parse_bmessage(target.read_text(encoding="utf-8", errors="replace"))
            target.unlink()
        except OSError:
            text, name, number = str(m.get("Subject") or ""), "", ""
        sender = name or m.get("SenderName") or number or m.get("Sender") or "Someone"
        self.got(sender, text)
        return False

    def got(self, sender, text):
        self.messages = ([{"when": time.time(), "sender": sender, "text": text}] + self.messages)[:PHONE_KEEP]
        code = find_code("", text)
        if code:
            c = {"code": code, "sender": sender, "address": None, "to": "iPhone", "at": time.time()}
            self.guy.mail.code = c               # so guy --code and Ask GUY "code" find it too
            self.guy.use_code(c, fill=mail_accounts()[1].get("autofill", True) is not False)
        else:
            self.guy.chime()
            self.guy.flash(f"💬 {sender}: {' '.join(text.split()) or 'sent you a message'}", "done", 8)


