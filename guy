NEWS_FEEDS = ["https://www.cbc.ca/webfeed/rss/rss-topstories", "https://feeds.bbci.co.uk/news/world/rss.xml"]
NEWS_EVERY = 1800                 # seconds between fetches
NEWS_COUNT = 6


def parse_feed(data, source):
    """Headlines from an RSS or Atom feed: [(published, title, link, source)]."""
    import email.utils
    import xml.etree.ElementTree as ET
    out = []
    root = ET.fromstring(data)
    for el in root.iter():
        tag = el.tag.rsplit("}", 1)[-1]
        if tag not in ("item", "entry"):
            continue
        fields = {c.tag.rsplit("}", 1)[-1]: c for c in el}
        title = (fields["title"].text or "").strip() if "title" in fields else ""
        link = fields.get("link")
        link = ((link.text or "").strip() or link.get("href", "")) if link is not None else ""
        when = 0.0
        for k in ("pubDate", "published", "updated"):
            if k in fields and fields[k].text:
                try:
                    when = email.utils.parsedate_to_datetime(fields[k].text).timestamp()
                except (TypeError, ValueError):
                    try:
                        import datetime as dt
                        when = dt.datetime.fromisoformat(fields[k].text.strip().replace("Z", "+00:00")).timestamp()
                    except ValueError:
                        pass
                break
        if title and link:
            out.append((when, title, link, source))
    return out


class NewsWatcher:
    """The latest headlines from a few RSS feeds (CBC and BBC World unless ~/.config/guy/news.json says
    {"feeds": [...], "count": 6}), fetched every half hour in the background and when the overview
    opens on stale ones. Nothing is fetched with news switched off ({"feeds": []})."""

    def __init__(self, guy):
        self.guy = guy
        self.items = []            # [(published, title, link, source)], newest first
        self.fetched = 0.0
        self.busy = False
        GLib.timeout_add_seconds(15, lambda: self.refresh() and False)
        GLib.timeout_add_seconds(NEWS_EVERY, self.refresh)

    @staticmethod
    def config():
        try:
            cfg = json.loads(NEWS_CONFIG.read_text())
        except (OSError, ValueError):
            cfg = {}
        return list(cfg.get("feeds", NEWS_FEEDS)), int(cfg.get("count", NEWS_COUNT))

    def stale(self):
        return time.time() - self.fetched > NEWS_EVERY

    def refresh(self):
        if self.busy:
            return True
        feeds, count = self.config()
        if not feeds:
            self.items = []
            return True
        self.busy = True

        def work():
            import urllib.request
            items = []
            for url in feeds:
                source = urllib.parse.urlparse(url).hostname or url
                source = re.sub(r"^(www|feeds|rss)\.", "", source).split(".")[0]
                source = {"bbci": "BBC", "theguardian": "Guardian"}.get(source, source.upper())
                try:
                    req = urllib.request.Request(url, headers={"User-Agent": "GUY/1.0"})
                    with urllib.request.urlopen(req, timeout=10) as r:
                        items += parse_feed(r.read(), source)
                except Exception:  # noqa: BLE001 - a feed that's down just doesn't show
                    continue
            GLib.idle_add(self.got, items, count)

        threading.Thread(target=work, daemon=True).start()
        return True

    def got(self, items, count):
        self.busy = False
        if items:                              # offline: keep the old headlines rather than none
            seen, fresh = set(), []
            for it in sorted(items, key=lambda i: -i[0]):
                k = it[1].lower()
                if k not in seen:
                    seen.add(k)
                    fresh.append(it)
            self.items = fresh[:count]
            self.fetched = time.time()
            self.guy.apply()
        return False


