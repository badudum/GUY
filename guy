#!/usr/bin/env python3
import os
import sys



def _send(message, sock="guy.sock"):
    """Hand a command to the running GUY (or guy-voice) over its socket (OSError when it isn't running)."""
    import json
    import socket
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.settimeout(0.3)
        s.connect(os.path.join(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}", sock))
        s.sendall((json.dumps(message) + "\n").encode())


# Alt+Space fast path: a running GUY takes "--ask" over its socket, skipping the ~270 ms of loading
# GTK just to forward one command. Falls through to the normal start when GUY isn't running.
if sys.argv[1:] in (["--ask"], ["--home"], ["--float"]):
    try:
        _send({"guy_command": sys.argv[1][2:]})
        sys.exit(0)
    except OSError:
        pass

# Voice: Super+Space runs `guy --listen`; `guy --voice on|off|toggle` switches "Hey GUY" listening
if sys.argv[1:2] in (["--listen"], ["--voice"]):
    _msg = {"listen": True} if sys.argv[1] == "--listen" else \
        {"wake": {"on": True, "off": False}.get((sys.argv[2:3] or ["toggle"])[0], "toggle")}
    try:
        _send(_msg, "guy-voice.sock")
    except OSError:
        print("guy: guy-voice isn't running", file=sys.stderr)
        sys.exit(1)
    sys.exit(0)

# Dress him by hand (otherwise he dresses for the weather outside): guy --outfit rain|sunny|cold|plain|auto
if sys.argv[1:2] == ["--outfit"]:
    try:
        _send({"guy_command": "outfit", "outfit": (sys.argv[2:3] or ["auto"])[0]})
    except OSError:
        print("guy: GUY isn't running", file=sys.stderr)
        sys.exit(1)
    sys.exit(0)

# Reminders and routines, for you and for GUY's assistant (which sets them by running these):
#   guy --remind "17:00" "call mom" [--every daily|weekdays|weekly|hourly]
#   guy --task "08:30" "give me a morning brief: weather, calendar, news" --every weekdays
#   guy --schedule          list them        guy --unschedule ID
# WHEN is "YYYY-MM-DD HH:MM", "HH:MM" / "5pm" (the next time it comes round), "tomorrow 9:00" or "+25m".
SCHEDULE_FILE = os.path.join(os.path.expanduser("~"), ".local/share/guy/schedule.json")
EVERY = ("daily", "weekdays", "weekly", "hourly")


def load_schedule():
    import json
    try:
        with open(SCHEDULE_FILE) as f:
            items = json.load(f)
        return items if isinstance(items, list) else []
    except (OSError, ValueError):
        return []


def save_schedule(items):
    import json
    os.makedirs(os.path.dirname(SCHEDULE_FILE), exist_ok=True)
    with open(SCHEDULE_FILE + ".tmp", "w") as f:
        json.dump(items, f, indent=1)
    os.replace(SCHEDULE_FILE + ".tmp", SCHEDULE_FILE)


def parse_when(when):
    """The next datetime `when` describes; ValueError if it doesn't describe one."""
    import datetime as dt
    import re
    w = re.sub(r"\s+", " ", when.strip().lower()).replace(".", "")
    now = dt.datetime.now().replace(second=0, microsecond=0)
    if m := re.fullmatch(r"(?:in |\+)(\d+) ?(m|mins?|minutes?|h|hrs?|hours?|d|days?)", w):
        n, unit = int(m[1]), m[2][0]
        return now + dt.timedelta(minutes=n * {"m": 1, "h": 60, "d": 1440}[unit])
    day = None
    if w.startswith("tomorrow"):
        day, w = now.date() + dt.timedelta(days=1), w[len("tomorrow"):].strip().removeprefix("at ").strip()
    elif w.startswith("today"):
        day, w = now.date(), w[len("today"):].strip().removeprefix("at ").strip()
    if m := re.fullmatch(r"(\d{1,2})(?::(\d{2}))? ?(am|pm)?", w):
        h, mi = int(m[1]), int(m[2] or 0)
        if m[3] == "pm" and h < 12:
            h += 12
        if m[3] == "am" and h == 12:
            h = 0
        if not m[2] and not m[3]:
            raise ValueError(f"not a time: {when!r} (say 17:00 or 5pm)")
        t = dt.datetime.combine(day or now.date(), dt.time(h, mi))
        return t if day or t > now else t + dt.timedelta(days=1)
    return dt.datetime.fromisoformat(w.upper().replace(" ", "T") if "-" in w else w)


def next_run(at, every):
    import datetime as dt
    step = {"daily": dt.timedelta(days=1), "weekdays": dt.timedelta(days=1), "weekly": dt.timedelta(weeks=1),
            "hourly": dt.timedelta(hours=1)}[every]
    at += step
    while every == "weekdays" and at.weekday() >= 5:
        at += dt.timedelta(days=1)
    return at


if sys.argv[1:2] in (["--remind"], ["--task"], ["--schedule"], ["--unschedule"]):
    import argparse
    import datetime as _dt
    _cmd = sys.argv[1][2:]
    _items = load_schedule()
    if _cmd == "schedule":
        for _i in sorted(_items, key=lambda i: i["at"]):
            print(f"#{_i['id']}  {_i['kind']:6}  {_i['at'].replace('T', ' ')[:16]}"
                  f"{'  every ' + _i['every'] if _i.get('every') else ''}  {_i['text']}")
        if not _items:
            print("Nothing scheduled.")
        sys.exit(0)
    if _cmd == "unschedule":
        _ids = {a.lstrip("#") for a in sys.argv[2:]}
        _left = [i for i in _items if str(i["id"]) not in _ids]
        save_schedule(_left)
        print(f"Removed {len(_items) - len(_left)}.")
    else:
        _ap = argparse.ArgumentParser(prog=f"guy --{_cmd}")
        _ap.add_argument("when")
        _ap.add_argument("text", nargs="+")
        _ap.add_argument("--every", choices=EVERY)
        _a = _ap.parse_args(sys.argv[2:])
        try:
            _at = parse_when(_a.when)
        except ValueError as _e:
            print(f"guy: {_e}", file=sys.stderr)
            sys.exit(2)
        while _a.every == "weekdays" and _at.weekday() >= 5:
            _at += _dt.timedelta(days=1)
        _id = max([i["id"] for i in _items] + [0]) + 1
        _items.append({"id": _id, "kind": _cmd, "at": _at.isoformat(timespec="minutes"), "text": " ".join(_a.text),
                       "every": _a.every})
        save_schedule(_items)
        print(f"Scheduled #{_id}: {_cmd} {_at:%a %Y-%m-%d %H:%M}{' every ' + _a.every if _a.every else ''}: {' '.join(_a.text)}")
    try:
        _send({"guy_command": "schedule"})
    except OSError:
        pass
    sys.exit(0)

# Gmail, read-only over IMAP with an app password per account. The accounts are listed in
# ~/.config/guy/mail.json, their passwords live in the keyring (secret-tool), and nothing is ever
# marked as read: the inbox is opened read-only and only the sender, subject and date are fetched.
#   guy --add-mail you@gmail.com [--label Work]   asks for the app password, checks it, stores it
#   guy --remove-mail you@gmail.com               guy --mail [--count N]   print the unread mail
MAIL_CONFIG = os.path.join(os.path.expanduser("~"), ".config/guy/mail.json")
MAIL_HOST = "imap.gmail.com"
MAIL_SEARCH = "is:unread category:primary"   # Gmail search: the Primary tab, not every unread promotion
MAIL_COUNT = 30                               # the newest this many are listed (it scrolls)


def mail_accounts():
    """([{"address", "label"}], the whole config)."""
    import json
    try:
        with open(MAIL_CONFIG) as f:
            cfg = json.load(f)
    except (OSError, ValueError):
        cfg = {}
    return [a for a in cfg.get("accounts", []) if isinstance(a, dict) and a.get("address")], cfg


def save_mail_accounts(accounts, cfg):
    import json
    os.makedirs(os.path.dirname(MAIL_CONFIG), exist_ok=True)
    cfg["accounts"] = accounts
    with open(MAIL_CONFIG, "w") as f:
        json.dump(cfg, f, indent=2)


def mail_label(account):
    return account.get("label") or account["address"].split("@")[0]


def mail_password(address):
    """The app password from the keyring (which may ask to be unlocked), or None."""
    import subprocess
    r = subprocess.run(["secret-tool", "lookup", "service", "guy-mail", "account", address],
                       capture_output=True, text=True, timeout=120)
    return r.stdout.strip() or None


def mail_link(address, thread=None):
    import urllib.parse
    url = "https://mail.google.com/mail/?authuser=" + urllib.parse.quote(address)
    return url + (f"#all/{thread:x}" if thread else "#inbox")


def mail_query(search, today=True):
    """`search` as a quoted X-GM-RAW argument; with `today`, only what arrived since midnight."""
    if today:                                    # Gmail takes a Unix time: midnight here, not in UTC
        import datetime as dt
        search += f" after:{int(dt.datetime.combine(dt.date.today(), dt.time()).timestamp())}"
    return '"' + search.replace("\\", "\\\\").replace('"', '\\"') + '"'


def mail_headers(m, address, uids):
    """[{"uid", "when", "sender", "subject", "link"}] for these UIDs (bytes or str) of a selected mailbox."""
    import email
    import email.header
    import email.utils
    import re

    def text(raw):
        try:
            return str(email.header.make_header(email.header.decode_header(raw or ""))).strip()
        except (LookupError, UnicodeError, ValueError):
            return (raw or "").strip()

    out = []
    if not uids:
        return out
    _t, data = m.uid("FETCH", ",".join(u.decode() if isinstance(u, bytes) else str(u) for u in uids),
                     "(X-GM-THRID BODY.PEEK[HEADER.FIELDS (FROM SUBJECT DATE)])")
    for part in data:
        if not isinstance(part, tuple):
            continue
        meta = part[0].decode(errors="replace")
        uid, thread = re.search(r"UID (\d+)", meta), re.search(r"X-GM-THRID (\d+)", meta)
        msg = email.message_from_bytes(part[1])
        name, addr = email.utils.parseaddr(text(msg["From"]))
        try:
            when = email.utils.parsedate_to_datetime(msg["Date"]).timestamp()
        except (TypeError, ValueError):
            when = 0.0
        out.append({"uid": uid.group(1) if uid else meta, "when": when, "sender": name or addr,
                    "subject": text(msg["Subject"]) or "(no subject)",
                    "link": mail_link(address, int(thread.group(1)) if thread else None)})
    return sorted(out, key=lambda x: -x["when"])


def fetch_mail(address, password, search=MAIL_SEARCH, count=MAIL_COUNT, today=True):
    """(how many match `search` in the inbox, [the newest `count` of them as {"uid", "when", "sender",
    "subject", "link"}], newest first). With `today`, only what arrived since midnight."""
    import imaplib

    with imaplib.IMAP4_SSL(MAIL_HOST, timeout=20) as m:
        m.login(address, password)
        m.select("INBOX", readonly=True)
        _t, data = m.uid("SEARCH", None, "X-GM-RAW", mail_query(search, today))
        uids = data[0].split() if data and data[0] else []
        return len(uids), mail_headers(m, address, uids[-count:])


def mail_labels(accounts):
    """address -> the name to show: its label, or the address itself when several accounts share a label."""
    names = [mail_label(a) for a in accounts]
    return {a["address"]: n if names.count(n) == 1 else a["address"] for a, n in zip(accounts, names)}


# ---------- verification codes in new mail ----------
CODE_HINT = r"verif\w*|confirm\w*|one[- ]?time|otp|pass ?code|security code|sign[- ]?in|log ?in|2fa|" \
            r"two[- ](?:factor|step)|authenticat\w*|code|pin"
CODE_KEY = r"(?:code|passcode|otp|pin)\b"     # a code usually follows one of these closely


def message_text(msg):
    """The readable text of an email.message.EmailMessage (default policy): plain text, or HTML stripped."""
    import html
    import re
    part = msg.get_body(preferencelist=("plain", "html"))
    if part is None:
        return ""
    try:
        text = part.get_content()
    except (LookupError, UnicodeError, ValueError):
        return ""
    if part.get_content_type() == "text/html":
        text = re.sub(r"(?is)<(style|script|head)\b.*?</\1>", " ", text)
        text = re.sub(r"(?i)<br\s*/?>|</(p|div|tr|td|h\d|li)>", "\n", text)
        text = html.unescape(re.sub(r"<[^>]+>", " ", text))
    return text


def find_code(subject, text):
    """The verification code in an email, or None: 4-8 digits (or "123 456"), or 5-8 capitals and digits
    right after "code". Scored by how close it sits to "code" (before or after it), its length, and
    whether the subject has it; years, prices, order numbers and promo codes don't count."""
    import re
    subject, text = subject or "", (text or "")[:6000]
    if not re.search(rf"\b(?:{CODE_HINT})\b", subject + " " + text[:3000], re.I):
        return None
    best = None
    for where, body in ((0, subject), (1, text)):
        flat = re.sub(r"\s+", " ", body)
        for m in re.finditer(r"(?<![\w.,/:#$€£@+])(\d{3}[ -]\d{3}|\d{4,8}|[A-Z0-9]{5,8})(?![\w/%@]|[.,]\d)", flat):
            code = re.sub(r"[ -]", "", m.group(1))
            before, after = flat[max(0, m.start() - 60):m.start()], flat[m.end():m.end() + 40]
            right_after_key = re.search(rf"\b{CODE_KEY}", before[-30:], re.I)
            if re.search(r"promo|coupon|discount|voucher|referral|gift|% off|\boff\b", before[-40:] + after, re.I):
                continue
            if not code.isdigit():
                # letters and digits: only right after "code", and with both in it
                if not (right_after_key and re.search(r"\d", code) and re.search(r"[A-Z]", code)):
                    continue
            elif len(code) < 5 and 1900 <= int(code) <= 2099 and not right_after_key:
                continue                         # a year
            if re.search(rf"\b{CODE_KEY}", before, re.I) or re.search(rf"^\W{{0,25}}(?:is |are )?(?:your |the )?"
                                                                    rf"(?:[\w-]+ ){{0,3}}{CODE_KEY}", after, re.I):
                score = 3
            elif re.search(rf"\b(?:{CODE_HINT})\b", before[-25:] + " " + after[:25], re.I):
                score = 1                        # "verify" or "sign in" right next to it
            else:
                score = 0
            score += (2 if len(code) == 6 else 1 if len(code) in (4, 5, 8) else 0) + (1 if where == 0 else 0) \
                + (1 if right_after_key else 0)
            if score >= 3 and (best is None or score > best[0]):
                best = (score, code)
    return best[1] if best else None


def recent_code(address, password, minutes=15):
    """The newest code in mail that reached the inbox in the last `minutes`: (code, sender, received) or None."""
    import datetime as dt
    import email
    import email.policy
    import email.utils
    import imaplib
    import time as _t
    with imaplib.IMAP4_SSL(MAIL_HOST, timeout=20) as m:
        m.login(address, password)
        m.select("INBOX", readonly=True)
        since = (dt.date.today() - dt.timedelta(days=1)).strftime("%d-%b-%Y")
        _t2, data = m.uid("SEARCH", None, "SINCE", since)
        uids = data[0].split() if data and data[0] else []
        for uid in reversed(uids[-15:]):
            _t2, data = m.uid("FETCH", uid.decode(), "(INTERNALDATE RFC822.SIZE BODY.PEEK[])")
            part = next((p for p in data if isinstance(p, tuple)), None)
            if not part:
                continue
            got = imaplib.Internaldate2tuple(part[0])
            received = _t.mktime(got) if got else 0.0
            if _t.time() - received > minutes * 60:
                break                            # older than that: so is everything before it
            msg = email.message_from_bytes(part[1], policy=email.policy.default)
            code = find_code(str(msg["Subject"] or ""), message_text(msg))
            if code:
                name, addr = email.utils.parseaddr(str(msg["From"] or ""))
                return code, name or addr, received
    return None


def mail_error(e):
    """A short reason an account couldn't be checked."""
    import imaplib
    if isinstance(e, imaplib.IMAP4.error):
        return "Gmail refused the sign-in (wrong app password, or IMAP is off for this account)"
    if isinstance(e, OSError):
        return "couldn't reach Gmail"
    return f"couldn't check: {e}"


# guy --code: the newest verification code from your mail, copied (and typed into the browser when it
# has focus). A running GUY does it, so the island shows it; otherwise it's printed and copied here.
if sys.argv[1:] == ["--code"]:
    try:
        _send({"guy_command": "code"})
        sys.exit(0)
    except OSError:
        import subprocess
        for _acc in mail_accounts()[0]:
            try:
                _hit = recent_code(_acc["address"], mail_password(_acc["address"]) or "")
            except Exception:  # noqa: BLE001 - try the next account
                continue
            if _hit:
                subprocess.run(["wl-copy", "--", _hit[0]])
                print(f"{_hit[0]}  (copied; from {_hit[1]} to {_acc['address']})")
                sys.exit(0)
        print("No verification code in the last 15 minutes.", file=sys.stderr)
        sys.exit(1)

if sys.argv[1:2] in (["--add-mail"], ["--remove-mail"], ["--mail"]):
    import argparse
    import getpass
    import shutil
    import subprocess
    import time as _time
    _cmd = sys.argv[1][2:]
    _ap = argparse.ArgumentParser(prog=f"guy --{_cmd}")
    if _cmd == "mail":
        _ap.add_argument("--count", type=int, default=10, help="messages to show per account")
        _ap.add_argument("--all", action="store_true", help="all unread mail, not just today's")
    else:
        _ap.add_argument("address")
    if _cmd == "add-mail":
        _ap.add_argument("--label", help='a short name shown on the island, e.g. "Work"')
    _a = _ap.parse_args(sys.argv[2:])
    if not shutil.which("secret-tool"):
        print("guy: needs secret-tool (sudo pacman -S libsecret) and a keyring such as gnome-keyring",
              file=sys.stderr)
        sys.exit(1)
    _accounts, _cfg = mail_accounts()
    if _cmd == "mail":
        if _accounts and not _a.all:
            print("Unread mail from today (guy --mail --all for everything)\n")
        if not _accounts:
            print("No mail accounts. Add one with: guy --add-mail you@gmail.com")
        for _acc in _accounts:
            try:
                _pw = mail_password(_acc["address"])
                if not _pw:
                    raise RuntimeError(f"no password in the keyring (guy --add-mail {_acc['address']})")
                _n, _msgs = fetch_mail(_acc["address"], _pw, _cfg.get("search", MAIL_SEARCH), _a.count, not _a.all)
            except Exception as _e:  # noqa: BLE001 - say why, and go on to the next account
                print(f"{mail_label(_acc)}  <{_acc['address']}>  {mail_error(_e)}\n")
                continue
            print(f"{mail_label(_acc)}  <{_acc['address']}>  {_n} unread{'' if _a.all else ' today'}")
            for _m in _msgs:
                _when = _time.strftime("%a %d %b %H:%M", _time.localtime(_m["when"])) if _m["when"] else "?"
                print(f"  {_when}  {_m['sender']}: {_m['subject']}\n      {_m['link']}")
            print()
        sys.exit(0)
    _addr = _a.address.strip().lower()
    if _cmd == "remove-mail":
        subprocess.run(["secret-tool", "clear", "service", "guy-mail", "account", _addr])
        save_mail_accounts([x for x in _accounts if x["address"] != _addr], _cfg)
        print(f"Removed {_addr}.")
    else:
        print(f"Create an app password for {_addr} at https://myaccount.google.com/apppasswords\n"
              "(it needs 2-Step Verification on). GUY only reads, and never marks anything as read.")
        _pw = getpass.getpass("App password: ").replace(" ", "").strip()
        if not _pw:
            sys.exit(1)
        try:
            _n, _msgs = fetch_mail(_addr, _pw, _cfg.get("search", MAIL_SEARCH), 1)
        except Exception as _e:  # noqa: BLE001
            print(f"guy: {mail_error(_e)}. Nothing saved.", file=sys.stderr)
            sys.exit(1)
        _r = subprocess.run(["secret-tool", "store", "--label", f"GUY mail: {_addr}",
                             "service", "guy-mail", "account", _addr], input=_pw, text=True)
        if _r.returncode:
            print("guy: couldn't save the password in the keyring", file=sys.stderr)
            sys.exit(1)
        _old = next((x for x in _accounts if x["address"] == _addr), {})
        _acc = {"address": _addr, "label": _a.label or _old.get("label") or _addr.split("@")[0]}
        save_mail_accounts([x for x in _accounts if x["address"] != _addr] + [_acc], _cfg)
        print(f"Added {_addr} as “{_acc['label']}”: {_n} unread.")
    try:
        _send({"guy_command": "mail"})
    except OSError:
        pass
    sys.exit(0)

# Any script can put a live activity on the island, e.g.
#   guy --activity backup --title "Backing up" --detail "photos" --progress 0.4
#   guy --activity backup --title "Backup finished" --done --open ~/Backups
# Google Calendar, over its API with your own OAuth client (Google allows no passwords for it). One-time
# setup is in the README; then each account is linked in the browser, and its token kept in the keyring.
#   guy --add-calendar [--client client_secret.json] [--label Work]   link an account (opens the browser)
#   guy --remove-calendar ADDR      guy --calendar [--days N]   what's coming up, in every linked account
#   guy --cal-add "TITLE" "WHEN" [--end WHEN | --for 1h30m] [--all-day] [--where PLACE] [--notes TEXT]
#                 [--repeat daily|weekdays|weekly|monthly|yearly] [--account ADDR]
#   guy --cal-delete ID [--account ADDR]
# WHEN is anything guy --remind takes; for a date, "YYYY-MM-DD" (with --all-day).
CAL_CONFIG = os.path.join(os.path.expanduser("~"), ".config/guy/calendar.json")
CAL_CLIENT = os.path.join(os.path.expanduser("~"), ".config/guy/google-client.json")
CAL_SCOPE = "https://www.googleapis.com/auth/calendar.events"
CAL_API = "https://www.googleapis.com/calendar/v3/calendars/primary/events"
CAL_REPEAT = {"daily": "FREQ=DAILY", "weekdays": "FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR", "weekly": "FREQ=WEEKLY",
              "monthly": "FREQ=MONTHLY", "yearly": "FREQ=YEARLY"}


class CalendarError(Exception):
    pass


def cal_accounts():
    import json
    try:
        with open(CAL_CONFIG) as f:
            return json.load(f).get("accounts", [])
    except (OSError, ValueError):
        return []


def save_cal_accounts(accounts):
    import json
    os.makedirs(os.path.dirname(CAL_CONFIG), exist_ok=True)
    with open(CAL_CONFIG + ".tmp", "w") as f:
        json.dump({"accounts": accounts}, f, indent=1)
    os.replace(CAL_CONFIG + ".tmp", CAL_CONFIG)


def cal_client():
    """(client id, client secret) from the OAuth client JSON Google gave you."""
    import json
    try:
        with open(CAL_CLIENT) as f:
            c = json.load(f)
        c = c.get("installed") or c.get("web") or c
        return c["client_id"], c["client_secret"]
    except (OSError, ValueError, KeyError):
        raise CalendarError("no Google OAuth client yet: see Google Calendar in GUY's README, then run "
                            "guy --add-calendar --client ~/Downloads/client_secret_….json") from None


def google_post(url, fields):
    import json
    import urllib.error
    import urllib.parse
    import urllib.request
    try:
        with urllib.request.urlopen(url, urllib.parse.urlencode(fields).encode(), timeout=15) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        try:
            err = json.load(e)
        except ValueError:
            err = {}
        raise CalendarError(err.get("error_description") or err.get("error") or f"Google said {e.code}") from None
    except OSError:
        raise CalendarError("couldn't reach Google") from None


def cal_token(address):
    """A fresh access token for `address`, from the refresh token in the keyring."""
    import subprocess
    r = subprocess.run(["secret-tool", "lookup", "service", "guy-calendar", "account", address],
                       capture_output=True, text=True)
    if not r.stdout.strip():
        raise CalendarError(f"{address} isn't linked: run guy --add-calendar")
    cid, secret = cal_client()
    try:
        return google_post("https://oauth2.googleapis.com/token", {
            "client_id": cid, "client_secret": secret, "refresh_token": r.stdout.strip(),
            "grant_type": "refresh_token"})["access_token"]
    except CalendarError as e:
        if "invalid_grant" in str(e) or "expired" in str(e).lower() or "revoked" in str(e).lower():
            raise CalendarError(f"Google ended GUY's access to {address}: run guy --add-calendar again") from None
        raise


def cal_api(token, method, url, body=None):
    import json
    import urllib.error
    import urllib.request
    req = urllib.request.Request(url, method=method, data=json.dumps(body).encode() if body is not None else None,
                                 headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            raw = r.read()
            return json.loads(raw) if raw else {}
    except urllib.error.HTTPError as e:
        try:
            msg = json.load(e)["error"]["message"]
        except (ValueError, KeyError, TypeError):
            msg = f"Google said {e.code}"
        raise CalendarError(msg) from None
    except OSError:
        raise CalendarError("couldn't reach Google Calendar") from None


def cal_link():
    """Sign in in the browser (a loopback redirect, with PKCE); returns (address, refresh token)."""
    import base64
    import hashlib
    import http.server
    import json
    import secrets
    import subprocess
    import time
    import urllib.parse
    cid, secret = cal_client()
    verifier = secrets.token_urlsafe(64)
    state = secrets.token_urlsafe(16)
    got = {}

    class Back(http.server.BaseHTTPRequestHandler):
        timeout = 10                             # drop sockets browsers open ahead and never use

        def do_GET(self):
            q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            if q.get("state", [""])[0] == state:
                got.update({k: v[0] for k, v in q.items()})
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            self.wfile.write("<p style='font:16px sans-serif;margin:3em'>GUY has your calendar. You can close this tab.</p>"
                             .encode() if "code" in got else b"<p>That didn't work; try guy --add-calendar again.</p>")

        def log_message(self, *_a):
            pass

    # threaded: Chrome and Firefox open a spare connection first, and a one-at-a-time server would sit
    # waiting on it while the real redirect queues behind
    server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Back)
    server.daemon_threads = True
    server.timeout = 1                           # wake to see whether a handler thread got the code
    redirect = f"http://127.0.0.1:{server.server_port}"
    url = "https://accounts.google.com/o/oauth2/v2/auth?" + urllib.parse.urlencode({
        "client_id": cid, "redirect_uri": redirect, "response_type": "code", "scope": "openid email " + CAL_SCOPE,
        "access_type": "offline", "prompt": "consent", "state": state, "code_challenge_method": "S256",
        "code_challenge": base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()})
    print("Sign in to Google in your browser (and pick the account to link). If it didn't open:\n" + url)
    subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    deadline = time.monotonic() + 300
    while "code" not in got and "error" not in got and time.monotonic() < deadline:
        server.handle_request()                  # the browser may ask for other things (a favicon) first
    server.server_close()
    if "code" not in got:
        raise CalendarError(got.get("error", "no answer from the browser in 5 minutes"))
    tok = google_post("https://oauth2.googleapis.com/token", {
        "client_id": cid, "client_secret": secret, "code": got["code"], "code_verifier": verifier,
        "redirect_uri": redirect, "grant_type": "authorization_code"})
    if "refresh_token" not in tok:
        raise CalendarError("Google gave no lasting access; remove GUY at myaccount.google.com/permissions and retry")
    # which account they picked: the id token, straight from Google over TLS, says
    claims = tok["id_token"].split(".")[1]
    address = json.loads(base64.urlsafe_b64decode(claims + "=" * (-len(claims) % 4)))["email"]
    return address, tok["refresh_token"]


def cal_when(text, all_day=False):
    """A datetime (or a date, with all_day) from WHEN, as guy --remind takes it, or a bare YYYY-MM-DD."""
    import datetime as dt
    import re
    if all_day:
        t = text.strip().lower()
        if t in ("today", "tomorrow"):
            return dt.date.today() + dt.timedelta(days=t == "tomorrow")
        if re.fullmatch(r"\d{4}-\d{2}-\d{2}", t):
            return dt.date.fromisoformat(t)
        return parse_when(text).date()
    return parse_when(text)


def cal_span(text):
    """'1h30m', '90m', '2h', '45 minutes' -> a timedelta."""
    import datetime as dt
    import re
    parts = re.findall(r"(\d+(?:\.\d+)?)\s*(h|hours?|hrs?|m|mins?|minutes?)", text.lower())
    if not parts:
        raise CalendarError(f"not a length of time: {text!r} (say 1h30m)")
    return dt.timedelta(minutes=sum(float(n) * (60 if u[0] == "h" else 1) for n, u in parts))


def cal_fmt(ev):
    """One line for an event: when, what, where."""
    import datetime as dt
    s, e = ev.get("start", {}), ev.get("end", {})
    if "date" in s:
        d0, d1 = dt.date.fromisoformat(s["date"]), dt.date.fromisoformat(e["date"]) - dt.timedelta(days=1)
        when = f"{d0:%a %b %-d}" + (f"–{d1:%a %b %-d}" if d1 > d0 else "") + ", all day"
    else:
        t0 = dt.datetime.fromisoformat(s["dateTime"]).astimezone()
        t1 = dt.datetime.fromisoformat(e["dateTime"]).astimezone()
        when = f"{t0:%a %b %-d %H:%M}–" + (f"{t1:%H:%M}" if t1.date() == t0.date() else f"{t1:%a %b %-d %H:%M}")
    where = f"  @ {ev['location']}" if ev.get("location") else ""
    return f"{when}  {ev.get('summary') or '(no title)'}{where}"


