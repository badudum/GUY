            items.append({"kind": "claude", "title": f"Ask GUY: {q}", "subtitle": "Answer right here",
                          "icon": "dialog-question-symbolic", "hint": "Tab", "query": q})
        elif q and CAL_WORDS.search(q):
            items.append({"kind": "claude", "title": f"Ask GUY: {q}",
                          "subtitle": "GUY puts it in your Google Calendar" if cal_accounts()
                          else "Link Google Calendar first: guy --add-calendar (see the README)",
                          "icon": "x-office-calendar", "hint": "Enter", "query": q})
        elif q and (said := intents(q)):
            icon = {"timer": "alarm-symbolic", "timer-cancel": "alarm-symbolic", "open": "system-run-symbolic",
                    "dismiss": "window-close-symbolic",
                    "update-system": "system-software-update-symbolic"}.get(said[0][0], "audio-volume-medium-symbolic")
            if said[0][0] in ("next", "previous", "pause", "play", "whats-playing"):
                icon = "multimedia-player-symbolic"
            items.append({"kind": "do", "title": ", then ".join(x[2] for x in said), "subtitle": "Enter to do it",
                          "icon": icon, "hint": "Enter", "intents": said})
            items.append({"kind": "claude", "title": f"Ask GUY: {q}", "subtitle": "Answer right here",
                          "icon": "dialog-question-symbolic", "hint": "Tab", "query": q})
        elif q:
            result = calculate(q)
            if result is not None:
                items.append({"kind": "calc", "title": result, "subtitle": f"{q}  ·  Enter to copy",
                              "icon": "accessories-calculator", "hint": "Copy", "value": result.replace(" ", "")})
            apps = sorted(((score(q, a["name"], a["extra"], a["words"], a["extra_words"]), a) for a in self.apps),
                          key=lambda t: -t[0])
            for s, a in apps[:MAX_APPS]:
                if s > 0:
                    items.append({"kind": "app", "title": a["name"], "subtitle": a["generic"],
                                  "icon": a["icon"], "hint": "Open", "app": a})
            wins = sorted(((score(q, w.get("title", ""), w["class"].lower()), w) for w in self.windows),
                          key=lambda t: -t[0])
            for s, w in wins[:MAX_WINDOWS]:
                if s > 0:
                    items.append({"kind": "window", "title": w.get("title") or w["class"],
                                  "subtitle": f"{w['class']}  ·  desktop {w.get('workspace', {}).get('name', '?')}",
                                  "icon": self.icon_by_class.get(w["class"].lower(), w["class"].lower()),
                                  "hint": "Switch", "window": w})
            if len(q) > 1:
                items += self.file_items(q, MAX_FILES_INLINE)
            follow = "Follow up" if self.history else "Ask GUY"
            items.append({"kind": "claude", "title": f"{follow}: {q}", "subtitle": "Answer right here",
                          "icon": "dialog-question-symbolic", "hint": "Tab", "query": q})
            items.append({"kind": "web", "title": f"Search Google for “{q}”", "subtitle": "Opens in your browser",
                          "icon": "web-browser", "hint": "Ctrl+↵", "query": q})
        self.show_items(items)

    def stock_fetch(self, name):
        self.stock_timer = None
        self.stocks.lookup(name, self.stock_ready)
        return False

    def stock_ready(self, name, _quotes):
        """A lookup finished: redraw the list if it's still what's being typed."""
        if self.user_mode == "ask" and self.view != "answer" and stock_query(self.entry.get_text()) == name:
            self.refresh(self.entry.get_text())
        return False

    def stock_items(self, name):
        hit = self.stocks.cache.get(name.lower())
        if not hit or time.time() - hit[0] > 60:
            return None
        quotes = hit[1]
        if not quotes:
            return [{"kind": "info", "title": f"No stock found for “{name}”", "subtitle": "Try the ticker, like GOOGL",
                     "icon": "dialog-information-symbolic", "hint": ""}]
        watching = self.stocks.watchlist()
        items = []
        for q in quotes:
            when = time.strftime("%a %H:%M", time.localtime(q["time"])) if q["time"] else ""
            day = f"day {q['low']:,.2f}–{q['high']:,.2f}  ·  " if q["low"] and q["high"] else ""
            items.append({"kind": "stock", "title": f"{q['symbol']}  {fmt_price(q)}",
                          "subtitle": f"{q['name']}  ·  {q['exchange']}  ·  {day}{when}  ·  Enter for the chart",
                          "icon": "utilities-system-monitor-symbolic", "hint": "Chart", "symbol": q["symbol"]})
        top = quotes[0]["symbol"]
        on = top in watching
        items.insert(1, {"kind": "watch", "title": f"{'Remove' if on else 'Add'} {top} {'from' if on else 'to'} my stocks",
                         "subtitle": "Your stocks show in the overview (click the top of the screen)",
                         "icon": "list-remove-symbolic" if on else "list-add-symbolic", "hint": "",
                         "symbol": top, "on": not on})
        return items

    def show_items(self, items):
        self.items = items
        while (row := self.listbox.get_row_at_index(0)) is not None:
            self.listbox.remove(row)
        for item in items:
            row = Gtk.ListBoxRow()
            if item["kind"] == "calc":
                row.add_css_class("calc")
            box = Gtk.Box(spacing=14)
            icon = item["icon"]
            img = Gtk.Image.new_from_gicon(icon) if isinstance(icon, Gio.Icon) else Gtk.Image.new_from_icon_name(icon)
            img.set_pixel_size(30)
            box.append(img)
            texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER, hexpand=True)
            title = Gtk.Label(label=item["title"], xalign=0, ellipsize=Pango.EllipsizeMode.END)
            title.add_css_class("rtitle")
            texts.append(title)
            if item.get("subtitle"):
                sub = Gtk.Label(label=item["subtitle"], xalign=0, ellipsize=Pango.EllipsizeMode.END)
                sub.add_css_class("rsub")
                texts.append(sub)
            box.append(texts)
            hint = Gtk.Label(label=item.get("hint", ""), valign=Gtk.Align.CENTER)
            hint.add_css_class("hint")
            box.append(hint)
            row.set_child(box)
            self.listbox.append(row)
        if items:
            self.listbox.select_row(self.listbox.get_row_at_index(0))
        if self.view != "answer":
            self.set_view("results" if items else "idle")

    def move_selection(self, delta):
        row = self.listbox.get_selected_row()
        idx = (row.get_index() if row else -1) + delta
        idx = max(0, min(len(self.items) - 1, idx))
        target = self.listbox.get_row_at_index(idx)
        if target is None:
            return
        self.listbox.select_row(target)
        ok, bounds = target.compute_bounds(self.listbox)
        if ok:
            adj = self.list_scroll.get_vadjustment()
            top, bottom = bounds.get_y(), bounds.get_y() + bounds.get_height()
            if top < adj.get_value():
                adj.set_value(top)
            elif bottom > adj.get_value() + adj.get_page_size():
                adj.set_value(bottom - adj.get_page_size())

    def activate_index(self, idx):
        if not (0 <= idx < len(self.items)):
            return
        item = self.items[idx]
        kind = item["kind"]
        if kind == "calc":
            subprocess.run(["wl-copy", item["value"]])
            self.close_ask()
        elif kind == "app":
            launch(item["app"]["id"])
            self.close_ask()
        elif kind == "window":
            addr = item["window"]["address"]
            spawn("hyprctl", "dispatch", f'hl.dsp.focus({{ window = "address:{addr}" }})')
            self.close_ask()
        elif kind == "do":
            self.close_ask()
            for action, arg, _label in item["intents"]:
                self.do_intent(action, arg)
        elif kind == "claude":
            self.ask_claude(item["query"])
        elif kind == "stock":
            spawn("xdg-open", stock_url(item["symbol"]))
            self.close_ask()
        elif kind == "link":
            spawn("xdg-open", item["url"])
            self.close_ask()
        elif kind == "code":
            self.close_ask()                     # the browser gets the keyboard back, then GUY types
            GLib.timeout_add(350, lambda: self.mail.lookup_code() and False)
        elif kind == "watch":
            self.stocks.watch(item["symbol"], item["on"])
            self.refresh(self.entry.get_text())
            self.footer.set_label(f"{item['symbol']} {'added to' if item['on'] else 'removed from'} your stocks")
        elif kind == "web":
            spawn("xdg-open", "https://www.google.com/search?q=" + urllib.parse.quote_plus(item["query"]))
            self.close_ask()
        elif kind == "file":
            self.close_ask()
            open_path(item["path"])

    def search_files(self):
        """Alt+F: only files and folders, more of them."""
        term = self.entry.get_text().strip()
        if not term:
            return
        self.mode_list = "files"
        items = self.file_items(term, MAX_FILES)
        if not items:
            items = [{"kind": "info", "title": f"No files matching “{term}”" if FILES.data else "Indexing your files…",
                      "subtitle": "", "icon": "dialog-information-symbolic", "hint": ""}]
        self.show_items(items)
        self.footer.set_label("Files  ·  Enter open  ·  Shift+Enter show in folder  ·  Esc back")

    def file_items(self, q, limit):
        items = []
        for _s, path, is_dir in FILES.search(q, limit):
            where = os.path.dirname(path)
            where = "~" + where[len(str(HOME)):] if where.startswith(str(HOME)) else where
            items.append({"kind": "file", "title": os.path.basename(path), "subtitle": where,
                          "icon": file_icon(path, is_dir), "hint": "Folder" if is_dir else "File", "path": path})
        return items

    def ask_claude(self, query, voice=False, shown=None):
        """shown: what the chat shows as your question, when the prompt itself is long (the news brief)."""
        query = query.strip()
        if not query and not self.attachment:
            return
        self.stop_claude()
        self.claude_gen += 1
        gen = self.claude_gen
        self.answer_text = ""
        self.last_query = query or "What is this file? Summarise it briefly."
        label = self.ask_label = shown or query or f"About {os.path.basename(self.attachment)}"
        self.answer_title.set_label(f"GUY  ·  {label}")
        self.chat_add(label)
        self.spinner.start()
        self.set_view("answer")
        self.entry.set_text("")

        prompt = ""
        if self.history and not self.agent_session:
            prompt += "Earlier in this conversation:\n\n" + "\n\n".join(
                f"User: {q}\nGUY: {a}" for q, a in self.history[-4:]) + "\n\nNow the user asks:\n"
        if self.attachment:
            prompt += f"The user attached the file {self.attachment}. Read it before answering.\n\n"
        prompt += self.last_query
        if voice:
            prompt += ("\n\n(Asked out loud: answer in one to three short sentences that sound natural spoken, "
                       "with no Markdown, lists or code unless they're really needed.)")
            self.voice_gen = self.claude_gen

        cmd = agent_cmd(resume=self.agent_session)
        if self.attachment and not self.attachment.startswith(str(HOME) + "/"):
            cmd += ["--add-dir", os.path.dirname(self.attachment)]
        try:
            proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                    text=True, cwd=HOME, start_new_session=True)
        except OSError as e:
            self.claude_done(gen, f"Couldn't start Claude Code: {e}")
            return
        self.claude_proc = proc
        self.ask_face.mood = "working"

        def work():
            try:
                proc.stdin.write(prompt)
                proc.stdin.close()
            except OSError:
                pass
            error = None
            for line in proc.stdout:
                try:
                    ev = json.loads(line)
                except ValueError:
                    continue
                if ev.get("type") == "stream_event":
                    e = ev.get("event", {})
                    if e.get("type") == "content_block_delta" and e.get("delta", {}).get("type") == "text_delta":
                        GLib.idle_add(self.claude_delta, gen, e["delta"]["text"])
                    elif e.get("type") == "content_block_start":
                        block = e.get("content_block", {})
                        if block.get("type") in ("tool_use", "server_tool_use"):
                            GLib.idle_add(self.claude_tool, gen, block.get("name", ""), label)
                elif ev.get("type") == "result" and ev.get("is_error"):
                    error = str(ev.get("result") or "Claude returned an error.")
                if ev.get("type") in ("system", "result") and ev.get("session_id"):
                    GLib.idle_add(self.set_agent_session, gen, ev["session_id"])
            proc.wait()
            if error is None and proc.returncode not in (0, None, -signal.SIGTERM):
                error = (proc.stderr.read() or "").strip()[-600:] or f"Claude exited with code {proc.returncode}."
            GLib.idle_add(self.claude_done, gen, error)

        threading.Thread(target=work, daemon=True).start()

    def set_agent_session(self, gen, sid):
        if gen == self.claude_gen and self.user_mode == "ask":
            self.agent_session = sid
        return False

    def claude_tool(self, gen, name, label):
        if gen == self.claude_gen:
            self.agent_status = TOOL_STATUS.get(name, "working…")
            if self.user_mode != "ask":
                self.apply()
        """Claude went to use a tool: show what it's doing, and drop the "let me look" preamble."""
        if gen == self.claude_gen:
            self.answer_text = ""
            self.render_answer()
            self.answer_title.set_label(f"GUY  ·  {label}  ·  {TOOL_STATUS.get(name, 'working…')}")
        return False

    def claude_delta(self, gen, text):
        if gen == self.claude_gen:
            self.answer_text += text
            if self.render_id is None:
                self.render_id = GLib.timeout_add(50, self.render_answer)
        return False

    def claude_done(self, gen, error):
        if gen != self.claude_gen:
            return False
        self.spinner.stop()
        self.answer_title.set_label(f"GUY  ·  {self.ask_label}")
        self.claude_proc = None
        self.ask_face.mood = self.mood()
        if error:
            self.answer_text += ("\n\n" if self.answer_text else "") + f"**Error:** {error}"
            self.ask_face.mood = "error"
        elif not self.answer_text:
            self.answer_text = "_No answer received._"
        else:
            self.history.append((self.last_query, self.answer_text))
            if gen == self.voice_gen:
                self.speak(self.answer_text, follow=True)
        self.convo_until = time.monotonic() + 180
        self.agent_status = ""
        self.render_answer()
        if self.user_mode != "ask":              # the panel was closed meanwhile: say so on the pill
            act = self.set_activity("answer", "task", "GUY", "dialog-information-symbolic",
                                    detail=first_line(self.answer_text, 80))
            act.state, act.reply = ("error" if error else "done"), self.answer_text
            self.flash(first_line(self.answer_text, 70) + "  ·  click to read", "error" if error else "done", 6.0)
        return False

    def render_answer(self):
        if self.render_id is not None:
            GLib.source_remove(self.render_id)
            self.render_id = None
        if self.answer_label is None:
            return False
        markup = md_to_markup(self.answer_text)
        try:
            Pango.parse_markup(markup, -1, "\0")
            self.answer_label.set_markup(markup)
        except GLib.Error:
            self.answer_label.set_text(self.answer_text)
        return False

    # ----- the chat transcript -----
    def chat_clear(self):
        while (child := self.chat.get_first_child()) is not None:
            self.chat.remove(child)
        self.answer_label = None
        self.answer_text = ""

    def chat_add(self, question):
        """A new turn: your question as a bubble, and an empty answer under it that GUY fills in."""
        if self.answer_label is not None and not self.answer_text:
            self.chat.remove(self.answer_label)  # a stopped answer that never got a word
        if question:
            you = Gtk.Label(label=question, xalign=0, wrap=True, selectable=True, halign=Gtk.Align.END,
                            wrap_mode=Pango.WrapMode.WORD_CHAR)
            you.add_css_class("you")
            you.set_focusable(False)
            self.chat.append(you)
        self.answer_label = Gtk.Label(xalign=0, yalign=0, wrap=True, selectable=True,
                                      wrap_mode=Pango.WrapMode.WORD_CHAR)
        self.answer_label.add_css_class("answer")
        self.answer_label.set_focusable(False)
        self.chat.append(self.answer_label)
        self.answer_text = ""
        self.chat_stick = True

    def chat_follow(self, adj):
        if self.chat_stick:
            adj.set_value(adj.get_upper() - adj.get_page_size())

    def chat_scrolled(self, adj):
        self.chat_stick = adj.get_value() >= adj.get_upper() - adj.get_page_size() - 24

    def stop_claude(self):
        proc, self.claude_proc = self.claude_proc, None
        if proc and proc.poll() is None:
            try:
                os.killpg(proc.pid, signal.SIGTERM)
            except (ProcessLookupError, PermissionError):
                pass

    def on_key(self, _ctrl, keyval, _code, state):
        if self.floating and self.mode != "ask" and keyval == Gdk.KEY_Escape:
            if self.mode == "home":              # a panel closes into the orb first; Esc again puts him back
                self.user_mode = None
                self.apply()
            else:
                self.dock()
            return True
        if self.mode != "ask":
            return False
        ctrl = bool(state & Gdk.ModifierType.CONTROL_MASK)
        alt = bool(state & Gdk.ModifierType.ALT_MASK)
        shift = bool(state & Gdk.ModifierType.SHIFT_MASK)
        if keyval == Gdk.KEY_Escape:
            if self.view == "answer":
                self.stop_claude()
                self.spinner.stop()
                self.set_view("idle")
                self.refresh(self.entry.get_text())
            elif self.mode_list == "files":
                self.mode_list = "search"
                self.refresh(self.entry.get_text())
            else:
                self.close_ask(explicit=True)
            return True
        if keyval in (Gdk.KEY_Down, Gdk.KEY_Up) and self.view == "results":
            self.move_selection(1 if keyval == Gdk.KEY_Down else -1)
            return True
        if keyval in (Gdk.KEY_Tab, Gdk.KEY_ISO_Left_Tab):
            self.ask_claude(self.entry.get_text())
            return True
        if alt and keyval in (Gdk.KEY_f, Gdk.KEY_F):
            self.search_files()
            return True
        if ctrl and not shift and keyval in (Gdk.KEY_y, Gdk.KEY_n) and self.agent_approval() is not None:
            self.decide("allow" if keyval == Gdk.KEY_y else "deny", self.agent_approval())
            return True
        if ctrl and shift and keyval in (Gdk.KEY_c, Gdk.KEY_C) and self.answer_text:
            subprocess.run(["wl-copy", self.answer_text])
            self.footer.set_label("Answer copied to clipboard")
            return True
        if keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            text = self.entry.get_text().strip()
            if ctrl and text:
                spawn("xdg-open", "https://www.google.com/search?q=" + urllib.parse.quote_plus(text))
                self.close_ask()
            elif self.view == "results":
                row = self.listbox.get_selected_row()
                idx = row.get_index() if row else 0
                if shift and 0 <= idx < len(self.items) and self.items[idx]["kind"] == "file":
                    self.close_ask()
                    show_in_folder(self.items[idx]["path"])
                else:
                    self.activate_index(idx)
            elif self.view == "answer" or self.attachment:
                self.ask_claude(text)
            return True
        return False


def main():
    args = sys.argv[1:]
    if args in (["--install-hooks"], ["--uninstall-hooks"]):
        return hooks_cli(args == ["--install-hooks"])
    app = Gtk.Application(application_id="local.guy", flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
    state = {}

    def command_line(app, cmdline):
        if "guy" not in state:
            state["guy"] = Guy(app)
            app.hold()
        argv = cmdline.get_arguments()[1:]
        if argv == ["--ask"]:
            state["guy"].toggle_ask()
        elif argv:
            print("usage: guy [--ask | --install-hooks | --uninstall-hooks]", file=sys.stderr)
        return 0

    app.connect("command-line", command_line)
    return app.run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
