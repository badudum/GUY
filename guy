    def check_updates(self):
        """Count available updates with HyDE's checker (the bar's updates module), off the main thread."""
        def work():
            result = None
            try:
                out = subprocess.run(["hyde-shell", "system.update"], capture_output=True, text=True,
                                     timeout=180).stdout.strip().splitlines()
                lines = json.loads(out[-1]).get("tooltip", "").splitlines() if out else []
                if lines and (m := re.search(r"(\d+)", lines[0])):
                    parts = [ln.replace(": ", " ") for ln in lines[1:] if ln.strip() and not ln.endswith(": 0")]
                    result = (int(m.group(1)), "  ·  ".join(parts))
            except (OSError, subprocess.SubprocessError, ValueError, AttributeError):
                pass
            GLib.idle_add(self.got_updates, result)

        threading.Thread(target=work, daemon=True).start()
        return True

    def got_updates(self, result):
        before = self.updates[0] if self.updates else 0
        self.updates = result
        if result and result[0] > before:
            noun = "update" if result[0] == 1 else "updates"
            self.flash(f"{result[0]} {noun} available  ·  click to see", "idle", 5.0)
        else:
            self.apply()
        return False

    def run_update(self):
        """yay -Syu in a new kitty window, left open afterwards so you can read what happened.
        The prompt watcher still calls you back to it for the sudo password and any [Y/n]."""
        if shutil.which("kitty") and shutil.which("yay"):
            spawn("kitty", "--title", "yay -Syu", "--hold", "yay", "-Syu")
        else:
            spawn("hyde-shell", "system.update", "up")
        self.user_mode = None
        self.hover = False
        self.apply()

    def do_intent(self, action, arg, quiet=False):
        """Carry out a plain-language command, and say what happened on the pill."""
        say = None
        if action in ("volume-down", "volume-up", "volume-set", "mute", "unmute"):
            if action == "volume-set":
                run("wpctl", "set-volume", SINK, f"{arg}%")
            elif action == "volume-down":
                run("wpctl", "set-volume", SINK, f"{arg}%-")
            elif action == "volume-up":
                run("wpctl", "set-volume", "-l", "1.0", SINK, f"{arg}%+")
            if action in ("volume-set", "volume-up", "unmute"):
                run("wpctl", "set-mute", SINK, "0")
            elif action == "mute":
                run("wpctl", "set-mute", SINK, "1")
            vol, muted = get_volume()
            say = "Couldn't change the volume" if vol is None else f"Volume {vol}%" + ("  ·  muted" if muted else "")
        elif action in ("next", "previous", "pause", "play", "play-pause"):
            if not run("playerctl", "-l"):
                say = "Nothing is playing"
            else:
                # the player GUY shows (what's playing), not whichever playerctl lists first
                run("playerctl", *(("-p", self.media.now["player"]) if self.media.now else ()), action)
                if action in ("pause", "play"):
                    say = "Paused" if action == "pause" else "Playing"
                elif action in ("next", "previous"):
                    # the new track pops the pill as soon as the player reports it, playing or not
                    self.media.announce = time.monotonic() + 3
                    say = "Next track" if action == "next" else "Previous track"
        elif action == "whats-playing":
            now = self.media.now
            say = (f"♪ {now['title']}" + (f"  ·  {now['artist']}" if now["artist"] else "")) if now else "Nothing is playing"
        elif action == "timer":
            self.start_timer(*arg)
            return f"Timer set for {fmt_duration(arg[0])}" + (f", {arg[1]}" if arg[1] else "")
        elif action == "update-system":
            self.run_update()
            return "Opening a terminal to update your packages"
        elif action == "open":
            say = self.open_thing(arg)
            if say is None:
                self.flash(f"Couldn't find “{arg}”", "idle", 2.5)
                return None
        elif action == "dismiss":
            self.close_ask(explicit=True)
            return None
        elif action == "timer-cancel":
            timers = [k for k, a in self.activities.items() if a.kind == "timer" and a.state == "running"]
            for k in timers:
                del self.activities[k]
            say = "Timer cancelled" if len(timers) == 1 else f"{len(timers)} timers cancelled" if timers else "No timers running"
        if say and not quiet:
            self.flash(say, "idle", 2.5)
        else:
            self.apply()
        return say

    def open_thing(self, name):
        """Open an app (or switch to it if it's already open), a folder, a file, or a website. None if nothing fits."""
        q = re.sub(r"[^\w\s.+-]", "", name).strip()
        if not q:
            return None
        apps = load_apps()
        # a window is known by its class and by its app's name and description ("terminal" finds kitty)
        by_class = {a["wmclass"]: a for a in apps if a["wmclass"]}
        by_class.update({a["id"].removesuffix(".desktop").lower(): a for a in apps})

        def window_score(w):
            app = by_class.get(w["class"].lower())
            return max(score(q, w["class"]), score(q, app["name"], app["extra"]) if app else 0)

        windows = load_windows()
        if windows:
            w = max(windows, key=window_score)
            if window_score(w) >= 35:            # already open: switch to it
                spawn("hyprctl", "dispatch", f'hl.dsp.focus({{ window = "address:{w["address"]}" }})')
                app = by_class.get(w["class"].lower())
                return f"Switching to {app['name'] if app else w['class']}"
        if apps:
            a = max(apps, key=lambda a: score(q, a["name"], a["extra"]))
            if score(q, a["name"], a["extra"]) >= 35:
                launch(a["id"])
                return f"Opening {a['name']}"
            # a misheard name: "this cord" is Discord, "spot a fly" is Spotify; compare them without spaces
            squash = re.sub(r"\W", "", q.lower())

            def near(name):
                return difflib.SequenceMatcher(None, squash, re.sub(r"\W", "", name.lower())).ratio()
            for w in windows:
                app = by_class.get(w["class"].lower())
                if max(near(w["class"]), near(app["name"]) if app else 0) >= 0.75:
                    spawn("hyprctl", "dispatch", f'hl.dsp.focus({{ window = "address:{w["address"]}" }})')
                    return f"Switching to {app['name'] if app else w['class']}"
            a = max(apps, key=lambda a: near(a["name"]))
            if near(a["name"]) >= 0.75:
                launch(a["id"])
                return f"Opening {a['name']}"
        key = re.sub(r"\s+(?:folder|directory)$", "", q.lower())
        special = {"downloads": GLib.UserDirectory.DIRECTORY_DOWNLOAD, "documents": GLib.UserDirectory.DIRECTORY_DOCUMENTS,
                   "pictures": GLib.UserDirectory.DIRECTORY_PICTURES, "photos": GLib.UserDirectory.DIRECTORY_PICTURES,
                   "music": GLib.UserDirectory.DIRECTORY_MUSIC, "videos": GLib.UserDirectory.DIRECTORY_VIDEOS,
                   "desktop": GLib.UserDirectory.DIRECTORY_DESKTOP}
        folder = GLib.get_user_special_dir(special[key]) if key in special else str(HOME) if key in ("home", "home folder") else None
        if folder is None:
            for parent in (HOME, HOME / "Desktop"):
                try:
                    folder = next((str(c) for c in parent.iterdir() if c.is_dir() and c.name.lower() == key), None)
                except OSError:
                    folder = None
                if folder:
                    break
        if folder:
            spawn("xdg-open", folder)
            return f"Opening {os.path.basename(folder.rstrip('/')) or 'your home folder'}"
        hits = FILES.search(q, 1)
        if hits and hits[0][0] >= 60 * len(q.split()) - 10:     # every word starts the name or a word in it
            open_path(hits[0][1])
            return f"Opening {os.path.basename(hits[0][1])}"
        if re.fullmatch(r"[\w-]+(?:\.[\w-]+)*\.[a-z]{2,}(?:/\S*)?", key):
            spawn("xdg-open", "https://" + key)
            return f"Opening {key}"
        return None

    def start_timer(self, secs, label):
        key = f"timer:{time.monotonic()}"
        act = self.set_activity(key, "timer", label.capitalize() if label else "Timer", "alarm-symbolic")
        act.state = "running"
        act.ends, act.total, act.label = time.monotonic() + secs, secs, label
        self.tick_timers()
        if self.timer_tick is None:
            self.timer_tick = GLib.timeout_add(1000, self.tick_timers)
        self.flash(f"Timer set for {fmt_duration(secs)}" + (f"  ·  {label}" if label else ""), "done", 2.5)

    def tick_timers(self):
        now = time.monotonic()
        timers = [a for a in self.activities.values() if a.kind == "timer" and a.state == "running"]
        for a in timers:
            left = a.ends - now
            a.detail = clock(left) + " left"
            a.progress = 1 - left / a.total
            if left <= 0:
                a.state, a.progress, a.detail = "done", None, "Done"
                a.updated = time.time()
                what = a.label.capitalize() if a.label else "Timer"
                self.chime()
                GLib.timeout_add(700, lambda: self.chime() and False)
                spawn("notify-send", "-a", "GUY", "-i", "alarm-symbolic", f"⏰ {what}",
                      f"Your {fmt_duration(a.total)} timer is done")
                self.flash(f"⏰ {what}  ·  time's up", "done", 10.0)
        if not timers:
            self.timer_tick = None
            return False
        self.apply()
        return True

    # ----- voice (guy-voice does the listening and speaking) -----
    def voice_send(self, **msg):
        try:
            _send(msg, "guy-voice.sock")
        except OSError:
            pass
        return False

    def speak(self, text, follow=False):
        """Say it; with follow, GUY keeps listening afterwards for your reply (no "Hey GUY" needed)."""
        text = speakable(text or "")
        if text:
            self.voice_send(say=text, follow=follow)

    def on_voice(self, ev):
        event = ev.get("event")
        if event == "wake":
            before, self.voice_wake = self.voice_wake, bool(ev.get("on"))
            if before is not None and before != self.voice_wake:
                self.flash("Hey GUY is on" if self.voice_wake else "Hey GUY is off  ·  Super+Space still works",
                           "idle", 2.5)
            else:
                self.apply()
        elif event in ("listening", "thinking"):
            if event == "listening":
                self.voice_words = ""
            self.voice_state = event
            self.apply()
        elif event == "partial":
            self.voice_words = str(ev.get("text", ""))
            self.apply()
        elif event == "done":                    # a follow-up nobody used, or the conversation ended
            self.voice_state = None
            self.apply()
        elif event == "nothing":
            self.voice_state = None
            self.flash("Didn't catch that  ·  try again closer to the mic", "idle", 2.5)
        elif event == "error":
            self.voice_state = None
            self.flash("Voice error: " + str(ev.get("text", ""))[:60], "error", 4.0)
        elif event == "heard":
            self.voice_state = None
            self.handle_voice(str(ev.get("text", "")))

    def handle_voice(self, text):
        """What you said: plain commands straight away (and say what happened), anything else to Claude."""
        text = WAKE_PREFIX.sub("", text).strip()
        pending = self.agent_approval() or (self.approvals[0] if self.approvals else None)
        if pending is not None:
            t = re.sub(r"['’]", "", text.lower())
            no = re.search(r"\b(no|nope|dont|do not|deny|stop|cancel|never ?mind|nah)\b", t)
            if not no and re.search(r"\b(yes|yeah|yep|yup|sure|go ahead|do it|allow|okay|ok|fine|please do|approve)\b", t):
                self.decide("allow", pending)
                return
            if no:
                self.decide("deny", pending)
                return
        if not re.search(r"\w", text):          # just "Hey GUY": listen for the rest
            self.voice_send(listen=True)
            return
        said = None
        for candidate in command_candidates(text):
            if said := intents(candidate):
                break
        if said and [a for a, _arg, _l in said] == ["dismiss"]:
            self.close_ask(explicit=True)
            return
        if said:
            replies = []
            for action, arg, _label in said:
                reply = self.do_intent(action, arg)
                if reply is None and action == "open" and len(said) == 1:
                    said = None                  # not an app or folder: maybe it's a question ("show me the weather")
                    break
                replies.append(reply)
            if said:
                self.speak(". ".join(r for r in replies if r) or "Done", follow=True)
                return
        if name := stock_query(text):
            self.open_ask(keep=True)
            self.set_view("idle")
            self.entry.set_text(text)
            self.entry.set_position(-1)

            def say(_name, quotes):
                self.stock_ready(_name, quotes)
                if not quotes:
                    self.speak(f"I couldn't find a stock called {name}", follow=True)
                else:
                    q = quotes[0]
                    move = "flat" if not q["change"] else (f"{'up' if q['change'] > 0 else 'down'} "
                                                           f"{abs(q['pct']):.1f} percent")
                    self.speak(f"{q['name']} is at {q['price']:,.2f} {q['currency']}, {move} today.", follow=True)
                return False

            self.stocks.lookup(name, say)
            return
        self.open_ask(keep=True)
        self.entry.set_text(text)
        self.entry.set_position(-1)
        self.ask_claude(text, voice=True)

    def show_reply(self, s):
        """Claude Code's final reply, in full, in the Ask GUY answer panel; Tab asks about it."""
        self.show_text(f"{s.name}  ·  Claude Code's reply", s.reply,
                       f"What did the Claude Code session in {s.name} just say?")

    def show_text(self, title, text, question):
        self.open_ask()
        self.stop_claude()
        self.spinner.stop()
        self.history = [(question, text)]
        self.ask_label = title
        self.answer_title.set_label(title)
        self.chat_clear()
        self.chat_add(None)
        self.answer_text = text
        self.render_answer()
        self.set_view("answer")
        self.footer.set_label("Type a question about it and press Enter  ·  Ctrl+Shift+C copy  ·  Esc back")

    # ----- reminders and routines -----
    def check_schedule(self):
        import datetime as dt
        now = dt.datetime.now()
        items, changed = load_schedule(), False
        for item in list(items):
            try:
                at = dt.datetime.fromisoformat(item["at"])
            except (KeyError, ValueError):
                items.remove(item)
                changed = True
                continue
            if at > now:
                continue
            if now - at < dt.timedelta(hours=12):      # missed by more than that (laptop off): skip it
                self.fire(item, late=now - at > dt.timedelta(minutes=5))
            changed = True
            if item.get("every") in EVERY:
                while at <= now:
                    at = next_run(at, item["every"])
                item["at"] = at.isoformat(timespec="minutes")
            else:
                items.remove(item)
        if changed:
            save_schedule(items)
        self.schedule = items
        return True

    def fire(self, item, late=False):
        if item.get("kind") == "task":
            self.run_task(item)
            return
        text = item.get("text", "")
        self.chime()
        GLib.timeout_add(700, lambda: self.chime() and False)
        spawn("notify-send", "-a", "GUY", "-u", "critical", "-i", "alarm-symbolic", "⏰ Reminder", text)
        self.flash(f"⏰ {text}" + ("  ·  (missed while away)" if late else ""), "done", 15.0)
        self.speak(f"Reminder: {text}")

    def run_task(self, item):
        """A routine: GUY's assistant does it in the background, then GUY pops up with the result."""
        title = first_line(item.get("text", "Task"), 40)
        act = self.set_activity(f"task:{item.get('id')}:{time.time()}", "task", title, "emblem-synchronizing-symbolic",
                                detail="Working on it…")
        act.state = "running"
        act.sched_id = item.get("id")
        prompt = ("(This is a scheduled routine: you're running on your own and the user isn't watching. Do it, "
                  "then report the result briefly, as something they'll read or hear. If you get stuck, do all "
                  "you can and end the report with the one question you need answered; they'll reply to it.)\n\n"
                  + item.get("text", ""))

        def work():
            result, error = "", None
            try:
                out = subprocess.run(agent_cmd(stream=False), input=prompt, capture_output=True, text=True,
                                     cwd=HOME, timeout=900).stdout
                data = json.loads(out)
                result = str(data.get("result") or "")
                if data.get("is_error"):
                    error = result or "Claude returned an error."
            except (OSError, subprocess.SubprocessError, ValueError) as e:
                error = str(e)
            GLib.idle_add(self.task_done, act, result, error)

        threading.Thread(target=work, daemon=True).start()
        self.apply()

    def task_done(self, act, result, error):
        act.state = "error" if error else "done"
        act.reply = result or f"**Error:** {error}"
        act.detail = ("Failed: " + first_line(error, 60)) if error else first_line(result, 80) or "Done"
        act.updated = time.time()
        if getattr(act, "sched_id", None) is not None:
            import datetime as dt
            items = load_schedule()
            for i in items:
                if i.get("id") == act.sched_id:
                    i["last_result"] = act.reply
                    i["last_at"] = dt.datetime.now().isoformat(timespec="minutes")
            save_schedule(items)
            self.schedule = items
        self.flash(f"{act.title} is ready  ·  click to read" if not error else f"{act.title} failed",
                   "done" if not error else "error", 8.0)
        spawn("notify-send", "-a", "GUY", "-i", "emblem-ok-symbolic", act.title, first_line(act.reply, 200))
        if not error:
            spoken = speakable(result)
            self.speak(" ".join(re.split(r"(?<=[.!?])\s+", spoken)[:3]))
        return False

    def unschedule(self, ident):
        save_schedule([i for i in load_schedule() if i.get("id") != ident])
        self.schedule = load_schedule()
        self.apply()

    def pop(self, act, seconds):
        """Pop the pill out showing an activity, live, then let it slide back in."""
        self.flash_act = act
        self.flash_mood = "working" if act.state == "running" else act.state
        self.flash_until = time.monotonic() + seconds
        GLib.timeout_add(int(seconds * 1000) + 50, self.apply)
        self.apply()

    def set_prompt(self, prompt):
        if prompt == self.prompt:
            return
        fresh = prompt is not None and (self.prompt is None or self.prompt["text"] != prompt["text"])
        self.prompt = prompt
        if fresh:
            self.chime()
        self.apply()

    def focus_prompt(self):
        """Focus the terminal window the waiting package tool runs in."""
        if not self.prompt:
            return
        procs = scan_procs()
        windows = {w.get("pid"): w.get("address") for w in load_windows()}
        for pid in self.prompts.chain(self.prompt["pid"], procs):
            if pid in windows:
                spawn("hyprctl", "dispatch", f'hl.dsp.focus({{ window = "address:{windows[pid]}" }})')
                break
        self.user_mode = None
        self.hover = False
        self.apply()

    def flash(self, text, mood, seconds):
        self.flash_act = None
        self.flash_text, self.flash_mood = text, mood
        self.flash_until = time.monotonic() + seconds
        GLib.timeout_add(int(seconds * 1000) + 50, self.apply)
        self.apply()

    # ----- animation -----
    def kick(self):
        if self.tick is None:
            self.last_t = None
            self.tick = self.island.add_tick_callback(self.on_tick)
        return False

    def on_tick(self, _w, clock):
        t = clock.get_frame_time() / 1e6
        dt = min(1 / 30, t - self.last_t) if self.last_t else 1 / 60
        self.last_t = t
        isl = self.island
        # springs, a little underdamped so the glass overshoots and settles like liquid
        k = 240.0
        c = 2 * 0.66 * math.sqrt(k)
        isl.vw += (-k * (isl.w - isl.tw) - c * isl.vw) * dt
        isl.w += isl.vw * dt
        kh = 210.0 if isl.th > isl.h else 300.0
        isl.vh += (-kh * (isl.h - isl.th) - 2 * 0.7 * math.sqrt(kh) * isl.vh) * dt
        isl.h = max(0.0, isl.h + isl.vh * dt)
        if isl.fvis:
            # the floating glass: it follows a little behind the pointer, and wobbles like a drop
            kp = 900.0 if self.grab and self.grab["moved"] else 260.0
            cp = 2 * (0.9 if self.grab and self.grab["moved"] else 0.72) * math.sqrt(kp)
            isl.vfx += (-kp * (isl.fx - isl.tfx) - cp * isl.vfx) * dt
            isl.vfy += (-kp * (isl.fy - isl.tfy) - cp * isl.vfy) * dt
            isl.fx += isl.vfx * dt
            isl.fy += isl.vfy * dt
            ks = 260.0
            cs = 2 * 0.55 * math.sqrt(ks)
            isl.vfw += (-ks * (isl.fw - isl.tfw) - cs * isl.vfw) * dt
            isl.vfh += (-ks * (isl.fh - isl.tfh) - cs * isl.vfh) * dt
            isl.fw = max(0.0, isl.fw + isl.vfw * dt)
            isl.fh = max(0.0, isl.fh + isl.vfh * dt)
        if not isl.stretching and (isl.sx != 1.0 or isl.sy != 1.0 or isl.vsx or isl.vsy):
            ks = 420.0
            cs = 2 * 0.45 * math.sqrt(ks)            # springs back past 1 and wobbles a little, like taffy
            isl.vsx += (-ks * (isl.sx - 1) - cs * isl.vsx) * dt
            isl.vsy += (-ks * (isl.sy - 1) - cs * isl.vsy) * dt
            isl.sx += isl.vsx * dt
            isl.sy += isl.vsy * dt
            if abs(isl.sx - 1) < 0.001 and abs(isl.sy - 1) < 0.001 and abs(isl.vsx) < 0.01 and abs(isl.vsy) < 0.01:
                isl.sx = isl.sy = 1.0
                isl.vsx = isl.vsy = 0.0
        self.flight(dt)
        if isl.floating:
            isl.queue_allocate()                 # the page rides along with the floating glass

        if self.pending and isl.alpha <= 0.01:
            self.stack.set_visible_child_name(self.pending)
            self.stack.set_visible(True)
            if self.pending == "ask":
                self.entry.grab_focus()
            self.pending = None
            isl.follow = True
            isl.queue_allocate()
        pw, ph, ptw, pth = isl.primary()
        near = abs(pw - ptw) < 0.2 * ptw + 6 and abs(ph - pth) < 0.25 * pth + 6
        if isl.floating:
            near = near and abs(isl.fy - isl.tfy) < 40 and abs(isl.fx - isl.tfx) < 60
        want = (0.0 if (self.pending or self.mode == "hidden"
                        or (self.pulling and not isl.floating and isl.fy - isl.h > 30))
                else (1.0 if near else isl.alpha))
        if want < isl.alpha:
            isl.alpha = max(want, isl.alpha - dt / 0.09)
        else:
            isl.alpha = min(want, isl.alpha + dt / 0.22)
        if self.mode == "hidden" and isl.alpha <= 0.01 and self.stack.get_visible():
            self.stack.set_visible(False)
        if self.mode == "hidden":
            isl.alpha = min(isl.alpha, max(0.0, isl.h / max(isl.th + 30, 30)))

        isl.queue_draw()
        self.update_input_region()
        settled = (abs(isl.w - isl.tw) < 0.3 and abs(isl.vw) < 2 and abs(isl.h - isl.th) < 0.3
                   and abs(isl.vh) < 2 and isl.alpha == want and not self.pending
                   and not (self.pulling or self.absorbing or self.retracting or (self.grab and self.grab["moved"]))
                   and (not isl.fvis or (abs(isl.fx - isl.tfx) < 0.3 and abs(isl.fy - isl.tfy) < 0.3
                                         and abs(isl.fw - isl.tfw) < 0.3 and abs(isl.fh - isl.tfh) < 0.3
                                         and max(abs(isl.vfx), abs(isl.vfy), abs(isl.vfw), abs(isl.vfh)) < 2))
                   and isl.goo in (0.0, 1.0) and (isl.bridge == 0.0 or not isl.fvis) and isl.sx == 1.0 and isl.sy == 1.0 and not isl.stretching)
        isl.animating = not settled
        if settled:
            isl.w, isl.h, isl.vw, isl.vh = isl.tw, isl.th, 0.0, 0.0
            if isl.fvis:
                isl.fx, isl.fy, isl.fw, isl.fh = isl.tfx, isl.tfy, isl.tfw, isl.tfh
                isl.vfx = isl.vfy = isl.vfw = isl.vfh = 0.0
            isl.queue_draw()
            self.update_input_region()
            self.tick = None
            return False
        return True

    def update_input_region(self):
        surf = self.win.get_surface()
        if surf is None:
            return False
        isl = self.island
        W, H = isl.get_width(), isl.get_height()
        if self.input_all:                       # dragging: follow the pointer anywhere
            surf.set_input_region(cairo.Region(cairo.RectangleInt(0, 0, W, H)))
            return False
        cx = W / 2
        rects = []
        if not self.floating:
            if isl.h < 2 and self.mode == "hidden":
                rects.append((cx - HOT_W / 2, 0, HOT_W, HOT_H))
            else:
                s, _r, bulge = isl.geometry()
                rects.append((cx - isl.w / 2 - s, 0, isl.w + 2 * s, max(HOT_H, isl.h + bulge)))
        if isl.fvis and time.monotonic() >= self.aside_until:
            rects.append(isl.float_rect())
        region = cairo.Region()
        for rect in rects:
            region.union(cairo.RectangleInt(*(int(round(v)) for v in rect)))
        surf.set_input_region(region)
        return False

    # ----- pulled out: floating GUY -----
    def screen(self):
        return self.island.get_width() or SURF_W, self.island.get_height() or SURF_H

    def clamp_anchor(self, x, y):
        W, H = self.screen()
        m = ORB / 2 + 10
        top = ORB / 2 + (1 if self.grab and self.grab["moved"] else 10)   # carried, it can touch the edge
        return max(m, min(W - m, x)), max(top, min(H - m, y))

    def place_float(self):
        """Where the floating glass goes: the orb at the anchor; a page (peek, overview, Ask) opens out of
        it, below it, or above it when it's low on the screen, kept on screen."""
        isl = self.island
        W, H = self.screen()
        ax, ay = self.anchor
        w, h = isl.tfw, isl.tfh
        if self.mode == "orb" or w <= ORB:
            isl.tfx, isl.tfy = ax, ay - ORB / 2
            return
        isl.tfx = max(w / 2 + 12, min(W - w / 2 - 12, ax))
        top = ay - ORB / 2
        if self.grab and self.grab["moved"]:     # being carried: it stays under the hand, kept on screen
            isl.tfy = max(1, min(H - h - 12, top))
            return
        if top + h > H - 12:
            top = ay + ORB / 2 - h
        isl.tfy = max(12, min(H - h - 12, top))

    def retarget(self):
        if self.floating and not (self.absorbing or self.pulling):
            self.place_float()
        self.kick()
        return False

    PANELS = ("home", "ask", "approval", "drop")
    GRIP = 58                                    # an open panel is held by its top strip (the penguin, the title)

    def grippable(self, x, y):
        """Not on something that has its own use for a drag or a press: the text field, a button, a row."""
        w = self.island.pick(x, y, Gtk.PickFlags.DEFAULT)
        while w is not None and w is not self.island:
            if isinstance(w, (Gtk.Text, Gtk.Entry, Gtk.Button, Gtk.ListBoxRow, Gtk.ScrolledWindow)):
                return False
            w = w.get_parent()
        return True

    def on_grab(self, _g, x, y):
        isl = self.island
        self.grab = None
        if self.absorbing or self.pulling:
            return
        if self.floating and isl.fvis:
            fx, fy, fw, fh = isl.float_rect()
            inside = fx <= x <= fx + fw and fy <= y <= fy + fh
            if inside and (self.mode in ("orb", "peek") or (self.mode in self.PANELS and y <= fy + self.GRIP
                                                            and self.grippable(x, y))):
                self.grab = {"kind": "move", "x0": x, "y0": y, "moved": False,
                             "dx": self.anchor[0] - x, "dy": self.anchor[1] - y}
            return
        cx = isl.get_width() / 2
        if abs(x - cx) > isl.w / 2 or y > isl.h:
            return
        if self.mode == "peek":
            self.grab = {"kind": "pull", "x0": x, "y0": y, "moved": False, "dx": 0.0, "dy": 0.0}
        elif self.mode in self.PANELS and y <= self.GRIP and self.grippable(x, y):
            # tearing an open panel off the top edge: it keeps its page, and follows where it was held
            self.grab = {"kind": "tear", "x0": x, "y0": y, "moved": False, "dx": 0.0, "dy": 0.0,
                         "w": isl.tw, "h": isl.th}

    def on_grab_move(self, g, ox, oy):
        d = self.grab
        if d is None:
            return
        if not d["moved"]:
            if (d["kind"] == "pull" and oy < 12) or (d["kind"] == "move" and math.hypot(ox, oy) < 6):
                return
            d["moved"] = True
            g.set_state(Gtk.EventSequenceState.CLAIMED)    # not a click on what's underneath
            self.input_all = True
            self.update_input_region()
            if d["kind"] == "pull":
                self.start_pull()
            elif d["kind"] == "tear":
                self.island.follow = False
        px, py = d["x0"] + ox, d["y0"] + oy
        d["px"], d["py"] = px, py
        if d["kind"] == "tear":
            self.stretch_panel(d, ox, oy)
        elif d["kind"] == "pull":
            isl = self.island
            isl.tfx, isl.tfy, isl.tfw, isl.tfh = px, py - ORB / 2, float(ORB), float(ORB)
        else:
            self.drag_float(px + d["dx"], py + d["dy"], py)
        self.kick()

    def on_grab_end(self, _g, ox, oy):
        d, self.grab = self.grab, None
        if d is None or not d["moved"]:
            return
        self.input_all = False
        if d["kind"] == "tear":                  # let go before it tore off: it springs back up
            isl = self.island
            isl.stretching = False
            isl.follow = True
            isl.queue_allocate()
        elif d["kind"] == "pull" and self.pulling:
            self.cancel_pull()                   # let go before it snapped off: back in it goes
        elif d["kind"] == "move" or self.floating:
            if self.island.bridge >= CONTACT:    # let go while joined to the edge: it attaches
                self.dock()
            else:                                # not joined: the droplet goes back up into the edge
                self.save_float()
        self.update_input_region()
        self.kick()

    def stretch_panel(self, d, ox, oy):
        """Pulling an open panel down: it stretches like taffy (longer, a little narrower, leaning after the
        pointer), and past TEAR it comes off the edge and floats, still open."""
        isl = self.island
        pull = max(0.0, oy)
        if pull > 95:
            self.tear_off(d)
            return
        # resistance that grows as you pull, so it feels held by the edge until it lets go
        give = 1 - math.exp(-pull / 120)
        isl.stretching = True
        isl.sy = 1 + give * 120 * 0.5 / max(d["h"], 1)
        isl.sx = 1 - give * 0.06

    def tear_off(self, d):
        isl = self.island
        W = isl.get_width()
        # the floating glass starts exactly where the stretched panel is, already moving with the pointer,
        # and springs back to its own shape (scaled, not redrawn, so it stays smooth)
        isl.fvis, isl.goo = True, 0.0
        isl.fx, isl.fy, isl.fw, isl.fh = W / 2, 0.0, isl.w * isl.sx, isl.h * isl.sy
        isl.vfx = isl.vfy = 0.0
        isl.vfw, isl.vfh = 0.0, 0.0
        isl.tfw, isl.tfh = d["w"], d["h"]
        isl.sx = isl.sy = 1.0
        isl.vsx = isl.vsy = 0.0
        isl.stretching = False
        self.floating = isl.floating = True
        # held at the same spot on the panel: its top centre sits where it was, relative to the pointer
        px, py = d["px"], d["py"]
        self.anchor = self.clamp_anchor(W / 2 + (px - d["x0"]), (py - d["y0"]) + ORB / 2)
        d.update(kind="move", dx=self.anchor[0] - px, dy=self.anchor[1] - py)
        isl.tw, isl.th, isl.h = isl.w, 0.0, 0.0     # the edge lets go of it at once
        isl.follow = True
        self.place_float()
        isl.queue_allocate()
        self.after_snap()                          # (Ask keeps the keyboard it has)
        self.kick()

    def start_pull(self):
        """A drop starts to come out of the bottom of the island, on a neck."""
        isl = self.island
        isl.fvis, isl.goo = True, 1.0
        isl.fx, isl.fy, isl.fw, isl.fh = isl.get_width() / 2, max(0.0, isl.h - 36), 36.0, 36.0
        isl.vfx = isl.vfy = isl.vfw = isl.vfh = 0.0
        self.pulling = True

    def flight(self, dt):
        """Each frame of a pull, a snap, a drop going back in or GUY flying home."""
        isl = self.island
        if self.pulling and isl.fy - isl.h > NECK_LEN * 0.92:
            self.snap_off()
        if self.absorbing:
            self.homing(dt)
            return
        self.bridge_reach(dt)
        if self.pulling or self.retracting or self.reaching:
            isl.goo = 1.0
        elif isl.goo > 0:
            isl.goo = max(0.0, isl.goo - dt / 0.16)      # the neck goes thin and lets go
        if self.retracting and isl.fy + isl.fh <= isl.h + 6:
            isl.fvis, isl.goo, self.retracting = False, 0.0, False

    REACH = 60                                   # how near (px from the edge) the edge starts reaching for it

    def bridge_reach(self, dt):
        """Carried near the top edge, the edge and the glass reach for each other and join (bridge_path),
        following how close it is: closer and the neck widens, pull away and it thins and pinches off back
        into a droplet. Let go and the droplet goes back up into the edge."""
        isl = self.island
        if not (isl.fvis and self.floating):
            return
        target = 0.0
        if self.grab and self.grab["moved"]:
            near = max(0.0, 1 - isl.fy / self.REACH)
            target = near * near * (3 - 2 * near)
        if abs(target - isl.bridge) > 0.0005:
            # quick to join, a touch slower to let go, like something sticky
            rate = 16.0 if target > isl.bridge else 9.0
            isl.bridge += (target - isl.bridge) * min(1.0, dt * rate)
            if target == 0.0 and isl.bridge < 0.002:
                isl.bridge = 0.0
            isl.queue_draw()

    def snap_off(self):
        """Pulled far enough: the neck snaps, the island goes back up, and GUY floats."""
        isl = self.island
        self.pulling = False
        self.floating = isl.floating = True
        self.anchor = self.clamp_anchor(isl.tfx, isl.tfy + ORB / 2)
        if self.grab:                            # keep dragging the orb, held where it is under the pointer
            px, py = self.grab.get("px", self.anchor[0]), self.grab.get("py", self.anchor[1])
            self.grab.update(kind="move", dx=self.anchor[0] - px, dy=self.anchor[1] - py)
        isl.vfw += 260.0                          # the snap makes him wobble
        isl.vfh -= 260.0
        isl.tw, isl.th = isl.w, 0.0               # the island retracts into the edge
        self.user_mode = None if self.user_mode == "home" else self.user_mode
        self.hover = False
        self.mode = None                         # whatever it shows now, it shows it in the orb
        self.stack.set_visible(False)
        self.pending = None
        self.apply()
        self.after_snap()

    def after_snap(self):
        """Once the snap has played: let GUY take the keyboard when clicked, and remember he's out. Not in
        the snap's own frame: changing the keyboard mode makes the compositor reconfigure the window, and
        that frame was dropped."""
        def later():
            if self.floating and not self.absorbing:
                if self.mode != "ask":
                    LayerShell.set_keyboard_mode(self.win, LayerShell.KeyboardMode.ON_DEMAND)
                self.save_float()
            return False
        GLib.timeout_add(450, later)

    def cancel_pull(self):
        isl = self.island
        self.pulling, self.retracting = False, True
        isl.tfx, isl.tfy, isl.tfw, isl.tfh = isl.get_width() / 2, max(0.0, isl.h - 30), 30.0, 30.0

    def drag_float(self, x, y, pointer_y):
        """Moving the floating GUY. Near the top edge the island reaches down for him."""
        isl = self.island
        self.anchor = self.clamp_anchor(x, y)
        self.place_float()

    def pop_out(self):
        """`guy --float`: drops out of the top edge and floats, at the last place it floated."""
        if self.floating or self.pulling:
            return
        isl = self.island
        W, H = self.screen()
        try:
            saved = json.loads(FLOAT_STATE.read_text())
            x, y = float(saved.get("x", W * 0.85)), float(saved.get("y", H * 0.3))
        except (OSError, ValueError, TypeError):
            x, y = W * 0.85, H * 0.3
        isl.fvis, isl.goo = True, 0.0
        isl.fx, isl.fy, isl.fw, isl.fh = W / 2, -ORB, float(ORB), float(ORB)
        isl.vfx = isl.vfy = isl.vfw = isl.vfh = 0.0
        self.floating = isl.floating = True
        self.anchor = self.clamp_anchor(x, y)
        isl.tw, isl.th = isl.w, 0.0
        self.mode = None
        self.stack.set_visible(False)
        LayerShell.set_keyboard_mode(self.win, LayerShell.KeyboardMode.ON_DEMAND)
        self.apply()
        self.save_float()

    def dock(self):
        """Back home at the size it is: it rises to the top centre, the edge reaches down and catches it
        with a liquid bridge that spreads across its width, and once it hangs from the edge like the
        island it is the island, and is drawn up into the edge. Driven frame by frame in homing()."""
        if not self.floating or self.absorbing:
            return
        isl = self.island
        self.absorbing = True
        self.reaching = False
        isl.follow = False                       # the page's size no longer steers the glass
        isl.goo = 0.0
        cx = isl.get_width() / 2
        d = math.hypot(isl.fx - cx, isl.fy)
        self.home = {"t": 0.0, "x0": isl.fx, "y0": isl.fy, "b0": isl.bridge,
                     "dur": max(0.3, min(0.6, d / 1400))}
        isl.tw, isl.th = isl.w, 0.0
        self.kick()

    def homing(self, dt):
        isl = self.island
        h = self.home
        h["t"] += dt
        u = min(1.0, h["t"] / h["dur"])
        cx = isl.get_width() / 2
        # across to the middle early, up all the way, quickening at the end as the edge takes it
        ex = 1 - (1 - min(1.0, u * 1.3)) ** 3
        ey = u * u * (3 - 2 * u) * 0.6 + u ** 3 * 0.4
        x = h["x0"] + (cx - h["x0"]) * ex
        top = h["y0"] * (1 - ey)
        self.set_float(x, top, isl.fw, isl.fh)
        # the bridge reaches down once it's within 120 px, and is whole as it touches
        near = max(0.0, 1 - top / self.REACH)
        isl.bridge = max(h["b0"], near * near * (3 - 2 * near))
        isl.queue_draw()
        if u >= 1:
            self.attached()

    def set_float(self, x, top, w, h):
        """Put the floating glass exactly here this frame (the springs just hold it)."""
        isl = self.island
        isl.fx = isl.tfx = x
        isl.fy = isl.tfy = top
        isl.fw = isl.tfw = max(1.0, w)
        isl.fh = isl.tfh = max(1.0, h)
        isl.vfx = isl.vfy = isl.vfw = isl.vfh = 0.0

    def attached(self):
        """It hangs from the edge exactly like the island now, so it becomes the island (same size, same
        page), then the island is drawn up into the edge, the way it always closes."""
        isl = self.island
        self.absorbing = False
        self.home = None
        isl.w = isl.tw = isl.fw
        isl.h = isl.th = isl.fh
        isl.vw = isl.vh = 0.0
        self.floating = isl.floating = False
        isl.fvis, isl.goo, isl.bridge, isl.ring = False, 0.0, 0.0, 0.0
        isl.queue_allocate()
        self.user_mode = None                        # Ask closes as it goes up; the conversation carries on
        self.flash_until = self.linger_until = 0.0
        self.hover = False
        LayerShell.set_keyboard_mode(self.win, LayerShell.KeyboardMode.NONE)
        self.save_float()
        GLib.timeout_add(90, self.apply)             # a beat attached, then up it goes

    def focus_changed(self):
        ring = 1.0 if (self.floating and self.win.is_active() and self.mode != "ask") else 0.0
        if ring != self.island.ring:
            self.island.ring = ring
            self.island.queue_draw()

    def save_float(self):
        try:
            FLOAT_STATE.parent.mkdir(parents=True, exist_ok=True)
            FLOAT_STATE.write_text(json.dumps({"floating": self.floating, "x": self.anchor[0], "y": self.anchor[1]}))
        except OSError:
            pass

    def restore_float(self):
        """Floating when GUY last stopped: float again, where he was."""
        try:
            if json.loads(FLOAT_STATE.read_text()).get("floating"):
                self.pop_out()
        except (OSError, ValueError, AttributeError):
            pass
        return False

    # ----- pointer -----
    def over_target(self, x, y):
        """Is (x, y) over where the island is heading? The shrinking glass keeps its input region
        for a moment, and the catcher unmapping under the pointer sends an enter; neither should
        count as the pointer arriving."""
        isl = self.island
        if self.floating:
            return False
        cx = isl.get_width() / 2
        if isl.th < 1:
            return abs(x - cx) <= HOT_W / 2 and y <= HOT_H + 2
        return abs(x - cx) <= isl.tw / 2 + SHOULDER and y <= isl.th + 4

    def on_enter(self, _c, x, y):
        if self.leave_timer:
            GLib.source_remove(self.leave_timer)
            self.leave_timer = None
        self.pointer = (x, y)
        if not self.hover and self.over_target(x, y):
            self.hover = True
            self.apply()

    def on_motion(self, x, y):
        self.pointer = (x, y)
        if not self.hover:
            self.on_enter(None, x, y)

    def on_leave(self, _c):
        self.pointer = None
        if self.leave_timer:
            GLib.source_remove(self.leave_timer)
        self.leave_timer = GLib.timeout_add(450, self.left)

    def left(self):
        self.leave_timer = None
        self.hover = False
        if self.user_mode == "home":
            self.user_mode = None
        self.apply()
        return False

    def open_home(self):
        if self.user_mode is None:
            self.user_mode = "home"
            if self.news.stale():                # back from sleep, say: fetch, and the row updates itself
                self.news.refresh()
            if self.stocks.stale():
                self.stocks.refresh()
            if self.mail.stale():
                self.mail.refresh()
            self.apply()

    # ----- files dragged onto the island -----
    def on_drag_enter(self, _t, _x, _y):
        self.dragging = True
        self.apply()
        return Gdk.DragAction.COPY

    def on_drag_leave(self, _t):
        GLib.timeout_add(60, self.drag_over)

    def drag_over(self):
        if self.dragging:
            self.dragging = False
            self.apply()
        return False

    def on_drop(self, _t, value, _x, _y):
        self.dragging = False
        files = [f.get_path() for f in value.get_files() if f.get_path()]
        if not files:
            self.apply()
            return False
        self.open_ask(attach=files[0])
        return True

    # ----- Claude Code hooks -----
    def on_hook(self, ev, conn):
        if ev.get("guy_command") == "ask":
            self.toggle_ask()
            return False
        if ev.get("guy_command") == "home":
            self.user_mode = None if self.user_mode == "home" else "home"
            self.apply()
            return False
        if ev.get("guy_command") == "voice":
            self.on_voice(ev)
            return False
        if ev.get("guy_command") == "activity":
            self.on_activity_command(ev)
            return False
        if ev.get("guy_command") == "outfit":
            self.wardrobe.force(ev.get("outfit"))
            return False
        if ev.get("guy_command") == "mail":      # guy --add-mail / --remove-mail changed the accounts
            self.mail.refresh()
            self.mail.start_push()
            return False
        if ev.get("guy_command") == "code":
            self.mail.lookup_code()
            return False
        if ev.get("guy_command") == "float":
            self.dock() if self.floating else self.pop_out()
            return False
        if ev.get("guy_command") == "aside":
            # guy-computer is about to look at or use the screen: hide the panel, let go of the keyboard,
            # and let clicks pass through a floating GUY for a moment
            self.aside_until = time.monotonic() + 4.0
            GLib.timeout_add(4100, self.update_input_region)
            self.agent_status = "using your computer…"
            self.close_ask()
            self.apply()
            return False
        if ev.get("guy_command") == "schedule":
            self.schedule = load_schedule()
            self.apply()
            return False
        if ev.get("guy_agent"):
            # GUY's own assistant wants to do something risky; asked in the Ask panel, on the island, or aloud
            a = Approval(conn, ev, Session("guy-agent", "GUY"))
            self.approvals.append(a)
            self.chime()
            if self.voice_gen == self.claude_gen and self.claude_proc is not None:
                self.speak(f"Can I {a.risk}? Say yes or no.", follow=True)
            self.apply()
            return True
        name = ev.get("hook_event_name", "")
        sid = str(ev.get("session_id") or "?")
        s = self.sessions.get(sid)
        if s is None:
            if name == "SessionEnd":
                return False
            s = self.sessions[sid] = Session(sid, str(ev.get("cwd") or ""))
        s.updated = time.time()
        keep = False
        if name == "SessionStart":
            s.status, s.last = "idle", "Started"
        elif name == "UserPromptSubmit":
            prompt = (str(ev.get("prompt", "")).strip().splitlines() or [""])[0]
            s.status, s.last = "working", f"“{prompt[:90]}”"
        elif name == "PreToolUse" and ev.get("tool_name") == "AskUserQuestion":
            # Claude is asking you something in the terminal: stay out until it's answered
            s.status, s.last = "waiting", "Asks: " + question_text(ev.get("tool_input"))
            self.chime()
        elif name == "PermissionRequest" and ev.get("tool_name") == "AskUserQuestion":
            # not a permission to grant: let the terminal show the question (the relay prints nothing)
            s.status, s.last = "waiting", "Asks: " + question_text(ev.get("tool_input"))
        elif name in ("PreToolUse", "PostToolUse"):
            s.status, s.last = "working", describe_tool(ev.get("tool_name"), ev.get("tool_input"))
        elif name == "PostToolUseFailure":
            s.last = "Failed: " + describe_tool(ev.get("tool_name"), ev.get("tool_input"))
        elif name == "PermissionRequest":
            s.status = "waiting"
            s.last = "Waiting: " + describe_tool(ev.get("tool_name"), ev.get("tool_input"))
            self.approvals.append(Approval(conn, ev, s))
            self.chime()
            keep = True
        elif name == "Notification":
            msg = str(ev.get("message", ""))
            if "waiting for your input" in msg.lower():
                if s.status != "waiting":
                    s.status = "idle"
            elif msg:
                s.last = msg
        elif name == "Stop":
            s.reply = str(ev.get("last_reply") or ev.get("last_assistant_message") or "").strip()
            summary = first_line(s.reply)
            s.status, s.last = "done", summary or "Finished"      # quietly: it's in the overview
        elif name == "StopFailure":
            s.status, s.last = "error", "Stopped with an error"
        elif name == "SessionEnd":
            self.sessions.pop(sid, None)
        self.apply()
        return keep

    def on_hook_gone(self, conn):
        """The relay hung up: answered in the terminal, timed out, or the session ended."""
        before = len(self.approvals)
        self.approvals = [a for a in self.approvals if a.conn is not conn]
        if len(self.approvals) != before:
            self.settle_waiting()
            self.apply()

    def agent_approval(self):
        return next((a for a in self.approvals if a.agent), None)

    def decide(self, decision, approval=None):
        if not self.approvals:
            return
        a = approval if approval in self.approvals else self.approvals[0]
        self.approvals.remove(a)
        if self.server:
            self.server.reply(a.conn, decision)
        self.settle_waiting()
        self.apply()

    def settle_waiting(self):
        waiting = {a.session.id for a in self.approvals}
        for s in self.sessions.values():
            if s.status == "waiting" and s.id not in waiting:
                s.status = "working"

    def chime(self):
        sound = "/usr/share/sounds/freedesktop/stereo/message.oga"
        if os.path.exists(sound) and shutil.which("pw-play"):
            spawn("pw-play", "--volume", "0.5", sound)

    def prune(self):
        now = time.time()
        stale = [sid for sid, s in self.sessions.items()
                 if now - s.updated > (600 if s.status in ("done", "error") else 2700)
                 and not any(a.session is s for a in self.approvals)]
        for sid in stale:
            del self.sessions[sid]
        # finished activities fade from the list after 10 min; a pacman run that went quiet (a sync
        # with nothing to do) after 3
        gone = [k for k, a in self.activities.items()
                if (a.state != "running" and now - a.updated > 600)
                or (a.state == "running" and a.kind == "update" and now - a.updated > 180)
                or (a.state == "running" and a.kind == "custom" and now - a.updated > 3600)]
        for k in gone:
            del self.activities[k]
        if stale or gone:
            self.apply()
        return True

    # ----- Ask GUY -----
    def toggle_ask(self):
        if self.user_mode == "ask":
            self.close_ask()
        else:
            self.open_ask()

    def open_ask(self, attach=None, keep=False):
        if self.user_mode != "ask" and keep and time.monotonic() < self.convo_until:
            self.user_mode = "ask"               # back to the same conversation
            self.apply()
            return
        if self.user_mode != "ask":
            self.apps = load_apps()
            self.windows = load_windows()
            if FILES.stale():
                FILES.build()
            self.icon_by_class = {}
            for a in self.apps:
                self.icon_by_class.setdefault(a["id"].removesuffix(".desktop").lower(), a["icon"])
                if a["wmclass"]:
                    self.icon_by_class.setdefault(a["wmclass"], a["icon"])
            self.history = []
            self.agent_session = None
            self.chat_clear()
            self.entry.set_text("")
            self.set_attachment(None)
            self.show_items([])
            self.set_view("idle")
        self.user_mode = "ask"
        if attach:
            self.set_attachment(attach)
        self.apply()
        self.entry.grab_focus()

    def close_ask(self, explicit=False):
        """Hide the panel. Clicking away (explicit=False) leaves GUY talking, working and listening for a
        follow-up; Esc or "stop" (explicit=True) ends the conversation."""
        if explicit:
            self.voice_send(stop=True)
            self.stop_claude()
            self.convo_until = 0.0
        if self.user_mode == "ask":
            # shrink straight into the small pill (one smooth morph), which then slides up out of
            # sight a moment later unless the pointer is on it
            self.user_mode = None
            self.hover = False
            self.linger_until = time.monotonic() + 1.0
            GLib.timeout_add(1050, self.apply)
            self.apply()

    def enter_ask(self):
        LayerShell.set_keyboard_mode(self.win, LayerShell.KeyboardMode.EXCLUSIVE)
        self.catcher.present()

    def leave_ask(self):
        # floating, GUY takes the keyboard when you click him (so Esc can put him back)
        LayerShell.set_keyboard_mode(self.win, LayerShell.KeyboardMode.ON_DEMAND if self.floating
                                     else LayerShell.KeyboardMode.NONE)
        self.catcher.set_visible(False)

    def set_attachment(self, path):
        self.attachment = path
        self.chip.set_visible(bool(path))
        if path:
            self.chip_label.set_label(os.path.basename(path))
            self.entry.set_placeholder_text("Ask GUY about this file")
            self.refresh(self.entry.get_text())
