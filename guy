class FileIndex:
    """Every file and folder's path in one string, and their lowercased names in another, so a search is
    a few regex scans in C. Built with fd in a thread; new files in the usual folders join it at once."""

    def __init__(self):
        self.data = None           # (paths, their starts, names (file_key, each once), their starts,
        #                            entries in name order, where each name's entries start in that order)
        self.extra = []            # [(path, is_dir)] that appeared since the last build
        self.built = 0.0
        self.building = False
        self.monitors = []
        try:
            with open(FILES_OPENED) as f:
                self.opened_at = json.load(f)    # path -> [times opened, last time]
        except (OSError, ValueError):
            self.opened_at = {}

    def stale(self):
        return time.time() - self.built > FILES_STALE

    def build(self):
        if self.building:
            return False
        self.building = True
        if not self.monitors:
            self.watch()
        threading.Thread(target=self._build, daemon=True).start()
        return False

    def _build(self):
        import array
        import struct
        started = time.time()
        try:
            out = subprocess.run(["nice", "-n", "10", sys.executable, __file__, "--index-files"],
                                 capture_output=True, timeout=120).stdout
            sizes, at, parts = struct.unpack_from("6Q", out), 48, []
        except (OSError, subprocess.SubprocessError, struct.error):
            self.building = False
            return
        for n in sizes:
            parts.append(out[at:at + n])
            at += n
        del out
        if len(parts[0]) > 1:
            for k in (1, 3, 4, 5):
                parts[k] = array.array("I", parts[k])
            self.data = tuple(parts)
            self.extra = [x for x in self.extra if x[2] > started]
            self.built = started
        self.building = False

    def watch(self):
        """New files in the folders you use most join the index right away, rather than at the next build."""
        for sub in FILES_WATCH:
            d = HOME / sub
            if not d.is_dir():
                continue
            try:
                mon = Gio.File.new_for_path(str(d)).monitor_directory(Gio.FileMonitorFlags.WATCH_MOVES, None)
            except GLib.Error:
                continue
            mon.connect("changed", self.changed)
            self.monitors.append(mon)

    def changed(self, _mon, file, other, event):
        E = Gio.FileMonitorEvent
        f = other if event in (E.RENAMED, E.MOVED_IN) and other else file
        if event in (E.CREATED, E.RENAMED, E.MOVED_IN) and f and f.get_path():
            path = f.get_path()
            if os.path.basename(path).startswith((".", "~")) or path.endswith((".part", ".crdownload", ".tmp")):
                return
            self.extra = [x for x in self.extra if x[0] != path] + [(path, os.path.isdir(path), time.time())]

    def opened(self, path):
        n, _last = self.opened_at.get(path, (0, 0))
        self.opened_at[path] = [n + 1, time.time()]
        if len(self.opened_at) > 500:            # keep the 400 most recent
            self.opened_at = dict(sorted(self.opened_at.items(), key=lambda kv: -kv[1][1])[:400])
        try:
            os.makedirs(os.path.dirname(FILES_OPENED), exist_ok=True)
            with open(FILES_OPENED, "w") as f:
                json.dump(self.opened_at, f)
        except OSError:
            pass

    def search(self, query, limit=MAX_FILES):
        """[(score, path, is_dir)], best first. Each word of the query has to be in the path, and at least
        one in the name itself; a name that starts with it, then a word in it that does, rank highest."""
        terms = query.lower().split()
        if not terms or self.data is None and not self.extra:
            return []
        found = {}                               # entry -> (path, is_dir)
        if self.data is not None:
            paths, starts, names, nstarts, order, runs = self.data
            for t in {t for t in terms if len(t) > 1 or len(terms) == 1}:
                tk = file_key(t.encode(errors="surrogateescape"))
                # tiers: the name starts with it, a word in it does, it's anywhere. Literal finds only (a
                # regex that starts with a lookbehind tries every position); a longer word is rare enough to
                # find everywhere in one pass and sort by what's before it, a short one only where it starts
                tiers = ([], [], [])
                needles = [tk] if len(tk) > 2 else [b"\0" + tk, b"\1" + tk]
                for needle in needles:
                    skip = len(needle) - len(tk)         # where the word itself starts, past a \0 or \1
                    pos = names.find(needle)
                    while pos != -1:
                        before = names[pos - 1] if not skip else needle[0]
                        tiers[0 if before == 0 else 1 if before == 1 else 2].append(pos + skip)
                        pos = names.find(needle, pos + len(needle))
                cap = FILES_CAP if len(tk) > 2 else FILES_CAP // 6
                got = 0
                for tier in tiers:
                    if len(tier) > cap:                  # too many to look at: the shortest names first
                        tier.sort(key=lambda pos: names.find(b"\0", pos) - names.rfind(b"\0", 0, pos))
                    for pos in tier:
                        u = bisect.bisect_right(nstarts, pos) - 1
                        for i in order[runs[u]:runs[u + 1]]:
                            if i not in found:
                                path = paths[starts[i]:starts[i + 1] - 1 if i + 1 < len(starts) else -1]
                                found[i] = (path.rstrip(b"/").decode(errors="surrogateescape"), path.endswith(b"/"))
                                got += 1
                        if got >= cap:
                            break
                    if got >= cap:
                        break
        seen = {v[0] for v in found.values()}
        for path, is_dir, _at in self.extra:
            if path not in seen:
                found[path] = (path, is_dir)
        home = str(HOME) + "/"
        words = [re.compile(r"[ _.\-(\[]" + re.escape(t)) for t in terms]
        now = time.time()
        out = []
        for path, is_dir in found.values():
            name = path[path.rfind("/") + 1:].lower()
            stem = name.rsplit(".", 1)[0] if "." in name[1:] else name
            low = None
            total, in_name = 0, False
            for t, word in zip(terms, words):
                if name == t or stem == t:
                    total += 100
                elif name.startswith(t):
                    total += 80
                elif t in name:
                    total += 60 if word.search(name) else 40
                else:
                    low = low or path.lower()
                    if "/" + t in low:
                        total += 20
                    elif t in low:
                        total += 10
                    else:
                        break
                    continue
                in_name = True
            else:
                if not in_name:
                    continue
                rel = path[len(home):] if path.startswith(home) else path
                total -= 4 * rel.count("/") + len(name) / 10 + (8 if "/." in "/" + rel else 0)
                if hit := self.opened_at.get(path):
                    total += min(40, 12 * hit[0]) + (20 if now - hit[1] < 86400 * 3 else 0)
                out.append((total, path, is_dir))
        best = []
        for x in sorted(out, key=lambda x: (-x[0], x[1])):
            if os.path.lexists(x[1]):            # what was deleted since the last build drops out here
                best.append(x)
                if len(best) >= limit:
                    break
        return best


