# GUY only speaks up when Claude needs you, so it only listens for that: permission requests, and
# questions (AskUserQuestion, matched so ordinary tool calls never run the relay). The start and end
# of each turn keep the overview's session list and Claude's last reply current, quietly.
# (event, timeout, matcher); PermissionRequest waits for a click: the relay's decision budget + 10 s
HOOK_EVENTS = [("PermissionRequest", 120, None), ("PreToolUse", 10, "AskUserQuestion"),
               ("PostToolUse", 10, "AskUserQuestion"), ("UserPromptSubmit", 10, None), ("Stop", 10, None),
               ("StopFailure", 10, None), ("SessionEnd", 10, None)]


def _is_ours(entry):
    return isinstance(entry, dict) and any(
        isinstance(h, dict) and HOOK_MARKER in str(h.get("command", "")) for h in entry.get("hooks", []))


def hooks_merged(cfg, install):
    """cfg with GUY's hook entries removed and, when installing, added back. Nothing else changes."""
    cfg = json.loads(json.dumps(cfg))
    hooks = cfg.get("hooks") if isinstance(cfg.get("hooks"), dict) else {}
    for event in list(hooks):
        if isinstance(hooks[event], list):
            kept = [e for e in hooks[event] if not _is_ours(e)]
            if kept or len(kept) == len(hooks[event]):
                hooks[event] = kept
            else:
                del hooks[event]
    if install:
        for event, timeout, matcher in HOOK_EVENTS:
            entry = {"hooks": [{"type": "command", "command": f"{HOOK_BIN} {event}", "timeout": timeout}]}
            if matcher:
                entry = {"matcher": matcher, **entry}
            hooks.setdefault(event, []).append(entry)
    if hooks:
        cfg["hooks"] = hooks
    else:
        cfg.pop("hooks", None)
    return cfg


def hooks_cli(install):
