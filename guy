def sky_for(data):
    """What the sky over you looks like, for orbit to draw: amounts 0-1, sun and moon times in minutes after
    midnight (local time, where you are), and the moon's phase (0 new, 0.5 full)."""
    now, astro = data["current_condition"][0], data["weather"][0]["astronomy"][0]

    def minutes(text):
        try:
            t = time.strptime(text.strip(), "%I:%M %p")
            return t.tm_hour * 60 + t.tm_min
        except ValueError:
            return None                  # "No moonrise" and the like

    code, precip = int(now["weatherCode"]), float(now.get("precipMM") or 0)
    rain, snow = RAIN_AMOUNT.get(code, 0.0), SNOW_AMOUNT.get(code, 0.0)
    if rain:
        rain = max(rain, min(1.0, precip / 6))
    if snow:
        snow = max(snow, min(1.0, precip / 4))
    fog = max(FOG_AMOUNT.get(code, 0.0), max(0.0, min(1.0, (5 - float(now.get("visibility") or 10)) / 5)))
    return {"cloud": float(now.get("cloudcover") or 0) / 100, "rain": rain, "snow": snow, "fog": fog,
            "thunder": code in THUNDER_CODES, "wind": float(now.get("windspeedKmph") or 0),
            "wind_dir": float(now.get("winddirDegree") or 0),
            "sunrise": minutes(astro["sunrise"]), "sunset": minutes(astro["sunset"]),
            "moonrise": minutes(astro["moonrise"]), "moonset": minutes(astro["moonset"]),
            "moon_phase": MOON_PHASES.get(astro.get("moon_phase", "").strip(), 0.5),
            "moon_illum": float(astro.get("moon_illumination") or 0) / 100,
            "temp": float(now.get("temp_C") or 10), "lat": float(data["nearest_area"][0].get("latitude") or 45),
            "lon": float(data["nearest_area"][0].get("longitude") or 0)}


def outfit_for(code, feels_c, month):
    """Rain: raincoat, wellies and umbrella. Snow or 5°C and below: puffer, scarf and bobble hat. 25°C and up:
    t-shirt, shorts and a sun hat; 18°C and up: t-shirt and shorts. In between it's a mild day, dressed for the
    season: a sweater and cap in autumn, a light jacket in spring (and outside those, by how mild)."""
    if code in SNOW_CODES:
        return "cold"
    if code in RAIN_CODES:
        return "rain"
    if feels_c <= 5:
        return "cold"
    if feels_c >= 25:
        return "hot"
    if feels_c >= 18:
        return "sunny"
    if month in (9, 10, 11):
        return "autumn"
    if month in (3, 4, 5):
        return "spring"
    return "autumn" if feels_c <= 12 else "spring"


class Wardrobe:
    """The weather where you are, from wttr.in (which finds you by your IP, as the bar's weather does), and
    whether music is playing; what he wears follows from them."""

    def __init__(self, guy):
        self.guy = guy
        self.weather = "plain"
        self.summary = None
        self.sky = None                # for orbit's sky: see sky_for
        self.forced = None             # `guy --outfit`
        self.music = False
        self.beat = BeatTracker(self)
        self.refresh()
        GLib.timeout_add_seconds(WEATHER_EVERY, self.refresh)

    @property
    def outfit(self):
        return self.forced or self.weather

    def beats(self):
        """Beats since the tracker's reference beat (a float: the fraction is where in the beat we are),
        or None when he isn't dancing."""
        b = self.beat
        if not self.music or not b.bpm:
            return None
        return (time.time() - b.t0) * b.bpm / 60

    def refresh(self):
        def work():
            import urllib.request
            try:
                req = urllib.request.Request("https://wttr.in/?format=j1", headers={"User-Agent": "curl/8"})
                with urllib.request.urlopen(req, timeout=15) as r:
                    data = json.load(r)
                now = data["current_condition"][0]
                outfit = outfit_for(int(now["weatherCode"]), float(now["FeelsLikeC"]), time.localtime().tm_mon)
                summary = f'{now["weatherDesc"][0]["value"].strip()}, {now["temp_C"]}°C'
                sky = sky_for(data)
            except Exception:  # noqa: BLE001 - offline: he keeps on what he's wearing
                return
            GLib.idle_add(self.got, outfit, summary, sky)

        threading.Thread(target=work, daemon=True).start()
        return True

    def got(self, outfit, summary, sky):
        self.weather, self.summary, self.sky = outfit, summary, sky
        self.publish()
        return False

    def force(self, outfit):
        self.forced = outfit if outfit in OUTFITS else None
        self.publish()

    def set_music(self, playing):
        if playing == self.music:
            return
        self.music = playing
        self.beat.start() if playing else self.beat.stop()
        self.publish()

    def publish(self):
        b = self.beat
        look = {"outfit": self.outfit, "headphones": self.music, "weather": self.summary, "sky": self.sky,
                "bpm": round(b.bpm, 2) if self.music and b.bpm else None, "beat": b.t0}
        try:
            tmp = LOOK_FILE.with_suffix(".tmp")
            tmp.write_text(json.dumps(look))
            tmp.replace(LOOK_FILE)
        except OSError:
            pass
        for f in self.guy.faces:
            f.queue_draw()
        return False


class BeatTracker:
    """Finds the beat of whatever is playing so he can dance in time. It listens to what goes to your speakers
    (`parec` on the output's monitor), only while music plays, and only keeps a few seconds of how loud each
    moment was, never the sound itself."""

    RATE, HOP = 11025, 256

    def __init__(self, wardrobe):
        self.wardrobe = wardrobe
        self.proc = None
        self.bpm = None                # None until it hears a steady beat
        self.t0 = 0.0                  # time.time() of a beat

    def start(self):
        if self.proc or not shutil.which("parec"):
            return
        try:
            sink = subprocess.run(["pactl", "get-default-sink"], capture_output=True, text=True,
                                  timeout=2).stdout.strip()
        except (OSError, subprocess.SubprocessError):
            sink = ""
        try:
            self.proc = subprocess.Popen(
                ["parec", "-d", f"{sink}.monitor" if sink else "@DEFAULT_MONITOR@", "--format=s16le",
                 f"--rate={self.RATE}", "--channels=1", "--raw", "--latency-msec=40"],
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, start_new_session=True)
        except OSError:
            self.proc = None
            return
        threading.Thread(target=self.listen, args=(self.proc,), daemon=True).start()

    def stop(self):
        if self.proc:
            self.proc.terminate()
            self.proc = None
        self.bpm = None

    def listen(self, proc):
        import numpy as np
        fps = self.RATE / self.HOP
        keep = int(fps * 8)                       # tempo from the last 8 seconds
        onsets = np.zeros(keep)
        window = np.hanning(2 * self.HOP)
        weight = np.ones(self.HOP + 1)
        # kick drums carry the beat; hi-hats (between the beats) touch every band, so they'd win a plain count:
        # below ~200 Hz weighs as much as everything else together, and above ~4 kHz is left out
        weight[1:10] = 20.0
        weight[190:] = 0.0
        prev_samples = np.zeros(self.HOP, np.float32)
        prev_mag = np.zeros(self.HOP + 1)
        frames = 0
        while True:
            data = proc.stdout.read(self.HOP * 2 * 4)
            if len(data) < self.HOP * 2 * 4:
                break
            arrived = time.time()
            x = np.frombuffer(data, "<i2").astype(np.float32) / 32768
            for hop in x.reshape(4, self.HOP):
                mag = np.log1p(100 * np.abs(np.fft.rfft(np.concatenate([prev_samples, hop]) * window)))
                onsets = np.roll(onsets, -1)
                onsets[-1] = np.sum(np.maximum(mag - prev_mag, 0) * weight)   # spectral flux
                prev_samples, prev_mag = hop, mag
                frames += 1
            if frames >= fps * 4 and frames % int(fps) < 4:
                self.analyse(np, onsets[-min(frames, keep):], fps, arrived)
        if self.proc is proc:
            self.proc = None
            self.bpm = None

    def analyse(self, np, o, fps, end_time):
        """Tempo from the onsets' autocorrelation (leaning towards 120 BPM, where most music sits), then the
        beat's phase from where onsets line up best on that grid."""
        o = o - np.convolve(o, np.ones(11) / 11, "same")
        o = np.maximum(o, 0)
        energy = np.dot(o, o) / len(o)
        if energy < 1e-6:                         # silence: paused audio, or a quiet stretch
            self.bpm = None
            GLib.idle_add(self.wardrobe.publish)
            return
        lags = np.arange(int(fps * 60 / 180), int(fps * 60 / 70) + 2)
        ac = np.array([np.dot(o[k:], o[:-k]) / (len(o) - k) for k in lags])
        bpms = fps * 60 / lags
        score = ac * np.exp(-0.5 * (np.log2(bpms / 120) / 0.7) ** 2)
        i = int(np.argmax(score))
        if ac[i] / energy < 0.12:                 # no clear beat
            self.bpm = None
            GLib.idle_add(self.wardrobe.publish)
            return
        lag = float(lags[i])
        if 0 < i < len(ac) - 1:                   # refine between whole frames
            a, b, c = ac[i - 1], ac[i], ac[i + 1]
            lag += 0.5 * (a - c) / (a - 2 * b + c) if a - 2 * b + c else 0
        bpm = fps * 60 / lag
        offsets = np.arange(int(lag))
        idx = len(o) - 1 - offsets[:, None] - np.round(np.arange(int(len(o) / lag) - 1) * lag).astype(int)[None, :]
        phase = offsets[int(np.argmax(o[np.clip(idx, 0, len(o) - 1)].sum(1)))]
        t0 = end_time - phase / fps - 0.03       # the onset frame centres sit a little before they arrive
        if self.bpm and abs(bpm / self.bpm - 1) < 0.04:
            # the same tempo: settle on it smoothly instead of jumping
            period = 60 / self.bpm
            err = ((t0 - self.t0) / period + 0.5) % 1 - 0.5
            self.bpm = self.bpm * 0.8 + bpm * 0.2
            self.t0 += err * period * 0.35
        else:
            self.bpm, self.t0 = bpm, t0
        GLib.idle_add(self.wardrobe.publish)


