# ---------- things you can just say: volume, music, timers ----------
SINK = "@DEFAULT_AUDIO_SINK@"


def run(*cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=3).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


def get_volume():
    out = run("wpctl", "get-volume", SINK)             # "Volume: 0.50 [MUTED]"
    m = re.search(r"([\d.]+)", out)
    return (round(float(m.group(1)) * 100) if m else None), "MUTED" in out


def fmt_duration(secs):
    secs = int(secs)
    h, m, s = secs // 3600, secs % 3600 // 60, secs % 60
    if h:
        return f"{h}h {m}m" if m else f"{h}h"
    if m:
        return f"{m}m {s}s" if s else f"{m} min"
    return f"{s}s"


def clock(secs):
    secs = max(0, int(round(secs)))
    h, m, s = secs // 3600, secs % 3600 // 60, secs % 60
    return f"{h}:{m:02d}:{s:02d}" if h else f"{m}:{s:02d}"


def parse_duration(text):
    """'25m', '1h 30m', '90 seconds', '10 minutes', '1:30', or a bare number of minutes -> seconds."""
    total, found = 0.0, False
    for num, unit in re.findall(r"(\d+(?:\.\d+)?)\s*(hours?|hrs?|h|minutes?|mins?|m|seconds?|secs?|s)\b", text):
        found = True
        total += float(num) * {"h": 3600, "m": 60, "s": 1}[unit[0]]
    if not found and (m := re.search(r"\b(\d+):(\d{2})\b", text)):
        total, found = int(m[1]) * 60 + int(m[2]), True
    if not found and (m := re.search(r"\b(\d+(?:\.\d+)?)\b", text)):
        total, found = float(m[1]) * 60, True
    return int(total) if found and total > 0 else None


NUMBER_WORDS = {w: i for i, w in enumerate(
    "zero one two three four five six seven eight nine ten eleven twelve thirteen fourteen fifteen sixteen "
    "seventeen eighteen nineteen".split())}
NUMBER_WORDS.update({w: 20 + 10 * i for i, w in enumerate("twenty thirty forty fifty sixty seventy eighty ninety".split())})


def words_to_digits(t):
    """Spoken numbers as digits, for timers and volume: "twenty five minutes" -> "25 minutes"."""
    t = re.sub(r"\bhalf an? hour\b", "30 minutes", t)
    t = re.sub(r"\ban? (hour|minute|second)\b", r"1 \1", t)
    t = re.sub(r"\ba hundred\b|\bone hundred\b", "100", t)

    def compound(m):
        tens, unit = NUMBER_WORDS[m[1]], NUMBER_WORDS.get(m[2] or "", 0)
        return str(tens + unit)
    t = re.sub(r"\b(twenty|thirty|forty|fifty|sixty|seventy|eighty|ninety)(?:[ -](one|two|three|four|five|six|seven|eight|nine))?\b",
               compound, t)
    return re.sub(r"\b(" + "|".join(NUMBER_WORDS) + r")\b", lambda m: str(NUMBER_WORDS[m[1]]), t)


def speakable(text, limit=600):
    """Text as it should sound: no Markdown, code or links; long answers trimmed at a sentence."""
    t = re.sub(r"```.*?```", " I've put the code on screen. ", text, flags=re.S)
    t = re.sub(r"`([^`]*)`", r"\1", t)
    t = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", t)
    t = re.sub(r"https?://\S+", "", t)
    t = re.sub(r"^[#>*•\s-]+", "", t, flags=re.M)
    t = re.sub(r"[*_]{1,2}", "", t)
    t = re.sub(r"(\d)\s*%", r"\1 percent", t)
    t = t.replace("·", ",").replace("♪", "").replace("⏰", "").replace("→", "to")
    t = re.sub(r"\s+", " ", t).strip()
    if len(t) > limit:
        cut = max(t.rfind(". ", 0, limit), t.rfind("? ", 0, limit), t.rfind("! ", 0, limit))
        t = (t[:cut + 1] if cut > 80 else t[:limit]) + " The rest is on screen."
    return t


# the wake phrase as it tends to come out of the recognisers ("a guy", "hey kai", "okay guys")
WAKE_PREFIX = re.compile(r"^\W*(?:\w+\W+)?(?:guys?|guy's|kai|kay|gay|guide?)\b\W*", re.I)   # any one word, then "guy"

VOL_WORDS = r"\b(volume|sound|audio|it|music)\b"
MUSIC = r"(?: (?:the )?(?:one|song|track|music|tune|this(?: song| track| one)?))?"


def intent_one(t):
    """One plain-language command -> (action, argument, what GUY will do), or None."""
    t = re.sub(r"^(?:please |hey guy,? |guy,? |can you |could you |would you |will you |i want to |i wanna |"
               r"i'd like to |id like to |lets |let's |go ahead and |just |now |and )+", "", t).strip()
    t = re.sub(r"(?: please| for me| now| right now| real quick)+$", "", t).strip()
    # ending the conversation / stopping GUY talking
    if re.fullmatch(r"stop talking|shut up|be quiet|quiet|cancel|never ?mind|forget (?:it|about it)|thanks?(?: guy)?|"
                    r"thank you(?: guy)?|(?:ok|okay|cool|great|perfect|awesome)(?:,? thanks?| thank you)?|"
                    r"that(?:s| is) (?:all|it)|nothing|no|nope|no thanks|bye|goodbye|im good|all good", t):
        return "dismiss", None, "Never mind"
    # timers
    if re.search(r"\b(cancel|stop|clear|delete|kill)\b.*\b(timers?|reminders?)\b", t):
        return "timer-cancel", None, "Cancel the timers"
    if re.search(r"\b(timer|remind me|countdown|alarm)\b", t):
        if re.search(r"\bat \d|\b(am|pm|tomorrow|tonight|oclock|o clock|noon|midnight|morning|evening|monday|tuesday|"
                     r"wednesday|thursday|friday|saturday|sunday|every)\b", t):
            return None     # a time of day, not a countdown: GUY's assistant schedules it (guy --remind)
        t = words_to_digits(t)
        secs = parse_duration(t)
        if secs:
            m = re.search(r"\bto (.+)$", t) or re.search(r"\bfor (?!\d)(?!an? )(.+)$", t)
            label = m[1].strip() if m else ""
            label = re.sub(r"\b(in |for )?\d+(\.\d+)?\s*(hours?|hrs?|h|minutes?|mins?|m|seconds?|secs?|s)\b", "", label).strip()
            return "timer", (secs, label), f"Start a {fmt_duration(secs)} timer" + (f": {label}" if label else "")
        return None
    # system update: yay -Syu in a terminal ("update" alone isn't enough, it could be a search)
    if re.fullmatch(r"(?:run |do |start )?(?:an? |the )?(?:system|package|full|arch) (?:update|upgrade)s?(?: now)?"
                    r"|(?:update|upgrade)(?: (?:all|my|the|of|every))*"
                    r" (?:packages?|system|computer|laptop|arch|everything|pc|software|apps|stuff|yay)(?: now)?"
                    r"|(?:check for and )?install(?: the| all| any)? updates"
                    r"|(?:run )?yay(?: -syu)?|(?:run )?(?:sudo )?pacman -syu", t):
        return "update-system", None, "Update packages: yay -Syu in a terminal"
    # volume
    if re.fullmatch(r"(?:un-?mute|unmute (?:the )?(?:sound|volume|audio|it))"
                    r"|(?:enable|turn on|switch on|bring back) (?:the )?(?:sound|audio|volume|speakers?)(?: back)?"
                    r"|(?:turn|put|bring) (?:the )?(?:sound|audio) back on", t):
        return "unmute", None, "Unmute"
    if re.fullmatch(r"(?:mute|mute (?:the )?(?:sound|volume|audio|it|music)|silence)"
                    r"|(?:disable|turn off|switch off|kill|cut|shut off) (?:the )?(?:sound|audio|volume|speakers?)", t):
        return "mute", None, "Mute"
    tn = words_to_digits(t)
    m = re.search(r"\b(?:volume|sound)\b(?: (?:to|at))? (\d{1,3}) ?(?:%|percent)?$", tn) \
        or re.fullmatch(r"(?:set )?volume (\d{1,3}) ?(?:%|percent)?", tn)
    if m:
        return "volume-set", min(100, int(m[1])), f"Set the volume to {min(100, int(m[1]))}%"
    if re.fullmatch(r"(?:max|maximum|full)(?: volume| sound)?|(?:turn |put )?(?:the )?(?:volume|sound|it) (?:all the way )?up to (?:max|maximum|full)", t):
        return "volume-set", 100, "Set the volume to 100%"
    if re.fullmatch(r"half(?: volume)?|(?:set |put )?(?:the )?volume (?:at|to) half", t):
        return "volume-set", 50, "Set the volume to 50%"
    step = 10
    if m := re.search(r"\bby (\d{1,3}) ?(?:%|percent)?", tn):
        step = int(m[1])
    elif re.search(r"\b(a (little )?bit|slightly|a little|a touch)\b", t):
        step = 5
    elif re.search(r"\b(a lot|way)\b", t):
        step = 25
    if re.search(r"\b(lower|decrease|reduce|drop|(?:turn|put|bring) (?:\w+ ){0,3}down|volume down|sound down)\b", t) \
            and re.search(VOL_WORDS, t) \
            or re.search(r"\b(quieter|softer)\b", t):
        return "volume-down", step, f"Turn the volume down {step}%"
    if re.search(r"\b(raise|increase|boost|pump up|crank|(?:turn|put|bring) (?:\w+ ){0,3}up|volume up|sound up)\b", t) \
            and re.search(VOL_WORDS, t) \
            or re.search(r"\blouder\b", t):
        return "volume-up", step, f"Turn the volume up {step}%"
    # music
    if re.fullmatch(r"(?:play |go to |skip to )?(?:the )?(?:next|skip)" + MUSIC + r"|skip(?: (?:it|this))?"
                    r"|(?:change|switch) (?:the |this )?(?:song|track|music|tune)|play (?:something|anything) else"
                    r"|(?:another|a different) (?:song|track|one)|i (?:dont|do not) like this(?: song)?", t):
        return "next", None, "Next track"
    if re.fullmatch(r"(?:play |go (?:back )?to )?(?:the )?(?:previous|prev|last)" + MUSIC + r"|go back(?: a (?:song|track))?"
                    r"|(?:play )?(?:that|this|it|the last one)(?: song| track)? again|replay(?: that| it| the last one)?", t):
        return "previous", None, "Previous track"
    if re.fullmatch(r"(?:pause|stop)(?: (?:the )?(?:music|song|track|it|playback|spotify))?", t):
        return "pause", None, "Pause the music"
    if re.fullmatch(r"(?:play|resume|unpause|continue)(?: (?:the )?(?:music|song|track|it|playback|spotify))?", t):
        return "play", None, "Play"
    if re.fullmatch(r"what(?:s| is)(?: this)?(?: song)? playing|what(?:s| is) this(?: song)?|what song is (?:this|playing)|now playing", t):
        return "whats-playing", None, "What's playing?"
    # opening things: an app (or its window, if it's already open), a folder, a website
    m = re.fullmatch(r"(?:open|launch|start|run|bring up|pull up|switch to|go to|take me to|show me|fire up)(?: up)?"
                     r" (?:the |my |a |an )?(.+?)(?: (?:app|application|program|window))?", t)
    if m and not re.search(r"\b(song|track|music)\b", m[1]):
        return "open", m[1], f"Open {m[1]}"
    return None


FILLER = {"hey", "hi", "a", "uh", "um", "so", "okay", "ok", "oh", "and", "yo", "now", "guy", "guys", "well"}


def command_candidates(text):
    """What was said, and the same without a misheard wake phrase or filler in front ("Hey Kai, skip song")."""
    t = text.strip()
    yield t
    if (m := re.match(r"^([^,.!?]{1,25})[,.!?]\s+(.+)$", t)) and len(m[1].split()) <= 3:
        yield m[2]
    words = t.split()
    while len(words) > 1 and re.sub(r"\W", "", words[0].lower()) in FILLER:
        words = words[1:]
        yield " ".join(words)


def intents(text):
    """Every command in the text ("lower sound and next song"), or None unless all of it is understood."""
    t = re.sub(r"['’]", "", text.lower()).strip().rstrip(".!?")     # "what's" and "whats" alike
    if not t:
        return None
    parts = [p for p in re.split(r"\s*(?:,|;|\band then\b|\bthen\b|\band\b)\s*", t) if p]
    found = [intent_one(p) for p in parts]
    if len(parts) > 1 and all(found):
        return found
    one = intent_one(t)
    return [one] if one else None


def describe_tool(tool, inp):
    """What a Claude Code tool call is doing, in a few words."""
    inp = inp if isinstance(inp, dict) else {}
    path = os.path.basename(str(inp.get("file_path") or inp.get("notebook_path") or ""))
    if tool == "Bash":
        return "$ " + (str(inp.get("command", "")).strip().splitlines() or [""])[0]
    if tool in ("Edit", "MultiEdit", "NotebookEdit"):
        return f"Editing {path}"
    if tool == "Write":
        return f"Writing {path}"
    if tool == "Read":
        return f"Reading {path}"
    if tool in ("Grep", "Glob"):
        return f"Searching {inp.get('pattern', '')}"
    if tool == "WebFetch":
        return f"Fetching {urllib.parse.urlparse(str(inp.get('url', ''))).netloc}"
    if tool == "WebSearch":
        return f"Searching the web for {inp.get('query', '')}"
    if tool in ("Task", "Agent"):
        return f"Delegating: {inp.get('description', '')}"
    return tool or "Working"


def question_text(inp):
    """The first question of an AskUserQuestion call."""
    inp = inp if isinstance(inp, dict) else {}
    qs = inp.get("questions")
    if isinstance(qs, list) and qs and isinstance(qs[0], dict):
        return str(qs[0].get("question") or qs[0].get("header") or "a question")
    return str(inp.get("question") or "a question")


def tool_detail(tool, inp):
    """The part of a permission request worth reading before clicking Allow."""
    inp = inp if isinstance(inp, dict) else {}
    if tool == "Bash":
        return str(inp.get("command", ""))
    for key in ("file_path", "notebook_path", "url", "query", "pattern"):
        if inp.get(key):
            return str(inp[key]).replace(str(HOME), "~", 1)
    return json.dumps(inp, indent=1)[:600]


def age(ts):
    s = time.time() - ts
    return "now" if s < 60 else f"{int(s // 60)}m" if s < 3600 else f"{int(s // 3600)}h"


