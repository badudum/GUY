    # ----- animation -----
    def kick(self):
        if self.tick is None:
            self.last_t = None
            self.tick = self.island.add_tick_callback(self.on_tick)
        return False

    def on_tick(self, _w, clock):
        t = clock.get_frame_time() / 1e6
        dt = min(1 / 30, t - self.last_t) if self.last_t else 1 / 60
        self.last_t = t
        isl = self.island
        # springs, a little underdamped so the glass overshoots and settles like liquid
        k = 240.0
        c = 2 * 0.66 * math.sqrt(k)
        isl.vw += (-k * (isl.w - isl.tw) - c * isl.vw) * dt
        isl.w += isl.vw * dt
        kh = 210.0 if isl.th > isl.h else 300.0
        isl.vh += (-kh * (isl.h - isl.th) - 2 * 0.7 * math.sqrt(kh) * isl.vh) * dt
        isl.h = max(0.0, isl.h + isl.vh * dt)

        if self.pending and isl.alpha <= 0.01:
            self.stack.set_visible_child_name(self.pending)
            self.stack.set_visible(True)
            if self.pending == "ask":
                self.entry.grab_focus()
            self.pending = None
            isl.follow = True
            isl.queue_allocate()
        near = abs(isl.w - isl.tw) < 0.2 * isl.tw + 6 and abs(isl.h - isl.th) < 0.25 * isl.th + 6
        want = 0.0 if (self.pending or self.mode == "hidden") else (1.0 if near else isl.alpha)
        if want < isl.alpha:
            isl.alpha = max(want, isl.alpha - dt / 0.09)
        else:
            isl.alpha = min(want, isl.alpha + dt / 0.22)
        if self.mode == "hidden" and isl.alpha <= 0.01 and self.stack.get_visible():
            self.stack.set_visible(False)
        if self.mode == "hidden":
            isl.alpha = min(isl.alpha, max(0.0, isl.h / max(isl.th + 30, 30)))

        isl.queue_draw()
        self.update_input_region()
        settled = (abs(isl.w - isl.tw) < 0.3 and abs(isl.vw) < 2 and abs(isl.h - isl.th) < 0.3
                   and abs(isl.vh) < 2 and isl.alpha == want and not self.pending)
        if settled:
            isl.w, isl.h, isl.vw, isl.vh = isl.tw, isl.th, 0.0, 0.0
            isl.queue_draw()
            self.update_input_region()
            self.tick = None
            return False
        return True

    def update_input_region(self):
        surf = self.win.get_surface()
        if surf is None:
            return False
        isl = self.island
        cx = SURF_W / 2
        if isl.h < 2 and self.mode == "hidden":
            rect = (cx - HOT_W / 2, 0, HOT_W, HOT_H)
        else:
            s, _r, bulge = isl.geometry()
            rect = (cx - isl.w / 2 - s, 0, isl.w + 2 * s, max(HOT_H, isl.h + bulge))
        surf.set_input_region(cairo.Region(cairo.RectangleInt(*(int(round(v)) for v in rect))))
        return False

    # ----- pointer -----
    def over_target(self, x, y):
        """Is (x, y) over where the island is heading? The shrinking glass keeps its input region
        for a moment, and the catcher unmapping under the pointer sends an enter; neither should
        count as the pointer arriving."""
        isl = self.island
        cx = SURF_W / 2
        if isl.th < 1:
            return abs(x - cx) <= HOT_W / 2 and y <= HOT_H + 2
        return abs(x - cx) <= isl.tw / 2 + SHOULDER and y <= isl.th + 4

    def on_enter(self, _c, x, y):
        if self.leave_timer:
            GLib.source_remove(self.leave_timer)
            self.leave_timer = None
        self.pointer = (x, y)
        if not self.hover and self.over_target(x, y):
            self.hover = True
            self.apply()

    def on_motion(self, x, y):
        self.pointer = (x, y)
        if not self.hover:
            self.on_enter(None, x, y)

    def on_leave(self, _c):
        self.pointer = None
        if self.leave_timer:
            GLib.source_remove(self.leave_timer)
        self.leave_timer = GLib.timeout_add(450, self.left)

    def left(self):
        self.leave_timer = None
        self.hover = False
        if self.user_mode == "home":
            self.user_mode = None
        self.apply()
        return False

    def open_home(self):
        if self.user_mode is None:
            self.user_mode = "home"
            self.apply()

