STOCKS_CONFIG = Path.home() / ".config/guy/stocks.json"
STOCKS_EVERY = 600                # seconds between watchlist refreshes in the background
YF_HEADERS = {"User-Agent": "Mozilla/5.0 (X11; Linux x86_64) GUY/1.0"}
STOCK_WORDS = re.compile(r"\b(stocks?|shares?|share price|stock price|price|quote|ticker|trading at)\b", re.I)
STOCK_FILLER = re.compile(r"\b(what(?:'s| is| are)?|whats|how(?:'s| is)?|hows|the|of|for|on|is|doing|today|now|"
                          r"right now|current|currently|latest|check|show me|look up|get|me|at|stocks?|shares?|"
                          r"share price|stock price|price|quote|ticker|trading)\b", re.I)


def stock_query(text):
    """"google stock", "GOOGL price", "what's tesla trading at", "$NVDA": the company or ticker asked
    about, or None when it isn't about stocks."""
    t = text.strip().rstrip("?!. ")
    if re.fullmatch(r"\$[A-Za-z][A-Za-z.\-]{0,9}", t):
        return t[1:].upper()
    if not STOCK_WORDS.search(t):
        return None
    name = STOCK_FILLER.sub(" ", t.replace("'s ", " ").replace("’s ", " "))
    name = re.sub(r"[^\w .&\-^=]", " ", name)
    name = re.sub(r"\s+", " ", name).strip()
    # a real question about stocks ("how many shares should I buy") is for GUY, not a price lookup
    if len(name.split()) > 3 or re.search(r"\b(i|my|you|we|should|why|when|many|much|buy|sell|did|will|would|can|"
                                          r"invest|worth|best|good)\b", name, re.I):
        return None
    return name or None


def _yf_json(url):
    import urllib.request
    req = urllib.request.Request(url, headers=YF_HEADERS)
    with urllib.request.urlopen(req, timeout=8) as r:
        return json.loads(r.read())


def fetch_quote(symbol):
    """{symbol, name, price, change, pct, currency, exchange, low, high, prev, time} or None."""
    try:
        data = _yf_json("https://query1.finance.yahoo.com/v8/finance/chart/"
                        + urllib.parse.quote(symbol) + "?range=1d&interval=1d")
        m = data["chart"]["result"][0]["meta"]
    except Exception:  # noqa: BLE001 - unknown symbol, offline, rate-limited
        return None
    price = m.get("regularMarketPrice")
    prev = m.get("chartPreviousClose") or m.get("previousClose")
    if price is None:
        return None
    change = price - prev if prev else 0.0
    return {"symbol": m.get("symbol", symbol), "name": m.get("longName") or m.get("shortName") or symbol,
            "price": price, "change": change, "pct": (change / prev * 100) if prev else 0.0,
            "currency": m.get("currency") or "", "exchange": m.get("fullExchangeName") or m.get("exchangeName") or "",
            "low": m.get("regularMarketDayLow"), "high": m.get("regularMarketDayHigh"), "prev": prev,
            "time": m.get("regularMarketTime") or 0}


def search_symbols(name, limit=3):
    try:
        data = _yf_json("https://query1.finance.yahoo.com/v1/finance/search?newsCount=0&quotesCount=8&q="
                        + urllib.parse.quote(name))
    except Exception:  # noqa: BLE001
        return []
    keep = ("EQUITY", "ETF", "INDEX", "CRYPTOCURRENCY", "CURRENCY")
    return [q["symbol"] for q in data.get("quotes", []) if q.get("quoteType") in keep and q.get("symbol")][:limit]


def fmt_price(q):
    p = q["price"]
    digits = 2 if p >= 1 else 4
    arrow = "▲" if q["change"] > 0 else "▼" if q["change"] < 0 else "·"
    return (f"{p:,.{digits}f} {q['currency']}  {arrow} {q['change']:+,.{digits}f} ({q['pct']:+.2f}%)").strip()


def stock_url(symbol):
    return "https://finance.yahoo.com/quote/" + urllib.parse.quote(symbol)


class Stocks:
    """Your watchlist (~/.config/guy/stocks.json: {"watch": ["GOOGL", "AAPL"]}), refreshed every 10
    minutes and when the overview opens on old prices, and lookups for anything you type or say."""

    def __init__(self, guy):
        self.guy = guy
        self.quotes = {}           # symbol -> quote, for the watchlist
        self.fetched = 0.0
        self.busy = False
        self.cache = {}            # lookup name -> (time, [quotes])
        self.waiting = {}          # lookup name -> callbacks, while it's being fetched
        GLib.timeout_add_seconds(20, lambda: self.refresh() and False)
        GLib.timeout_add_seconds(STOCKS_EVERY, self.refresh)

    @staticmethod
    def watchlist():
        try:
            return [str(x).upper() for x in json.loads(STOCKS_CONFIG.read_text()).get("watch", [])]
        except (OSError, ValueError, AttributeError):
            return []

    @staticmethod
    def save_watchlist(symbols):
        STOCKS_CONFIG.parent.mkdir(parents=True, exist_ok=True)
        try:
            cfg = json.loads(STOCKS_CONFIG.read_text())
        except (OSError, ValueError):
            cfg = {}
        cfg["watch"] = symbols
        STOCKS_CONFIG.write_text(json.dumps(cfg, indent=1) + "\n")

    def watch(self, symbol, on=True):
        symbols = [s for s in self.watchlist() if s != symbol.upper()]
        if on:
            symbols.append(symbol.upper())
        self.save_watchlist(symbols)
        self.quotes = {k: v for k, v in self.quotes.items() if k in symbols}
        self.refresh()

    def stale(self):
        return time.time() - self.fetched > 120

    def refresh(self):
        symbols = self.watchlist()
        if self.busy or not symbols:
            if not symbols and self.quotes:
                self.quotes = {}
                self.guy.apply()
            return True
        self.busy = True

        def work():
            got = {}
            for sym in symbols:
                if (q := fetch_quote(sym)) is not None:
                    got[sym] = q
            GLib.idle_add(self.got, got)

        threading.Thread(target=work, daemon=True).start()
        return True

    def got(self, quotes):
        self.busy = False
        if quotes:
            self.quotes.update(quotes)
            self.fetched = time.time()
        self.guy.apply()
        return False

    def lookup(self, name, done):
        """Quotes for a company or ticker, best match first, handed to done(name, quotes) on the main loop."""
        hit = self.cache.get(name.lower())
        if hit and time.time() - hit[0] < 60:
            GLib.idle_add(done, name, hit[1])
            return
        key = name.lower()
        if key in self.waiting:                # already on its way (typing and voice at once)
            self.waiting[key].append(done)
            return
        self.waiting[key] = [done]

        def finished(found):
            for fn in self.waiting.pop(key, []):
                fn(name, found)
            return False

        def work():
            symbols = []
            if re.fullmatch(r"[A-Za-z][A-Za-z.\-^=]{0,9}", name) and (q := fetch_quote(name.upper())):
                found = [q]                      # it's a ticker as typed
                symbols = [q["symbol"]]
            else:
                found = []
            for sym in search_symbols(name):
                if sym not in symbols and len(found) < 3 and (q := fetch_quote(sym)):
                    symbols.append(sym)
                    found.append(q)
            self.cache[key] = (time.time(), found)
            GLib.idle_add(finished, found)

        threading.Thread(target=work, daemon=True).start()


class ProcNames:
    """Which processes are package tools or sudo, cheaply: each new pid's name is read twice (once
    may catch it between fork and exec) and then remembered, so a poll costs a directory listing
    and a few reads instead of parsing every /proc/*/stat (~12 ms)."""

    WANTED = {(n + "\n").encode() for n in PKG_TOOLS + ("sudo",)}

    def __init__(self):
        self.names = {}            # pid -> (comm, confirmed)

    def wanted(self):
        names, seen, found = self.names, {}, False
        for d in os.listdir("/proc"):
            if not d.isdigit():
                continue
            old = names.get(d)
            if old is not None and old[1]:
                comm, sure = old[0], True
            else:
                try:
                    fd = os.open(f"/proc/{d}/comm", os.O_RDONLY)
                except OSError:
                    continue
                try:
                    comm = os.read(fd, 64)
                except OSError:
                    comm = b""
                finally:
                    os.close(fd)
                sure = old is not None and old[0] == comm
            seen[d] = (comm, sure)
            found = found or comm in self.WANTED
        self.names = seen
        return found


class PromptWatcher:
    """Notices yay / pacman / sudo sitting at a terminal waiting for you. A password prompt turns the
    terminal's echo off; a question ([Y/n], a provider number, yay's menus) leaves the package tool in
    the terminal's foreground, asleep, using no CPU at all for a few seconds. Checks /proc every 1.5 s,
    which costs a couple of milliseconds; it does nothing else until a package tool is running."""

    IDLE_POLLS = 3

    def __init__(self, guy):
        self.guy = guy
        self.last = None           # (tty, fg group, cpu) seen on the previous poll
        self.idle = 0
        self.names = ProcNames()
        GLib.timeout_add(1500, self.poll)

    def cmdline(self, pid):
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                return f.read().replace(b"\0", b" ").decode(errors="replace")
        except OSError:
            return ""

    def chain(self, pid, procs):
        seen = []
        while pid in procs and pid > 1 and len(seen) < 64:
            seen.append(pid)
            pid = procs[pid][2]
        return seen

    def is_tool(self, pid, p, procs):
        if p[0] in PKG_TOOLS:
            return True
        if p[0] == "sudo":
            return "pacman" in self.cmdline(pid) or any(procs[a][0] in PKG_TOOLS for a in self.chain(pid, procs)[1:])
        return False

    def outermost(self, pid, procs):
        names = [procs[a][0] for a in self.chain(pid, procs) if procs[a][0] in PKG_TOOLS]
        return names[-1] if names else "sudo"

    def poll(self):
        if not self.names.wanted():            # nothing that could be waiting at a terminal
            self.last, self.idle = None, 0
            self.guy.set_prompt(None)
            return True
        procs = scan_procs()
        tools = [pid for pid, p in procs.items() if self.is_tool(pid, p, procs)]
        found = None
        ttys = {}
        for pid in tools:
            p = procs[pid]
            if p[4] > 0 and p[5] > 0:
                ttys.setdefault(p[4], (pid, p[5]))
        for tty, (tool_pid, fg) in ttys.items():
            members = [(pid, q) for pid, q in procs.items() if q[3] == fg]
            if not members:
                continue
            asleep = all(q[1] == "S" for _pid, q in members)
            cpu = sum(q[6] for _pid, q in members)
            leader = procs.get(fg, members[0][1])[0]
            who = self.outermost(tool_pid, procs)
            if asleep and echo_off(tty):
                found = {"kind": "password", "pid": tool_pid,
                         "text": f"{who} needs your password" if leader == "sudo" else f"{leader} needs a password"}
                break
            key = (tty, fg, cpu)
            self.idle = self.idle + 1 if (asleep and key == self.last) else 0
            self.last = key
            quiet = time.monotonic() - self.guy.pacman.last_line > 3
            if self.idle >= self.IDLE_POLLS and quiet and (leader in PKG_TOOLS or leader == "sudo"):
                found = {"kind": "answer", "pid": tool_pid, "text": f"{who} is waiting for your answer"}
                break
        if not ttys:
            self.last, self.idle = None, 0
        self.guy.set_prompt(found)
        return True


