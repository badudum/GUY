def hooks_merged(cfg, install):
    """cfg with GUY's hook entries removed and, when installing, added back. Nothing else changes."""
    cfg = json.loads(json.dumps(cfg))
    hooks = cfg.get("hooks") if isinstance(cfg.get("hooks"), dict) else {}
    for event in list(hooks):
        if isinstance(hooks[event], list):
            kept = [e for e in hooks[event] if not _is_ours(e)]
            if kept or len(kept) == len(hooks[event]):
                hooks[event] = kept
            else:
                del hooks[event]
    if install:
        for event, timeout, matcher in HOOK_EVENTS:
            entry = {"hooks": [{"type": "command", "command": f"{HOOK_BIN} {event}", "timeout": timeout}]}
            if matcher:
                entry = {"matcher": matcher, **entry}
            hooks.setdefault(event, []).append(entry)
    if hooks:
        cfg["hooks"] = hooks
    else:
        cfg.pop("hooks", None)
    return cfg


def hooks_cli(install):
    try:
        cfg = json.loads(SETTINGS.read_text() or "{}")
    except FileNotFoundError:
        cfg = {}
    except ValueError:
        print(f"{SETTINGS} isn't valid JSON. Fix it first; nothing was changed.")
        return 1
    after = hooks_merged(cfg, install)
    if after == cfg:
        print("Nothing to change.")
        return 0
    after_text = json.dumps(after, indent=2) + "\n"
    print("\n".join(difflib.unified_diff(json.dumps(cfg, indent=2).splitlines(), after_text.splitlines(),
                                         f"{SETTINGS} (now)", f"{SETTINGS} (after)", lineterm="")))
    backup = SETTINGS.with_name(f"settings.json.guy-backup-{time.strftime('%Y%m%d-%H%M%S')}")
    if SETTINGS.exists():
        print(f"\nThe current file will be copied to {backup}")
    if input("Write this? [y/N] ").strip().lower() not in ("y", "yes"):
        print("Nothing written.")
        return 0
    SETTINGS.parent.mkdir(parents=True, exist_ok=True)
    if SETTINGS.exists():
        shutil.copy2(SETTINGS, backup)
    tmp = SETTINGS.with_name("settings.json.guy-tmp")
    tmp.write_text(after_text)
    tmp.replace(SETTINGS)
    print("Done. New Claude Code sessions will report to GUY." if install else "Done. GUY's hooks are gone.")
    return 0


# ---------- calculator ----------
_OPS = {ast.Add: operator.add, ast.Sub: operator.sub, ast.Mult: operator.mul, ast.Div: operator.truediv,
        ast.FloorDiv: operator.floordiv, ast.Mod: operator.mod, ast.Pow: operator.pow,
        ast.USub: operator.neg, ast.UAdd: operator.pos}
_NAMES = {k: getattr(math, k) for k in ("pi", "e", "tau", "sqrt", "sin", "cos", "tan", "log", "log10",
                                         "log2", "exp", "floor", "ceil", "factorial", "radians", "degrees")}
_NAMES.update(abs=abs, round=round)


def _eval(n):
    if isinstance(n, ast.Constant) and isinstance(n.value, (int, float)) and not isinstance(n.value, bool):
        return n.value
    if isinstance(n, ast.BinOp) and type(n.op) in _OPS:
        left, right = _eval(n.left), _eval(n.right)
        if isinstance(n.op, ast.Pow) and abs(right) > 1000:
            raise ValueError("exponent too large")
        return _OPS[type(n.op)](left, right)
    if isinstance(n, ast.UnaryOp) and type(n.op) in _OPS:
        return _OPS[type(n.op)](_eval(n.operand))
    if isinstance(n, ast.Name) and n.id in _NAMES and not callable(_NAMES[n.id]):
        return _NAMES[n.id]
    if isinstance(n, ast.Call) and isinstance(n.func, ast.Name) and callable(_NAMES.get(n.func.id)) and not n.keywords:
        args = [_eval(a) for a in n.args]
        if n.func.id == "factorial" and any(abs(a) > 1000 for a in args):
            raise ValueError("factorial too large")
        return _NAMES[n.func.id](*args)
    raise ValueError("unsupported")


def calculate(text):
    expr = text.strip().lstrip("=").replace("^", "**").replace("×", "*").replace("÷", "/")
    expr = re.sub(r"(?<=\d),(?=\d{3}(?!\d))", "", expr)
    if not re.search(r"\d|pi|tau", expr) or not re.search(r"[+\-*/%(]", expr):
        return None
    if not re.fullmatch(r"[\w\s.+\-*/%(),]+", expr):
        return None
    try:
        val = _eval(ast.parse(expr, mode="eval").body)
    except (SyntaxError, ValueError, TypeError, ZeroDivisionError, OverflowError):
        return None
    if isinstance(val, float):
        if val != val or val in (float("inf"), float("-inf")):
            return None
        if val.is_integer() and abs(val) < 1e15:
            val = int(val)
    return f"{val:,.10g}".replace(",", " ") if isinstance(val, float) else f"{val:,}".replace(",", " ")


# ---------- markdown -> pango ----------
def _inline(text):
    parts = text.split("`")
    out = []
    for i, part in enumerate(parts):
        esc = GLib.markup_escape_text(part)
        if i % 2 == 1 and i < len(parts) - 1:
            out.append(f'<span font_family="monospace" background="#ffffff1c"> {esc} </span>')
            continue
        if i % 2 == 1:
            esc = "`" + esc
        esc = re.sub(r"\*\*(.+?)\*\*", r"<b>\1</b>", esc)
        esc = re.sub(r"(?<![\w*])\*(?!\s)(.+?)(?<!\s)\*(?![\w*])", r"<i>\1</i>", esc)
        out.append(esc)
    return "".join(out)


def md_to_markup(text):
    lines, in_code = [], False
    for line in text.split("\n"):
        if line.strip().startswith("```"):
            in_code = not in_code
            continue
        if in_code:
            lines.append(f'<span font_family="monospace" background="#ffffff14">{GLib.markup_escape_text(line)}</span>')
            continue
        if m := re.match(r"^#{1,6}\s+(.*)", line):
            lines.append(f"<b>{_inline(m.group(1))}</b>")
        elif m := re.match(r"^(\s*)[-*+]\s+(.*)", line):
            lines.append(f"{m.group(1)}•  {_inline(m.group(2))}")
        else:
            lines.append(_inline(line))
    return "\n".join(lines)


