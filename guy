            cr.clip()
            for k in (-1, 1):                               # white panels
                cr.move_to(ux, uy - ry * 1.1)
                cr.line_to(ux + k * rx * 0.25, uy + ry)
                cr.line_to(ux + k * rx * 0.75, uy + ry)
                cr.close_path()
            cr.set_source_rgb(0.96, 0.95, 0.92)
            cr.fill()
            cr.restore()


# ---------- the island: a liquid-glass shape hanging from the top edge ----------
def squircle_corner(cr, cx, cy, r, t0, t1, steps=14):
    """A quarter superellipse like Hyprland's rounding_power corners, from angle t0 to t1."""
    for i in range(steps + 1):
        t = t0 + (t1 - t0) * i / steps
        c, n = math.cos(t), math.sin(t)
        cr.line_to(cx + math.copysign(abs(c) ** (2 / GLASS["power"]), c) * r,
                   cy + math.copysign(abs(n) ** (2 / GLASS["power"]), n) * r)


def island_path(cr, L, R, h, s, r, bulge, closed=True):
    cx = (L + R) / 2
    cr.move_to(L - s, 0)
    cr.arc(L - s, s, s, -math.pi / 2, 0)                  # concave shoulder into the screen edge
    cr.line_to(L, h - r)
    squircle_corner(cr, L + r, h - r, r, math.pi, math.pi / 2)
    cr.curve_to((L + r + cx) / 2, h + bulge, (R - r + cx) / 2, h + bulge, R - r, h)   # the drip
    squircle_corner(cr, R - r, h - r, r, math.pi / 2, 0)
    cr.line_to(R, s)
    cr.arc(R + s, s, s, math.pi, math.pi * 1.5)
    if closed:
        cr.close_path()


def float_path(cr, x, y, w, h, r, closed=True):
    """A free-floating piece of glass: the same squircle corners on all four sides (an orb when it's square
    and r is half its size)."""
    r = max(0.0, min(r, w / 2, h / 2))
    cr.new_sub_path()
    if r >= min(w, h) / 2 - 0.01:                # an orb (or a pill): round, like a drop
        cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
        cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
        cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
        cr.arc(x + r, y + r, r, math.pi, math.pi * 1.5)
        cr.close_path()
        return
    squircle_corner(cr, x + r, y + r, r, math.pi, math.pi * 1.5)
    squircle_corner(cr, x + w - r, y + r, r, -math.pi / 2, 0)
    squircle_corner(cr, x + w - r, y + h - r, r, 0, math.pi / 2)
    squircle_corner(cr, x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.close_path()


def goo_path(cr, L, R, h, s, r, ox, oy, ow, oh, nw, closed=True):
    """The island and a drop of it on a neck, as one outline: what you see while pulling GUY out or
    while he's being drawn back in. (ox, oy) is the drop's top centre, nw how thick the neck is."""
    rr = min(ow, oh) / 2
    cx = max(L + r + nw / 2, min(R - r - nw / 2, ox))
    mid = max(oy + oh / 2, h + 3)               # never above the island's edge: the outline would cross itself
    span = max(1.0, mid - h)
    cr.move_to(L - s, 0)
    cr.arc(L - s, s, s, -math.pi / 2, 0)
    cr.line_to(L, h - r)
    squircle_corner(cr, L + r, h - r, r, math.pi, math.pi / 2)
    cr.line_to(cx - nw / 2, h)
    cr.curve_to(cx - nw / 2, h + span * 0.45, ox - rr, mid - span * 0.45, ox - rr, mid)
    cr.arc_negative(ox, mid, rr, math.pi, 0)     # round underneath, like a drop
    cr.curve_to(ox + rr, mid - span * 0.45, cx + nw / 2, h + span * 0.45, cx + nw / 2, h)
    cr.line_to(R - r, h)
    squircle_corner(cr, R - r, h - r, r, math.pi / 2, 0)
    cr.line_to(R, s)
    cr.arc(R + s, s, s, math.pi, math.pi * 1.5)
    if closed:
        cr.close_path()


CONTACT = 0.2                     # how far along a bridge (0..1) the two bodies touch


def bridge_path(cr, x, y, w, h, r, b, closed=True):
    """Floating glass (x, y, w, h, corner r) being taken back by the top edge, as liquid, b from 0 to 1.
    Before they touch (b < CONTACT) both reach for each other: a droplet sags from the edge and the glass's
    top swells into a mound. They meet in the middle and a thin neck pinches in, waisted like an
    hourglass, with wide feet where it meets each surface; the waist widens, the feet spread across the
    top, the top corners melt away, and at b = 1 (with y = 0) it is the docked island exactly: the edge's
    shoulders running into its sides."""
    cx = x + w / 2
    S = SHOULDER

    def smooth(t):
        t = max(0.0, min(1.0, t))
        return t * t * (3 - 2 * t)

    q = smooth(b / CONTACT)                      # reaching, before contact
    m = smooth((b - CONTACT) / (1 - CONTACT)) if b > CONTACT else 0.0   # merging, after
    rt = r * (1 - m)                             # its top corners, melting
    rb = r + (min(RADIUS, h / 2, w / 2) - r) * m ** 4   # its bottom corners: still a drop until the very end
    round_ = r >= min(w, h) / 2 - 0.01          # an orb keeps round corners while its radius eases

    def corner(ccx, ccy, rad, t0, t1):
        if rad <= 0.01:
            cr.line_to(ccx + math.cos(t1) * rad, ccy + math.sin(t1) * rad)
        elif round_:
            (cr.arc if t1 > t0 else cr.arc_negative)(ccx, ccy, rad, t0, t1)
        else:
            squircle_corner(cr, ccx, ccy, rad, t0, t1)

    def body(top_left_to, top_right_from):
        """The glass below its top edge: from the top-left corner round to the top-right corner."""
        top_left_to()
        if rt > 0.01:
            cr.arc_negative(x + rt, y + rt, rt, -math.pi / 2, -math.pi)
        cr.line_to(x, y + h - rb)
        corner(x + rb, y + h - rb, rb, math.pi, math.pi / 2)
        cr.line_to(x + w - rb, y + h)
        corner(x + w - rb, y + h - rb, rb, math.pi / 2, 0)
        cr.line_to(x + w, y + rt)
        if rt > 0.01:
            cr.arc_negative(x + w - rt, y + rt, rt, 0, -math.pi / 2)
        top_right_from()

    if b < CONTACT:
        # a flat top swells up into a mound to meet the droplet; a round one (the orb) can't, so the
        # droplet reaches all the way down to it instead
        mound = (w / 2 - rt) >= 14
        # the edge's droplet, sagging toward it
        depth = y * (0.5 if mound else 1.0) * q
        dw = 12 + 18 * q
        if depth > 0.5:
            cr.move_to(cx - dw - S * q, 0)
            cr.curve_to(cx - dw * 0.7, 0, cx - dw * 0.62, depth, cx, depth)     # a round bottom, like a drop
            cr.curve_to(cx + dw * 0.62, depth, cx + dw * 0.7, 0, cx + dw + S * q, 0)
            if closed:
                cr.close_path()
        # the glass, its top swelling up to meet it
        rise = y * 0.5 * q if mound else 0.0
        mw = min(w / 2 - rt, 14 + 18 * q) if mound else 0.0
        cr.new_sub_path()
        cr.move_to(cx, y - rise)

        def left():
            if mw > 0.5:
                cr.curve_to(cx - mw * 0.62, y - rise, cx - mw * 0.7, y, cx - mw, y)
            cr.line_to(x + rt, y)

        def right():
            cr.line_to(cx + mw, y)
            if mw > 0.5:
                cr.curve_to(cx + mw * 0.7, y, cx + mw * 0.62, y - rise, cx, y - rise)

        body(left, right)
        cr.close_path()
        return

    # joined: an hourglass neck from the edge to the glass
    ww = min(w - 2 * rt, 6 + (w - 6) * m ** 1.6)            # the waist
    ym = max(S * m, y * 0.5 * (1 - m) + min(y, S) * m)      # its height
    st = min(ww / 2 + S + 18 * (1 - m), w / 2 + S + 18)     # the foot on the edge
    sp = min(ww / 2 + 20 * (1 - m), w / 2 - rt)             # the foot on the glass
    cr.move_to(cx - st, 0)
    cr.curve_to(cx - st + (st - ww / 2) * 0.55, 0, cx - ww / 2, ym * 0.45, cx - ww / 2, ym)

    def left():
        if y > ym + 0.5:
            cr.curve_to(cx - ww / 2, ym + (y - ym) * 0.55, cx - sp + (sp - ww / 2) * 0.55, y, cx - sp, y)
            cr.line_to(x + rt, y)
        else:                                    # the glass's top is up inside the neck: straight down its side
            cr.line_to(x, max(ym, y + rt))

    def right():
        if y > ym + 0.5:
            cr.line_to(cx + sp, y)
            cr.curve_to(cx + sp - (sp - ww / 2) * 0.55, y, cx + ww / 2, ym + (y - ym) * 0.55, cx + ww / 2, ym)
        else:
            cr.line_to(cx + ww / 2, ym)

    body(left, right)
    cr.curve_to(cx + ww / 2, ym * 0.45, cx + st - (st - ww / 2) * 0.55, 0, cx + st, 0)
    if closed:
        cr.close_path()


_SCREEN_SCALE = [1.25]            # the screen's scale, kept up to date by the island


try:
    import numpy as np
except ImportError:                       # optional: without it the glass is drawn the slower way
    np = None


def _gauss(a, sigma):
    """A Gaussian blur (three box blurs) of a 2-D float array, sigma in pixels."""
    if sigma < 0.4:
        return a
    r = max(1, int(round((math.sqrt(4 * sigma * sigma + 1) - 1) / 2)))
    n = 2 * r + 1
    for _ in range(3):
        c = np.cumsum(np.pad(a, ((0, 0), (r + 1, r))), axis=1, dtype=np.float32)
        a = (c[:, n:] - c[:, :-n]) / n
        c = np.cumsum(np.pad(a, ((r + 1, r), (0, 0))), axis=0, dtype=np.float32)
        a = (c[n:, :] - c[:-n, :]) / n
    return a


def _surface(rect, sc, fmt=cairo.FORMAT_ARGB32):
    """A surface covering rect (x, y, w, h) at sc pixels per point, its origin on that pixel grid."""
    x0, y0 = math.floor(rect[0] * sc), math.floor(rect[1] * sc)
    pw = max(1, math.ceil((rect[0] + rect[2]) * sc) - x0)
    ph = max(1, math.ceil((rect[1] + rect[3]) * sc) - y0)
    img = cairo.ImageSurface(fmt, pw, ph)
    c = cairo.Context(img)
    c.scale(sc, sc)
    c.translate(-x0 / sc, -y0 / sc)
    return img, c, Graphene.Rect().init(x0 / sc, y0 / sc, pw / sc, ph / sc)


def _alpha(img):
    img.flush()
    return np.frombuffer(img.get_data(), np.uint8).reshape(img.get_height(), img.get_stride())[:, :img.get_width()]


def _texture(img, fmt=Gdk.MemoryFormat.B8G8R8A8_PREMULTIPLIED):
    img.flush()
    return Gdk.MemoryTexture.new(img.get_width(), img.get_height(), fmt, GLib.Bytes.new(bytes(img.get_data())),
                                 img.get_stride())


def _alpha_texture(a, white):
    """An ARGB texture from an alpha array in 0..1: black (a shadow) or white (a glow)."""
    a8 = (np.clip(a, 0, 1) * 255).astype(np.uint8)
    h, w = a8.shape
    px = np.empty((h, w, 4), np.uint8)
    px[..., 3] = a8
    px[..., :3] = a8[..., None] if white else 0
    return Gdk.MemoryTexture.new(w, h, Gdk.MemoryFormat.B8G8R8A8_PREMULTIPLIED, GLib.Bytes.new(px.tobytes()), w * 4)


def draw_glass(snap, path, bbox, fade=None, fast=False, ring=0.0):
    """The glass along `path` (a function drawing the outline: path(cr, closed)), inside `bbox`
    (x, y, w, h), as a few textures the GPU stacks:
      - the drop shadow: the shape blurred (sigma 23) at 1/6 resolution,
      - the glass: its fill, its 1px rim, and the crisp strip of shadow just under it, at full resolution,
      - the inner glow: the rim blurred inward, at 1/2 resolution,
    with the shadow and glow cut off at the glass by a full-resolution mask, so their edges are exact.
    Blurring a filled shape is ~1-2 ms where stroking the falloff was 7-10; tuned to match the old look
    (kitty's glass) to within a fraction of a level of 255. fade: fade the shadow out toward the top edge
    over that many pixels (glass hanging from the edge); None for glass floating free. ring: a brighter
    rim, for a floating GUY that has the keyboard. (fast is unused: this is quick at full quality.)"""
    if np is None:
        return _draw_glass_strokes(snap, path, bbox, fade, ring)
    g = GLASS
    bx, by, bw, bh = bbox
    S = _SCREEN_SCALE[0]
    off = g["shadow_offset"]

    # the glass's shape at full resolution: cuts the shadow off exactly at the glass (one GPU mask; the
    # graphics card here is quick at textures and slow at blurs and stacked masks rebuilt every frame)
    grect = (bx - 2, by - 2, bw + 4, bh + 4 + off)
    img, c, shape_rect = _surface(grect, S, cairo.FORMAT_A8)
    path(c, True)
    c.fill()
    del c
    shape = _texture(img, Gdk.MemoryFormat.A8)

    # the soft shadow: the shape blurred (sigma 23) at 1/6 resolution
    pad = g["shadow_range"] + 6
    low = S / 6
    img, c, low_rect = _surface((bx - pad, by - pad, bw + 2 * pad, bh + 2 * pad + off), low, cairo.FORMAT_A8)
    c.translate(0, off)
    path(c, True)
    c.fill()
    del c
    a = 0.58 * _gauss(_alpha(img).astype(np.float32) / 255, 23 * low)
    if fade:
        # hanging from the top edge: faded out toward the bar so it doesn't smudge it
        ys = low_rect.get_y() + (np.arange(a.shape[0]) + 0.5) / low
        a *= np.clip(ys / max(fade, 24), 0, 1)[:, None]
    snap.push_mask(Gsk.MaskMode.INVERTED_ALPHA)
    snap.append_texture(shape, shape_rect)
    snap.pop()
    snap.append_texture(_alpha_texture(a, False), low_rect)
    snap.pop()

    # the glass, as one full-resolution texture: the crisp strip of shadow just under it, its fill (the
    # terminal's background colour at the terminal's opacity, blurred by Hyprland), the inner glow, the rim
    img, c, rect = _surface(grect, S)
    c.save()
    c.translate(0, off)
    path(c, True)
    c.restore()
    if fade:
        grad = cairo.LinearGradient(0, 0, 0, max(fade, 24))
        grad.add_color_stop_rgba(0, 0, 0, 0, 0)
        grad.add_color_stop_rgba(1, 0, 0, 0, 0.26)
        c.set_source(grad)
    else:
        c.set_source_rgba(0, 0, 0, 0.26)
    c.fill()
    c.set_operator(cairo.OPERATOR_DEST_OUT)
    path(c, True)
    c.set_source_rgba(0, 0, 0, 1)
    c.fill()
    c.set_operator(cairo.OPERATOR_OVER)
    path(c, True)
    c.set_source_rgba(*g["fill"])
    c.fill_preserve()
    c.clip()
    c.set_line_join(cairo.LINE_JOIN_BEVEL)
    for half_width, alpha in GLOW_BANDS:         # white at the rim, fading inward
        path(c, False)
        c.set_source_rgba(1, 1, 1, alpha)
        c.set_line_width(2 * half_width)
        c.stroke()
    c.reset_clip()
    path(c, False)
    c.set_source_rgba(1, 1, 1, g["rim_alpha"] + 0.36 * ring)
    c.set_line_width(1.0 + ring)
    c.stroke()
    del c
    snap.append_texture(_texture(img), rect)


GLOW_BANDS = ((7.0, 0.042), (4.0, 0.035), (1.5, 0.025))   # (reach inward, alpha): tuned to the old glow
def outline(c, path):
    """The outline, closed and open, built once on this context and kept: drawing the glass strokes it
    ~30 times, and rebuilding the squircle corners in Python each time was a third of the cost."""
    c.new_path()
    path(c, True)
    closed = c.copy_path()
    c.new_path()
    path(c, False)
    open_ = c.copy_path()
    c.new_path()
    return closed, open_


def glass_layer(snap, rect, div, draw):
    """Draw onto a texture covering rect (x, y, w, h) at 1/div of the screen's resolution and append it.
    Its origin sits on the screen's pixel grid, so a full-resolution layer is never resampled (its 1px rim
    stays crisp); a reduced one is scaled up smoothly by the GPU."""
    sc = _SCREEN_SCALE[0] / div
    x0, y0 = math.floor(rect[0] * sc), math.floor(rect[1] * sc)
    x1, y1 = math.ceil((rect[0] + rect[2]) * sc), math.ceil((rect[1] + rect[3]) * sc)
    pw, ph = max(1, x1 - x0), max(1, y1 - y0)
    img = cairo.ImageSurface(cairo.FORMAT_ARGB32, pw, ph)
    c = cairo.Context(img)
    c.scale(sc, sc)
    c.translate(-x0 / sc, -y0 / sc)
    draw(c)
    del c
    img.flush()
    texture = Gdk.MemoryTexture.new(pw, ph, Gdk.MemoryFormat.B8G8R8A8_PREMULTIPLIED,
                                    GLib.Bytes.new(bytes(img.get_data())), img.get_stride())
    snap.append_texture(texture, Graphene.Rect().init(x0 / sc, y0 / sc, pw / sc, ph / sc))


def _draw_glass_strokes(snap, path, bbox, fade=None, ring=0.0):
    """The glass drawn with strokes (the fallback without numpy): as three textures the GPU stacks: the drop shadow at 1/3 resolution, the glass and its
    1px rim at full resolution, and the inner glow at 1/2. The shadow and glow are soft falloffs made of
    wide strokes, the slow part to draw (5-10 ms at full size); at reduced size they're under a
    millisecond and look the same. fade: fade the shadow out toward the top edge over that many pixels
    (glass hanging from the edge); None for glass floating free. ring: a brighter rim, for a floating GUY
    that has the keyboard."""
    g = GLASS
    bx, by, bw, bh = bbox

    def shade(d):
        return g["shadow_alpha"] * max(0.0, 1 - d / g["shadow_range"]) ** g["shadow_power"]

    def shadow(c):
        closed, _open = outline(c, path)
        c.save()
        c.translate(0, g["shadow_offset"])
        # bevel joins: on an outline this smooth they look the same as round ones, and round ones were
        # most of the cost of these wide strokes
        c.set_line_join(cairo.LINE_JOIN_BEVEL)
        c.append_path(closed)
        c.set_source_rgba(0, 0, 0, shade(0))
        c.fill()
        steps = 13
        step = g["shadow_range"] / steps
        for k in range(1, steps + 1):
            d = step * k
            c.append_path(closed)
            c.set_source_rgba(0, 0, 0, shade(d - step) - shade(d))
            c.set_line_width(2 * d)
            c.stroke()
        c.restore()
        # outside the glass only
        c.set_operator(cairo.OPERATOR_DEST_OUT)
        c.append_path(closed)
        c.set_source_rgba(0, 0, 0, 1)
        c.fill()
        if fade:
            # hanging from the top edge: faded out toward the bar so it doesn't smudge it
            c.set_operator(cairo.OPERATOR_DEST_IN)
            grad = cairo.LinearGradient(0, 0, 0, max(fade, 24))
            grad.add_color_stop_rgba(0, 0, 0, 0, 0)
            grad.add_color_stop_rgba(1, 0, 0, 0, 1)
            c.set_source(grad)
            c.paint()

    pad = g["shadow_range"] + 4
    glass_layer(snap, (bx - pad, by - pad, bw + 2 * pad, bh + 2 * pad + g["shadow_offset"]), 3, shadow)

    def glass(c):
        # the terminal's background colour at the terminal's opacity, blurred by Hyprland; and the 1px rim
        closed, open_ = outline(c, path)
        c.append_path(closed)
        c.set_source_rgba(*g["fill"])
        c.fill()
        c.append_path(open_)
        c.set_source_rgba(1, 1, 1, g["rim_alpha"] + 0.36 * ring)
        c.set_line_width(1.0 + ring)
        c.stroke()

    glass_layer(snap, (bx - 2, by - 2, bw + 4, bh + 4), 1, glass)

    def glow(d):
        return g["glow_alpha"] * max(0.0, 1 - d / g["glow_range"]) ** g["glow_power"]

    def glows(c):
        # white at the rim fading to nothing, the same falloff as the terminal's lit edge
        closed, open_ = outline(c, path)
        c.append_path(closed)
        c.clip()
        c.set_line_join(cairo.LINE_JOIN_BEVEL)
        for k in range(int(g["glow_range"]), 0, -1):
            c.append_path(open_)
            c.set_source_rgba(1, 1, 1, glow(k - 1) - glow(k))
            c.set_line_width(2 * k)
            c.stroke()

    glass_layer(snap, (bx - 1, by - 1, bw + 2, bh + 2), 2, glows)


ORB = 64                          # a floating GUY, pulled out of the island
NECK_LEN = 150                    # how far a drop stretches on its neck before it snaps off
NECK_W = 46                       # the neck's thickness where it leaves the island


class Island(Gtk.Widget):
    """All of GUY's glass. It fills the screen (click-through outside the glass) so it can be anywhere:
    hanging from the top edge (w, h, the "dock"), floating free (fx, fy, fw, fh: centre x, top, size),
    or both at once, joined by a neck, while he's pulled out or drawn back in. The pages are shown
    in whichever one is home (`floating`)."""
    __gtype_name__ = "GuyIsland"

    def __init__(self, content):
        super().__init__()
        self.content = content
        content.set_parent(self)
        self.w, self.h, self.vw, self.vh = float(HIDDEN_W), 0.0, 0.0, 0.0
        self.tw, self.th = float(HIDDEN_W), 0.0
        # the floating glass and where it's heading
        self.fx = self.fy = self.fw = self.fh = 0.0
        self.vfx = self.vfy = self.vfw = self.vfh = 0.0
        self.tfx = self.tfy = self.tfw = self.tfh = 0.0
        self.fvis = False        # there is floating glass
        self.floating = False    # the pages live in the floating glass
        self.goo = 0.0           # how joined the two are (the neck), 0..1
        self.bridge = 0.0        # the floating glass caught by the top edge, 0..1 (see bridge_path)
        self.ring = 0.0          # brighter rim: the floating GUY has the keyboard
        # taffy: an open panel being pulled down stretches (the dock's glass scaled from the top edge)
        self.sx = self.sy = 1.0
        self.vsx = self.vsy = 0.0
        self.stretching = False  # the pointer holds the stretch; when False it springs back to 1
        self.alpha = 0.0
        self.follow = False      # the target height tracks the content's natural height
        self.on_target = None    # called when following changes the target
        # the glass as last drawn, one render node per piece: GTK re-snapshots the island whenever anything
        # inside it redraws (the penguin, 30-60 times a second), and drawing a panel's glass takes a few ms,
        # so each piece is drawn at the origin, cached by its shape, and only moved (or, for small changes
        # of size like a wobble or a stretch, scaled) from frame to frame
        self.nodes = {}
        self.animating = False   # the springs are running: the quick glass; full quality once they stop

    def geometry(self):
        s = min(SHOULDER + min(abs(self.vw) * 0.006, 8), self.h / 2)
        r = max(0.0, min(RADIUS, self.h / 2, self.w / 2))
        # it drips a little as it grows; going away it just retracts, straight up
        bulge = min(self.vh * 0.012, BULGE_MAX) if self.h > 8 and self.vh > 0 and not self.fvis else 0.0
        return s, r, bulge

    def float_rect(self):
        return self.fx - self.fw / 2, self.fy, self.fw, self.fh

    def float_radius(self):
        return min(self.fw, self.fh) / 2 if max(self.fw, self.fh) <= ORB + 4 else RADIUS

    def neck(self):
        """How thick the neck between the island and the drop is right now (0: not joined)."""
        if self.goo <= 0.01 or not self.fvis or self.h < 2 or max(self.fw, self.fh) > ORB * 1.6:
            return 0.0                           # only a drop hangs on a neck, not a whole panel
        gap = self.fy - self.h
        if gap > NECK_LEN:
            return 0.0
        return max(0.0, NECK_W * self.goo * (1 - max(0.0, gap) / NECK_LEN) ** 0.8)

    def primary(self):
        """(w, h, target w, target h) of the glass the pages live in."""
        if self.floating:
            return self.fw, self.fh, self.tfw, self.tfh
        return self.w, self.h, self.tw, self.th

    def do_measure(self, orientation, _for_size):
        return 0, 0, -1, -1

    def page_height(self, widget, width):
        return min(widget.measure(Gtk.Orientation.VERTICAL, int(width))[1],
                   max(200, (self.get_height() or SURF_H) - 2 * SHADOW_PAD))

    def do_size_allocate(self, width, _height, _baseline):
        if not self.content.get_visible():
            return
        tw = int(self.tfw if self.floating else self.tw)
        tw = max(tw, self.content.measure(Gtk.Orientation.HORIZONTAL, -1)[0])   # shrinking past the page: it just clips
        ch = self.page_height(self.content, tw)
        target = self.tfh if self.floating else self.th
        if self.follow and abs(ch - target) > 0.5:
            if self.floating:
                self.tfh = float(ch)
            else:
                self.th = float(ch)
            if self.on_target:
                GLib.idle_add(self.on_target)
        if self.floating:
            x, y = self.snap(self.fx - tw / 2), self.snap(self.fy)   # whole pixels: text doesn't shimmer as it moves
        else:
            x, y = (width - tw) / 2, 0
        self.content.allocate(tw, ch, -1, Gsk.Transform.new().translate(Graphene.Point().init(x, y)))

    def cached(self, role, key, bounds, draw):
        """The render node for one piece of glass, drawn by draw(snapshot), or reused while its shape
        (key) is the same. (bounds is unused: GPU drawing knows its own.)"""
        old = self.nodes.get(role)
        if old and old[0] == key:
            return old[1]
        glass = Gtk.Snapshot()
        draw(glass)
        node = glass.to_node()
        self.nodes[role] = (key, node)
        return node

    def scale(self):
        native = self.get_native()
        surface = native.get_surface() if native else None
        sc = surface.get_scale() if surface is not None else 1.0
        if surface is not None:
            _SCREEN_SCALE[0] = sc
        return sc

    def snap(self, v):
        """v, on a whole screen pixel."""
        sc = self.scale()
        return round(v * sc) / sc

    @staticmethod
    def near_scale(cur, target):
        return target > 1 and 0.6 <= cur / target <= 1.5

    def do_snapshot(self, snap):
        W = self.get_width()
        dock = self.h >= 0.5
        if not dock and not self.fvis:
            return
        s, r, bulge = self.geometry()
        L = W / 2 - self.w / 2
        R = L + self.w
        fx, fy, fw, fh = self.float_rect()
        fr = self.float_radius()
        nw = self.neck() if dock else 0.0
        P = SHADOW_PAD
        moving = self.animating    # not from speeds: flipping on a threshold mid-drag made the glass flicker
        if nw > 0.5:
            # joined by a neck (a small drop, pulled out or coming home): one outline, drawn as it is
            top = max(self.h + bulge, fy + fh)
            x0, x1 = min(L - s, fx), max(R + s, fx + fw)
            key = (L, R, self.h, s, r, self.fx, fy, fw, fh, nw)
            node = self.cached("goo", key, (x0 - P, -P, x1 - x0 + 2 * P, top + 2 * P), lambda cr: draw_glass(
                cr, lambda c, closed: goo_path(c, L, R, self.h, s, r, self.fx, fy, fw, fh, nw, closed),
                (L - s, 0, R - L + 2 * s, fy + fh), fade=self.h * 0.8, fast=True))
            snap.append_node(node)
        else:
            if dock:
                # drawn at x = 0 and moved into place; a stretch scales it from the middle of the top edge
                w, h = self.w, self.h
                key = (round(w, 1), round(h, 1), round(s, 1), round(r, 1), round(bulge, 1), moving)
                node = self.cached("dock", key, (-s - P, 0, w + 2 * (s + P), h + bulge + P), lambda cr: draw_glass(
                    cr, lambda c, closed: island_path(c, 0, w, h, s, r, bulge, closed),
                    (-s, 0, w + 2 * s, h + bulge), fade=h * 0.8, fast=moving))
                snap.save()
                if self.sx != 1.0 or self.sy != 1.0:
                    snap.translate(Graphene.Point().init(W / 2, 0))
                    snap.scale(self.sx, self.sy)
                    snap.translate(Graphene.Point().init(-w / 2, 0))
                else:
                    snap.translate(Graphene.Point().init(self.snap(W / 2 - w / 2), 0))
                snap.append_node(node)
                snap.restore()
            if self.fvis and fw > 1 and fh > 1 and self.bridge > 0.005:
                # caught by the top edge: drawn as it is, every frame (only for the moment it attaches)
                b = round(self.bridge, 3)
                key = (round(fx, 1), round(fy, 1), round(fw, 1), round(fh, 1), round(fr, 1), b)
                x0, x1 = fx - SHOULDER, fx + fw + SHOULDER
                node = self.cached("bridge", key, (x0 - P, -P, x1 - x0 + 2 * P, fy + fh + 2 * P + 10),
                                   lambda cr: draw_glass(cr, lambda c, closed: bridge_path(c, fx, fy, fw, fh, fr, b, closed),
                                                         (x0, 0, x1 - x0, fy + fh), fade=(fy + fh) * 0.8 * b or None,
                                                         fast=True, ring=self.ring * (1 - b)))
                snap.append_node(node)
            elif self.fvis and fw > 1 and fh > 1:
                # close to its target size (a wobble, a stretch letting go): the target's glass, scaled;
                # far from it (opening out of the orb): drawn at the size it is
                if self.near_scale(fw, self.tfw) and self.near_scale(fh, self.tfh) and fr != min(fw, fh) / 2:
                    gw, gh = self.tfw, self.tfh
                elif self.near_scale(fw, self.tfw) and self.near_scale(fh, self.tfh) and self.tfw == self.tfh:
                    gw, gh = self.tfw, self.tfh          # an orb wobbling: still an orb, scaled
                else:
                    gw, gh = round(fw, 1), round(fh, 1)
                gr = min(gw, gh) / 2 if max(gw, gh) <= ORB + 4 else RADIUS
                key = (gw, gh, gr, round(self.ring, 2), moving)
                node = self.cached("float", key, (-P, -P, gw + 2 * P, gh + 2 * P + GLASS["shadow_offset"]),
                                   lambda cr: draw_glass(cr, lambda c, _closed: float_path(c, 0, 0, gw, gh, gr),
                                                         (0, 0, gw, gh), fast=key[-1], ring=self.ring))
                snap.save()
                snap.translate(Graphene.Point().init(self.snap(fx), self.snap(fy)))
                if (gw, gh) != (fw, fh):
                    snap.scale(fw / gw, fh / gh)
                snap.append_node(node)
                snap.restore()
        if self.alpha > 0.01 and self.content.get_visible():
            rr = Gsk.RoundedRect()
            zero = Graphene.Size().init(0, 0)
            if self.floating:
                rad = Graphene.Size().init(fr, fr)
                rr.init(Graphene.Rect().init(fx, fy, fw, fh), rad, rad, rad, rad)
            else:
                rad = Graphene.Size().init(r, r)
                cw, ch = self.w * self.sx, self.h * self.sy
                rr.init(Graphene.Rect().init(W / 2 - cw / 2, 0, cw, ch), zero, zero, rad, rad)
            snap.push_rounded_clip(rr)
            snap.push_opacity(self.alpha)
            snap.save()
            snap.translate(Graphene.Point().init(0, -(1 - self.alpha) * 10))
            self.snapshot_child(self.content, snap)
            snap.restore()
            snap.pop()
            snap.pop()


# ---------- the socket the hook relay talks to ----------
class HookServer:
    def __init__(self, on_event, on_gone):
        self.on_event, self.on_gone = on_event, on_gone
        self.live = set()
        try:
            SOCK.unlink()
        except FileNotFoundError:
            pass
        self.svc = Gio.SocketService.new()
        self.svc.add_address(Gio.UnixSocketAddress.new(str(SOCK)), Gio.SocketType.STREAM,
                             Gio.SocketProtocol.DEFAULT, None)
        os.chmod(SOCK, 0o600)
        self.svc.connect("incoming", self.incoming)
        self.svc.start()

    def incoming(self, _svc, conn, _source):
        stream = Gio.DataInputStream.new(conn.get_input_stream())
        self.live.add((conn, stream))
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self.first_line, conn)
        return True

    def first_line(self, stream, result, conn):
        try:
            line, _n = stream.read_line_finish_utf8(result)
            ev = json.loads(line) if line else None
        except (GLib.Error, ValueError):
            ev = None
        if isinstance(ev, dict) and self.on_event(ev, conn):
            # the relay is waiting for our answer; end-of-stream means Claude Code gave up on it
            stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self.watch, conn)
        else:
            self.close(conn)

    def watch(self, stream, result, conn):
        try:
            stream.read_line_finish_utf8(result)
        except GLib.Error:
            pass
        self.close(conn)
        self.on_gone(conn)

    def reply(self, conn, text):
        try:
            if text:
                conn.get_output_stream().write_all((text + "\n").encode(), None)
        except GLib.Error:
            pass
        self.close(conn)

    def close(self, conn):
        for item in [i for i in self.live if i[0] is conn]:
            self.live.discard(item)
        try:
            conn.close(None)
        except GLib.Error:
            pass


