def agent_system():
    try:
        memory = MEMORY.read_text().strip()[-4000:]
    except OSError:
        memory = ""
    return AGENT_SYSTEM.format(now=time.strftime("%A %Y-%m-%d %H:%M %Z"), home=HOME,
                               memory_path=str(MEMORY).replace(str(HOME), "~", 1), memory=memory or "(nothing yet)")


def agent_cmd(resume=None, stream=True):
    cmd = ["claude", "-p", "--output-format", "stream-json" if stream else "json"]
    if stream:
        cmd += ["--include-partial-messages", "--verbose"]
    cmd += ["--setting-sources", "", "--strict-mcp-config", "--settings", AGENT_SETTINGS,
            "--system-prompt", agent_system(), "--tools", *AGENT_TOOLS]
    if resume:
        cmd += ["--resume", resume]
    return cmd

