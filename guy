PARTIAL_SUFFIXES = (".crdownload", ".part")


class DownloadWatcher:
    """Browser downloads: Chrome writes name.crdownload (at first "Unconfirmed 123.crdownload"), Firefox
    name.part; both rename it to the final name when done and delete it when cancelled. Costs nothing
    until a download starts; then it checks sizes once a second for the speed."""

    def __init__(self, guy):
        self.guy = guy
        self.dir = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOWNLOAD) or str(HOME / "Downloads")
        self.tracked = {}          # partial path -> [activity, last size, last time]
        self.poll_id = None
        self.mon = None
        if not os.path.isdir(self.dir):
            return
        self.mon = Gio.File.new_for_path(self.dir).monitor_directory(Gio.FileMonitorFlags.WATCH_MOVES, None)
        self.mon.connect("changed", self.changed)
        for name in os.listdir(self.dir):
            path = os.path.join(self.dir, name)
            try:
                if self.partial(path) and time.time() - os.path.getmtime(path) < 60:
                    self.track(path)
            except OSError:
                pass

    @staticmethod
    def partial(path):
        return path.endswith(PARTIAL_SUFFIXES)

    @staticmethod
    def final_name(path):
        name = os.path.basename(path)
        for suffix in PARTIAL_SUFFIXES:
            name = name.removesuffix(suffix)
        return name

    def title(self, path):
        name = self.final_name(path)
        return "Starting a download…" if name.startswith("Unconfirmed ") else name

    def track(self, path):
        if path in self.tracked:
            return
        act = self.guy.set_activity("dl:" + path, "download", self.title(path), "folder-download-symbolic",
                                    detail="Downloading…", open=self.dir)
        act.state = "running"
        self.tracked[path] = [act, 0, time.monotonic()]
        if self.poll_id is None:
            self.poll_id = GLib.timeout_add(1000, self.poll)
        self.guy.apply()

    def changed(self, _mon, file, other, event):
        E = Gio.FileMonitorEvent
        path = file.get_path() if file else None
        if not path:
            return
        if event in (E.CREATED, E.MOVED_IN, E.CHANGED) and self.partial(path):
            self.track(path)
        elif event == E.RENAMED and other is not None:
            new = other.get_path()
            if path in self.tracked:
                if self.partial(new):          # Chrome naming "Unconfirmed 123.crdownload" properly
                    entry = self.tracked.pop(path)
                    self.tracked[new] = entry
                    entry[0].title = self.title(new)
                else:
                    self.finished(path, new)
            elif self.partial(new):
                self.track(new)
        elif event in (E.DELETED, E.MOVED_OUT) and path in self.tracked:
            final = os.path.join(self.dir, self.final_name(path))
            try:
                done = os.path.getsize(final) > 0
            except OSError:
                done = False
            if done:
                self.finished(path, final)
            else:                              # cancelled
                act = self.tracked.pop(path)[0]
                self.guy.remove_activity(act.key)

    def finished(self, old, new):
        act = self.tracked.pop(old)[0]
        try:
            size = human_size(os.path.getsize(new))
        except OSError:
            size = ""
        act.state, act.progress, act.open = "done", None, new
        act.title = os.path.basename(new)
        act.detail = "Downloaded" + (f"  ·  {size}" if size else "") + "  ·  click to open"
        act.updated = time.time()
        self.guy.flash(f"Downloaded {act.title}", "done", 5.0)

    def poll(self):
        now = time.monotonic()
        for path, entry in list(self.tracked.items()):
            act, last, then = entry
            try:
                size = os.path.getsize(path)
            except OSError:
                continue
            speed = max(0.0, (size - last) / max(now - then, 0.001)) if last else 0.0
            entry[1], entry[2] = size, now
            act.detail = human_size(size) + (f"  ·  {human_size(speed)}/s" if speed else "")
            act.updated = time.time()
        if not self.tracked:
            self.poll_id = None
            return False
        self.guy.apply()
        return True


class PacmanWatcher:
    """pacman, and so yay, as it runs: follows /var/log/pacman.log line by line."""

    LOG = "/var/log/pacman.log"
    LINE = re.compile(r"^\[[^\]]+\] \[(\w+)\] (.*)$")
    CHANGE = re.compile(r"^(upgraded|installed|removed|downgraded|reinstalled) (\S+)")

    def __init__(self, guy):
        self.guy = guy
        self.act = None
        self.count = 0
        self.full = False
        self.mon = None
        self.last_line = 0.0       # monotonic time of the last log line, for the prompt watcher
        try:
            self.offset = os.path.getsize(self.LOG)
        except OSError:
            return
        self.mon = Gio.File.new_for_path(self.LOG).monitor_file(Gio.FileMonitorFlags.NONE, None)
        self.mon.connect("changed", self.changed)

    def changed(self, *_):
        try:
            with open(self.LOG, "rb") as f:
                if os.fstat(f.fileno()).st_size < self.offset:    # rotated
                    self.offset = 0
                f.seek(self.offset)
                data = f.read()
        except OSError:
            return
        end = data.rfind(b"\n")
        if end < 0:
            return
        self.offset += end + 1
        self.last_line = time.monotonic()
        for line in data[:end].decode(errors="replace").splitlines():
            self.line(line)
        self.guy.apply()

    def running(self):
        return (self.act is not None and self.act.state == "running"
                and self.guy.activities.get("pacman") is self.act)   # not pruned while quiet

    def start(self, detail, pop=False):
        if not self.running():
            self.count, self.full = 0, False
            self.act = self.guy.set_activity("pacman", "update", "Packages", "system-software-update-symbolic")
            self.act.state, self.act.open = "running", None
            pop = True
        self.act.detail = detail
        self.act.updated = time.time()
        what = "Updating the system" if self.full else "Installing packages"
        self.act.title = what + (f"  ·  {self.count}" if self.count else "")
        if pop:
            self.guy.pop(self.act, 4.0)

    def finish(self, ok):
        if not self.running():
            return
        n = self.count
        noun = "package" if n == 1 else "packages"
        if ok:
            self.act.title = (f"System updated  ·  {n} {noun}" if self.full else f"{n} {noun} changed")
            self.act.detail = "Done"
        else:
            self.act.title, self.act.detail = "Package update failed", "See the terminal"
        self.act.state = "done" if ok else "error"
        self.act.updated = time.time()
        self.guy.pop(self.act, 6.0)
        GLib.timeout_add_seconds(5, self.guy.check_updates)

    def line(self, line):
        m = self.LINE.match(line)
        if not m:
            return
        source, msg = m.groups()
        if msg == "synchronizing package lists":
            self.start("Syncing package databases…")
        elif msg == "starting full system upgrade":
            self.start("Downloading packages…")
            self.full = True
            self.start("Downloading packages…")
        elif source == "ALPM" and msg == "transaction started":
            self.start("Installing…", pop=True)
        elif source == "ALPM" and (c := self.CHANGE.match(msg)):
            self.count += 1
            self.start(f"{c.group(1).capitalize()} {c.group(2)}")
        elif source == "ALPM" and msg.startswith("running '") and self.running():
            self.act.detail = "Running hooks…"
        elif source == "ALPM" and msg == "transaction completed":
            self.finish(True)
        elif source == "ALPM" and re.match(r"transaction (failed|interrupted)", msg):
            self.finish(False)


class MediaWatcher:
    """Whatever is playing (Spotify, a browser tab, mpv…), from MPRIS via `playerctl --follow`, which
    blocks until something changes, so it costs nothing while nothing does. Every player is followed
    (a paused browser tab mustn't hide Spotify playing), and he wears headphones while any of them plays."""

    FORMAT = "{{playerName}}\t{{status}}\t{{artist}}\t{{title}}"
    KEYS = ("player", "status", "artist", "title")

    def __init__(self, guy):
        self.guy = guy
        self.now = None            # what the pill shows: {"player", "status", "artist", "title"}
        self.players = {}          # player name -> the same, for every player with something loaded
        self.announce = 0.0        # until then, show the next track change even when paused (after "next")
        if not shutil.which("playerctl"):
            return
        try:
            self.proc = subprocess.Popen(["playerctl", "-a", "--follow", "metadata", "--format", self.FORMAT],
                                         stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,
                                         start_new_session=True)
        except OSError:
            return
        threading.Thread(target=self.read, daemon=True).start()
        # a safety net: now and then --follow misses a player starting, stopping or closing, which would
        # leave his headphones on (or off) until the next change
        GLib.timeout_add_seconds(15, self.resync)

    def read(self):
        for line in self.proc.stdout:
            GLib.idle_add(self.changed, line.rstrip("\n"))

    def resync(self):
        """Every player's state, asked afresh."""
        def work():
            try:
                out = subprocess.run(["playerctl", "-a", "metadata", "--format", self.FORMAT],
                                     capture_output=True, text=True, timeout=3).stdout
            except (OSError, subprocess.SubprocessError):
                return
            players = {}
            for line in out.splitlines():
                f = line.split("\t")
                if len(f) >= 4 and f[0] and f[3]:
                    players[f[0]] = dict(zip(self.KEYS, f[:4]))
            GLib.idle_add(self.synced, players)

        threading.Thread(target=work, daemon=True).start()
        return True

    def synced(self, players):
        self.players = players
        self.show(None)
        return False

    def changed(self, line):
        fields = line.split("\t")
        if len(fields) < 4 or not fields[0]:
            self.resync()          # a player closed, and playerctl doesn't say which
            return False
        p = dict(zip(self.KEYS, fields[:4]))
        if p["title"]:
            self.players[p["player"]] = p
        else:
            self.players.pop(p["player"], None)
            p = None
        self.show(p)
        return False

    def show(self, p):
        """Headphones while anything plays; the pill shows what's playing, or else what changed last."""
        playing = [x for x in self.players.values() if x["status"] == "Playing"]
        self.guy.wardrobe.set_music(bool(playing))
        before = self.now
        if p and (p["status"] == "Playing" or not playing):
            now = p
        elif before and self.players.get(before["player"], {}).get("status") == "Playing":
            now = self.players[before["player"]]
        elif playing:
            now = playing[0]
        else:
            now = self.players.get(before["player"]) if before else None
        self.now = now
        if now is None:
            if before is not None:
                self.guy.remove_activity("media")
                self.guy.apply()
            return
        if before == now:
            return
        is_playing = now["status"] == "Playing"
        act = self.guy.set_activity("media", "media", now["title"],
                                    "media-playback-start-symbolic" if is_playing else "media-playback-pause-symbolic",
                                    detail=now["artist"] or now["player"])
        act.state = "idle"         # shown in the list and popped on changes, never keeps the pill out
        new_track = before is None or before["title"] != now["title"]
        asked = new_track and time.monotonic() < self.announce
        if asked or (p is now and is_playing and (new_track or before["status"] != "Playing")):
            self.announce = 0.0
            self.guy.pop(act, 4.0)
        else:
            self.guy.apply()


